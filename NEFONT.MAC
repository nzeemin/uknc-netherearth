; Cyrillic capitals in the order of KOI8-R, codes 224..255. Not used until LANGRU is defined.
.IF DF LANGRU
FONTRC = 224.			; First character code in the font FONTR
FONTRN = 32.			; Number of characters
FONTRB = FONTR - <FONTRC*8.>	; Base address: FONTRB + code*8 = character bitmap

FONTR:	.BYTE	146,366,326,336,326,366,146,000	; 224. YU
