; Start of NEFONT.MAC
; Made from L6780_graphic_patterns once, now edited by hand.
; 64 characters from ASCII 32 (space), 8 bytes each, one byte per pixel row,
; bit 0 = leftmost pixel (ZX bits reversed).

FONTFC = 32.			; First character code in the font
FONTCN = 64.			; Number of characters
FONTBS = FONT - <FONTFC*8.>	; Base address: FONTBS + code*8 = character bitmap

FONT:	.BYTE	000,000,000,000,000,000,000,000	; 32. SPACE
