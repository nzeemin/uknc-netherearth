; Start of NEPPU.MAC
; The PPU program (PPSTA..PPEND): the commands, the keyboard and the vsync interrupts, the drawing of the game
; area, the radar, the text and the palettes, the font (NEFONT.MAC). Included by NEARTH.MAC; the CPU loader
; (RUNPPU) copies the block to the PPU memory. The constants and the mailbox words are in NEARTH.MAC.

;==============================================================================
; PPU code block
; Code is relocated by the system: no absolute addresses of PPU labels,
; use relative addressing or the MOV PC,R0 / ADD #label-.,R0 trick.

; The frame buffer FRBUF (what the PPU shows) is in the same memory as this block (see NEARTH.MAC): the loader copies
; the block to the PPU memory once (RUNPPU, before the first write to FRBUF) and does not need the CPU copy afterwards.
; The block has to be loaded once and not restarted.
PPSTA:
	MTPS	#200
; stop FDD (do we need that?)
	CLR	R0
	CALL	@7132(R0)
; backup and clean low addrs except 272
	MOV	PC, R0
	ADD	#BKP-., R0
	CLR	R1
	MOV	#400, R3
10$:	MOV	(R1), (R0)+
	CMP	R1, #272
	BNE	20$
	TST	(R1)+
	BR	30$
20$:	CLR	(R1)+
30$:	SOB	R3, 10$
	MOV	#2, (R3)		; set RTI at @#0

; setup other
	MOV	@#177054, BKP054
; timers
	BIC	#^B0000001000000000, @#177054 ; enable vsync in CPU
	BIC	#^B0000000100000000, @#177054 ; enable vsync in PPU
	BIC	#^B0001111110000000, @#177716 ; sound init (mixer off)
	MOV	#200, @#306		; PSW for PPU timer interrupt
; keyboard
	MOV	PC, R0
	ADD	#KEYINT-., R0
	MOV	R0, @#300
	BIS	#100, @#177700		; allow keyboard interrupts
; vsync
	MOV	PC, R0
	ADD	#VSYINT-., R0
	MOV	R0, @#100
	MOV	#200, @#102
;
	CLR	VPASS			; PPU variables are not initialized by the loader
	CLR	PMODE			; the menu mode
	MOV	#1, RDCNT		; draw the radar in the first pass
	CLR	VTICK
	CLR	VROW
	CLR	VCPUA
	MOV	#VIEW_SCR, VSCRA
	MOV	PC, R0			; the palette 0
	ADD	#PALTAB-., R0
	MOV	(R0)+, @#DLPAL
	MOV	(R0), @#DLPAL+2
	CALL	PCLSCR			; Clear screen
PDONE:
	MTPS	#0
	MOV	#<PPUCOM/2>, @#177010	; ackn of command execution
	CLR	@#177014
; Main loop of the PPU procedure. Two modes (PMODE): the menu mode (at the start) and the game mode
; (command CMDGAME). In the menu mode the game area and the radar are not drawn, the screen is
; free for the texts.
; Order: game area -> radar -> command from CPU -> sound tick
PMAIN:	TST	PMODE
	BEQ	10$			; menu mode
	CALL	DRVIEW			; game area (stage 1: continuous copy from CPU buffer)
	CALL	DRRADR			; radar
10$:
	MOV	#<PPUCOM/2>, @#177010	; get command from CPU
	MOV	@#177014, R0
	BMI	PEXIT			; exit PPU command
	ASL	R0
	ASL	R0
	ADD	R0, PC
	JMP	PMAIN			; 0 - no command
	JMP	PSOUND			; 1 - play sound 1
	JMP	PPRINT			; 2 - print string
	JMP	PFRAME			; 3 - draw the frame
	JMP	PPRSTS			; 4 - print a list of strings
	JMP	PGAME			; 5 - game mode
	JMP	PMENU			; 6 - menu mode
	JMP	PCLS			; 7 - clear the screen
	JMP	PPAL			; 8 - set the palette
	JMP	PBOX			; 9 - clear a rectangle
	;TODO commands: fill attributes, blit, nuke effect, music
; Exit command
PEXIT:	MTPS	#200
; report measurements to CPU
	MOV	#<PPUPAS/2>, @#177010
	MOV	VPASS, @#177014
	MOV	#<PPUTCK/2>, @#177010
	MOV	VTICK, @#177014
; restore block 0..1000
	MOV	PC, R0
	ADD	#BKP-., R0
	CLR	R1
	MOV	#400, R3
	MOV	(R0)+, (R1)+
	SOB	R3, .-2
	MOV	BKP054, @#177054
	MOV	PC, R0			; the default palette
	ADD	#PALDEF-., R0
	MOV	(R0)+, @#DLPAL
	MOV	(R0), @#DLPAL+2
;
	CALL	PCLSCR			; Clear screen
;
	CALL	@#104054		; Clear keyboard buffer
; signal to CPU: we're finished
	MOV	#PPUCOM/2, @#177010
	CLR	@#177014
	MTPS	#0
	RETURN

; Keyboard interrupt handler
KEYINT:	MOV	@#177010, -(SP)
	MOV	R0, -(SP)
	MOV	#<PPUKEY/2>, @#177010	; prepare addr of keys in CPU
	MOVB	@#177702, R0		; scancode (read it just once)
	BMI	50$
; key pressed
	CMP	R0, #116		; C_KEY_LEFT
	BNE	11$
	MOV	#PKEYLT, R0
	BR	80$
11$:	CMP	R0, #133		; C_KEY_RIGHT
	BNE	12$
	MOV	#PKEYRT, R0
	BR	80$
12$:	CMP	R0, #154		; C_KEY_UP
	BNE	13$
	MOV	#PKEYUP, R0
	BR	80$
13$:	CMP	R0, #134		; C_KEY_DOWN
	BNE	14$
	MOV	#PKEYDN, R0
	BR	80$
14$:	CMP	R0, #105		; C_KEY_SHIFT
	BNE	15$
	MOV	#PKEYFR, R0
	BR	80$
15$:	CMP	R0, #4			; C_KEY_STOP
	BNE	90$
	MOV	#PKEYST, R0
	BR	80$
; key released
50$:	BIC	#^B1111111111110000, R0
	CMP	R0, #^B1110		; left
	BNE	51$
	BIC	#PKEYLT, @#177014
	BR	90$
51$:	CMP	R0, #^B1011		; right
	BNE	52$
	BIC	#PKEYRT, @#177014
	BR	90$
52$:	CMP	R0, #^B1100		; up down
	BNE	53$
	BIC	#<PKEYUP+PKEYDN>, @#177014
	BR	90$
53$:	CMP	R0, #^B0101		; shift
	BNE	54$
	BIC	#PKEYFR, @#177014
	BR	90$
54$:	CMP	R0, #^B0100		; STOP (the main menu is shown again after STOP: the key must be released)
	BNE	90$
	BIC	#PKEYST, @#177014
	BR	90$
; a key is pressed: R0 = its bit, set in the state of the keys and in the latch of the presses; a repeat of the
; key that is held (its bit is set already) is not a press
80$:	BIT	R0, @#177014
	BNE	90$
	BIS	R0, @#177014
	MOV	#<PPUKEL/2>, @#177010
	BIS	R0, @#177014
; exit interrupt
90$:	MOV	(SP)+, R0
	MOV	(SP)+, @#177010
	RTI

; Draw (a slice of) the game area: copy frame buffer from CPU memory to screen.
; Stage 1: no frame comparison, no dirty flags; every pass redraws VSLICE cell rows,
; continuing from where the previous pass stopped.
; Cell = 16x8 pixels: one CPU word per buffer line, low byte = left tile, high byte = right tile.
DRVIEW:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
; set colors once per pass
	MOV	#VINK, @#177016		; INK color
	MOV	PC, R0
	ADD	#COLTBL-., R0
	ADD	#VPAPER*4, R0		; COLTBL entry = 2 words = 4 bytes
	MOV	(R0)+, @#177020		; set PAPER color
	MOV	(R0)+, @#177022
	MOV	#VSLICE, -(SP)		; cell rows left in this pass
10$:
; row start: CPU address (words) and screen address
	MOV	#<PPUFRB/2>, (R4)
	MOV	(R5), R0
	ADD	VCPUA, R0
	MOV	VSCRA, -(SP)		; 2(SP) = running screen address
	MOV	R0, -(SP)		; 0(SP) = running CPU word address
	MOV	#VCELLS, R1
20$:
; read 8 lines of the cell into the temp buffer
	MOV	(SP), (R4)
	MOV	PC, R2
	ADD	#TMPBUF-., R2
	.REPT	TILEH
	MOV	(R5), (R2)+
	ADD	#VIEW_W/2, (R4)
	.ENDR
; write the cell: left tile at A, right tile at A+1
	MOV	2(SP), (R4)
	MOV	PC, R2
	ADD	#TMPBUF-., R2
	.REPT	TILEH
	MOV	(R2)+, R0
	MOV	R0, (R3)		; left tile
	INC	(R4)
	SWAB	R0
	MOV	R0, (R3)		; right tile
	ADD	#LINEW-1, (R4)		; next line, same column
	.ENDR
	INC	(SP)			; next cell: +1 word in the buffer
	ADD	#2, 2(SP)		; +2 tiles on screen
	DEC	R1			; (SOB range is too short here)
	BNE	20$
	CMP	(SP)+, (SP)+		; drop running addresses
; next row
	ADD	#<TILEH*VIEW_W/2>, VCPUA
	ADD	#<TILEH*LINEW>, VSCRA
	INC	VROW
	CMP	VROW, #VROWS
	BLO	30$
; wrapped: whole area done
	CLR	VROW
	CLR	VCPUA
	MOV	#VIEW_SCR, VSCRA
	INC	VPASS
30$:	DEC	(SP)
	BEQ	40$
	JMP	10$			; (BNE range is too short here)
40$:	TST	(SP)+
	RETURN

; Command: print string with the font, 8x8 characters, no clipping.
; Parameter block in CPU memory, address in PPUDAT: screen address, ink, paper index, string, 0.
; Control code 4 in the string, followed by '1'..'9', sets the height scale of the following characters
; (the character is 8 lines tall times the scale; the next string line is the caller's concern).
PPRINT:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; word address of the block in CPU memory
	CALL	PSTRB
	JMP	PDONE

; Command: print a list of strings. PPUDAT = address of the list in CPU memory: blocks as above,
; one after another (each block is word aligned), the list ends with a zero word.
PPRSTS:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; word address of the list in CPU memory
10$:	MOV	R0, (R4)
	TST	(R5)			; screen address = 0: the end
	BEQ	90$
	CALL	PSTRB
	BR	10$
90$:	JMP	PDONE

; Print one string block: R0 = block word address in CPU memory. Returns R0 = word address of
; the next block. R3 = 177024, R4 = 177010, R5 = 177014.
PSTRB:
	MOV	R0, (R4)
	MOV	(R5), R1		; R1 = screen address
	INC	(R4)
	MOV	(R5), @#177016		; set INK color
	INC	(R4)
	MOV	(R5), R2		; paper color index
	ADD	#3, R0			; string start, word address
	MOV	R0, PSTRA
	ASL	R2
	ASL	R2
	ADD	PC, R2
	ADD	#COLTBL-., R2
	MOV	(R2)+, @#177020		; set PAPER color
	MOV	(R2), @#177022
	CLR	PHALF
	MOV	#1, PSCALE
10$:	CALL	PGETC
	BEQ	90$
	CMP	R2, #4
	BEQ	20$
	CALL	DRCHAR
	BR	10$
20$:	CALL	PGETC			; control code 4 + '1'..'9': the height scale of the characters
	BEQ	90$
	SUB	#'0, R2
	MOV	R2, PSCALE
	BR	10$
90$:	MOV	PSTRA, R0		; the next block follows the word with the terminator
	RETURN

; Next character of the string to R2 (Z flag set = the end of the string). R4 = 177010, R5 = 177014.
PGETC:	TST	PHALF
	BNE	20$
	MOV	PSTRA, (R4)		; next two characters
	INC	PSTRA
	MOV	(R5), PWORD
	INC	PHALF
	CLR	R2
	BISB	PWORD, R2
	RETURN
20$:	CLR	PHALF
	CLR	R2
	BISB	PWORD+1, R2
	RETURN

; Draw a character: R2 = character code, R1 = screen address (advanced by 1 column)
; R3 = 177024, R4 = 177010
DRCHAR:
.IF DF LANGRU
	CMP	R2, #FONTRC		; Cyrillic (KOI8-R codes 192..255)
	BLO	5$
	SUB	#FONTRC, R2
	ASL	R2
	ASL	R2
	ASL	R2			; * 8.
	ADD	PC, R2
	ADD	#FONTR-., R2
	BR	25$
5$:
.ENDC
	SUB	#FONTFC, R2
	BLT	10$
	CMP	R2, #FONTCN
	BLO	20$
10$:	CLR	R2			; out of range => space
20$:	ASL	R2
	ASL	R2
	ASL	R2			; * 8.
	ADD	PC, R2
	ADD	#FONT-., R2
25$:	MOV	R1, (R4)
	MOV	#TILEH, PLINES
30$:	CLR	R0
	BISB	(R2)+, R0
	MOV	PSCALE, PCNT		; every line of the character is repeated PSCALE times
40$:	MOV	R0, (R3)
	ADD	#LINEW, (R4)
	DEC	PCNT
	BNE	40$
	DEC	PLINES
	BNE	30$
	INC	R1
	RETURN

; Commands: the mode of the PPU, clear the screen
PGAME:	MOV	#1, PMODE
	JMP	PDONE
PMENU:	CLR	PMODE
	JMP	PDONE
PCLS:	CALL	PCLSCR
	JMP	PDONE

; Command: set the palette. PPUDAT = the palette number (only bit 0 counts). The palette is the 4-word tag
; of the display list at DLPAL (the palette of the main part of the screen, line 30), 8 entries of 4 bits.
; Command: clear a rectangle of tiles with the paper color. Parameter block in CPU memory, address in PPUDAT:
; screen address of the top left tile, width (tiles), height (tile rows), paper color index.
PBOX:	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; word address of the block in CPU memory
	MOV	R0, (R4)
	MOV	(R5), R1		; R1 = screen address
	INC	(R4)
	MOV	(R5), FRW
	INC	(R4)
	MOV	(R5), FRH
	INC	(R4)
	MOV	(R5), R2		; paper color index
	ASL	R2
	ASL	R2
	ADD	PC, R2
	ADD	#COLTBL-., R2
	MOV	(R2)+, @#177020		; set PAPER color
	MOV	(R2), @#177022
10$:	MOV	#8., -(SP)		; lines of a tile row
20$:	MOV	R1, (R4)
	MOV	FRW, FRCNT
30$:	CLR	(R3)			; 8 pixels of the paper color
	INC	(R4)
	DEC	FRCNT
	BNE	30$
	ADD	#LINEW, R1
	DEC	(SP)
	BNE	20$
	TST	(SP)+
	DEC	FRH
	BNE	10$
	JMP	PDONE

DLPAL = 002470
PPAL:	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0
	BIC	#177776, R0		; 0..1
	ASL	R0
	ASL	R0			; x4
	MOV	PC, R1
	ADD	#PALTAB-., R1
	ADD	R0, R1
	MOV	(R1)+, @#DLPAL
	MOV	(R1), @#DLPAL+2
	JMP	PDONE

; Command: draw the frame around the game area: 1 pixel black line, 6 pixels of paper, 1 pixel black
; line (as the white frame of the original). Parameter block in CPU memory, address in PPUDAT:
; screen address of the top left tile, width (tiles), height (tile rows), ink, paper index.
; The interior of the frame is not drawn.
PFRAME:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; word address of the block in CPU memory
	MOV	R0, (R4)
	MOV	(R5), R1		; R1 = screen address
	INC	(R4)
	MOV	(R5), FRW
	INC	(R4)
	MOV	(R5), FRH
	INC	(R4)
	MOV	(R5), @#177016		; set INK color
	INC	(R4)
	MOV	(R5), R2		; paper color index
	ASL	R2
	ASL	R2
	ADD	PC, R2
	ADD	#COLTBL-., R2
	MOV	(R2)+, @#177020		; set PAPER color
	MOV	(R2), @#177022
	CLR	FRROW
10$:	MOV	#-1, FRFULL		; the top and bottom rows are drawn completely
	MOV	PC, R0
	ADD	#FRTOP-., R0
	TST	FRROW
	BEQ	40$
	MOV	PC, R0
	ADD	#FRBOT-., R0
	MOV	FRROW, R2
	INC	R2
	CMP	R2, FRH
	BEQ	40$
	CLR	FRFULL			; the rows between: only the left and right tiles
	MOV	PC, R0
	ADD	#FRMID-., R0
40$:	CALL	PFROW
	INC	FRROW
	CMP	FRROW, FRH
	BLO	10$
	JMP	PDONE

; Draw one tile row of the frame: R0 = table of 8 lines (left tile, middle tile, right tile),
; R1 = screen address of the row (advanced to the next tile row). FRFULL = 0: no middle tiles.
PFROW:	MOV	#8., -(SP)		; lines left
10$:	MOV	R1, (R4)
	CLR	R2
	BISB	(R0)+, R2
	MOV	R2, (R3)		; left tile
	TST	FRFULL
	BEQ	30$
	CLR	R2
	BISB	(R0), R2		; middle tile
	MOV	FRW, FRCNT
	SUB	#2, FRCNT
20$:	INC	(R4)
	MOV	R2, (R3)
	DEC	FRCNT
	BNE	20$
	INC	(R4)
	BR	40$
30$:	MOV	R1, (R4)
	ADD	FRW, (R4)
	DEC	(R4)
40$:	CLR	R2
	BISB	1(R0), R2		; right tile
	MOV	R2, (R3)
	ADD	#2, R0			; next line of the table
	ADD	#LINEW, R1
	DEC	(SP)
	BNE	10$
	TST	(SP)+
	RETURN

; Frame tiles, 8 lines each: left, middle, right (bit 0 = leftmost pixel). The side bars are 5 pixels of paper:
; black at bits 0,1 (the outer line and 1 pixel of padding, invisible on the black background) and the inner line
FRTOP:	.BYTE	377,377,377
	.REPT	6
	.BYTE	003,000,300
	.ENDR
	.BYTE	203,377,301
FRMID:	.REPT	8.
	.BYTE	203,000,301
	.ENDR
FRBOT:	.BYTE	203,377,301
	.REPT	6
	.BYTE	003,000,300
	.ENDR
	.BYTE	377,377,377
	.EVEN

; Draw radar (TODO: read Ld800_radar_view1 / Ld900_radar_view2 from CPU memory)
; Draws the radar: 128x16 pixels from the two radar buffers in CPU memory (NERADR.MAC; address in
; PPURAD, view 2 follows view 1, 16 bytes per row, bit 0 = the leftmost cell). Colors of a pixel
; (view 1, view 2): (0,0) blue, (1,0) cyan (the robots of the player), (0,1) yellow (the enemy
; robots), (1,1) white (the buildings). The ink is white, so the pixels of both views are drawn by
; the ink and the paper is calculated for each pixel (4 bits of the color per pixel).
DRRADR:	DEC	RDCNT
	BNE	90$			; not now
	MOV	#RADAR_EVERY, RDCNT
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPURAD/2>, (R4)
	MOV	(R5), RDBUF
	BEQ	90$			; no radar buffers
	MOV	#7, @#177016		; white ink
	MOV	PC, R0
	ADD	#RDE4-., R0
	MOV	R0, RDE4P
	MOV	#RADAR_SCR, RDSCR
	CLR	RDY
10$:	MOV	RDY, R0			; the row: 8 words of the view 1
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	RDBUF, R0
	MOV	R0, RDA1
	MOV	RDSCR, RDTS		; the screen address of the first tile of the line
	MOV	#8., RDW
20$:	MOV	RDA1, (R4)
	MOV	(R5), RDV1W		; two bytes of the view 1
	MOV	RDA1, (R4)
	ADD	#128., (R4)
	MOV	(R5), RDV2W		; two bytes of the view 2
	INC	RDA1
	CLR	RDV1
	BISB	RDV1W, RDV1
	CLR	RDV2
	BISB	RDV2W, RDV2
	CALL	RDTILE
	CLR	RDV1
	BISB	RDV1W+1, RDV1
	CLR	RDV2
	BISB	RDV2W+1, RDV2
	CALL	RDTILE
	DEC	RDW
	BNE	20$
	ADD	#LINEW, RDSCR		; the next line
	INC	RDY
	CMP	RDY, #16.
	BLO	10$
90$:	RETURN

; Draws one tile of the radar at the screen address RDTS (advanced): RDV1, RDV2 = the bytes of the views.
RDTILE:	MOV	RDV1, R0		; the paper of the pixels 0..3
	BIC	#177760, R0
	MOV	RDV2, R1
	BIC	#177760, R1
	CALL	RDWORD
	MOV	R0, @#177020
	MOV	RDV1, R0		; the paper of the pixels 4..7
	ASR	R0
	ASR	R0
	ASR	R0
	ASR	R0
	BIC	#177760, R0
	MOV	RDV2, R1
	ASR	R1
	ASR	R1
	ASR	R1
	ASR	R1
	BIC	#177760, R1
	CALL	RDWORD
	MOV	R0, @#177022
	MOV	RDV2, R1		; the ink mask: pixels of both views
	COM	R1
	MOV	RDV1, R0
	BIC	R1, R0
	MOV	RDTS, (R4)
	MOV	R0, (R3)
	INC	RDTS
	RETURN

; Paper of 4 pixels (16 bits, 4 bits per pixel): R0 = pixels of the view 1, R1 = pixels of the view 2
; (4 bits each) => R0. Color bits: B = not view 2 or view 1; R = view 2; G = view 1 or view 2.
; Clobbers R1, R2.
RDWORD:	ASL	R0
	ADD	RDE4P, R0
	MOV	(R0), R0		; a: bit 0 of the nibble of each pixel of the view 1
	ASL	R1
	ADD	RDE4P, R1
	MOV	(R1), R1		; b: the same for the view 2
	MOV	R0, R2
	BIS	R1, R2
	ASL	R2
	ASL	R2			; (a | b) << 2: the green bit
	MOV	R1, -(SP)
	ASL	(SP)
	BIS	(SP)+, R2		; | b << 1: the red bit
	COM	R1
	BIS	R1, R0
	BIC	#^C10421, R0		; (~b | a) & 1111h: the blue bit
	BIS	R2, R0
	RETURN

; 4 bits of a pixel mask => bit 0 of the nibble of each pixel
RDE4:	.WORD	^B0000000000000000, ^B0000000000000001, ^B0000000000010000, ^B0000000000010001
	.WORD	^B0000000100000000, ^B0000000100000001, ^B0000000100010000, ^B0000000100010001
	.WORD	^B0001000000000000, ^B0001000000000001, ^B0001000000010000, ^B0001000000010001
	.WORD	^B0001000100000000, ^B0001000100000001, ^B0001000100010000, ^B0001000100010001

; Clear screen in PPU
PCLSCR:
	MOV	#177010, R4
	MOV	#177012, R3
	MOV	#177014, R5
	MOV	#100000, (R4)
	MOV	#100000, R0
10$:	CLR	(R5)
	CLR	(R3)
	INC	(R4)
	SOB	R0, 10$
	RETURN

; 50Hz tick: counts ticks and passes the count to the CPU (PPUTCK) at once, so the CPU can measure time
VSYINT:	INC	VTICK
	MOV	@#177010, -(SP)
	MOV	#<PPUTCK/2>, @#177010
	MOV	VTICK, @#177014
	MOV	(SP)+, @#177010
	RTI

; Start to play sound; R0 = sound number multiplied by 4. TODO: sound design undecided
PSOUND:	JMP	PDONE			; return to PPU main loop

; Color conversion table, 2 words per color (see Saboteur)
COLTBL:	.WORD	^B0000000000000000, ^B0000000000000000
	.WORD	^B0001000100010001, ^B0001000100010001
	.WORD	^B0010001000100010, ^B0010001000100010
	.WORD	^B0011001100110011, ^B0011001100110011
	.WORD	^B0100010001000100, ^B0100010001000100
	.WORD	^B0101010101010101, ^B0101010101010101
	.WORD	^B0110011001100110, ^B0110011001100110
	.WORD	^B0111011101110111, ^B0111011101110111

.INCLUDE /NEFONT.MAC/			; The font lives in the PPU block (PPU RAM)

PMODE:	.WORD	0			; 0 = menu mode, 1 = game mode
RDCNT:	.WORD	0			; DRRADR: passes left to the next drawing
RDBUF:	.WORD	0			; DRRADR: radar buffers, CPU word address
RDE4P:	.WORD	0			; DRRADR: address of RDE4
RDSCR:	.WORD	0			; DRRADR: screen address of the current line
RDTS:	.WORD	0			; DRRADR: screen address of the current tile
RDY:	.WORD	0			; DRRADR: current row
RDW:	.WORD	0			; DRRADR: words left in the row
RDA1:	.WORD	0			; DRRADR: CPU word address in the view 1
RDV1W:	.WORD	0			; DRRADR: two bytes of the view 1
RDV2W:	.WORD	0			; DRRADR: two bytes of the view 2
RDV1:	.WORD	0			; DRRADR: the byte of the view 1
RDV2:	.WORD	0			; DRRADR: the byte of the view 2
FRW:	.WORD	0			; PFRAME: width, tiles
FRH:	.WORD	0			; PFRAME: height, tile rows
FRROW:	.WORD	0			; PFRAME: current tile row
FRFULL:	.WORD	0			; PFRAME: the row is drawn completely
FRCNT:	.WORD	0			; PFRAME: middle tiles counter
VPASS:	.WORD	0			; Count of full game area passes
VTICK:	.WORD	0			; Count of 50Hz ticks
VROW:	.WORD	0			; Current cell row of the game area
VCPUA:	.WORD	0			; Frame buffer offset of the current row, words
VSCRA:	.WORD	VIEW_SCR		; Screen address of the current row
PSTRA:	.WORD	0			; PPRINT: current string word address in CPU memory
PWORD:	.WORD	0			; PPRINT: current string word
PHALF:	.WORD	0			; PPRINT: the second character of PWORD is next
PSCALE:	.WORD	1			; PPRINT: height scale of the characters
PCNT:	.WORD	0			; DRCHAR: repetition counter
PLINES:	.WORD	0			; DRCHAR: lines of the character left
TMPBUF:	.BLKW	TILEH			; Temp buffer for one cell
; Palettes: color indexes as the bits GRB (1 blue, 2 red, 4 green): black / blue / red / magenta / green /
; cyan / yellow / white. Entry i is 4 bits (YRGB), the identity of the other bits is 1000+i.
PALTAB:	.WORD	^B1011101010011000, ^B1111111011011100	; palette 0
	.WORD	^B1101110010011000, ^B1111111010111010	; palette 1: red and green exchanged (for the machines
							;   where these two colors are swapped)
PALDEF:	.WORD	^B1011101010011000, ^B1111111011011100	; the default palette of the system
BKP054:	.WORD	0			; Saved 177054
BKP:	.BLKW	400			; 0-1000 addrs backup

PPEND:
; End of PPU code block
;==============================================================================

; End of NEPPU.MAC
