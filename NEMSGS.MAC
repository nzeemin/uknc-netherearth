; Start of NEMSGS.MAC
; The texts of the screens: the game screen, the main menu, the pause menu, the robot construction
; (included by NECORE.MAC). The Russian version is NEMSGSRU.MAC, made by
; tools/conv_lang.py from this file and NEMSGS.ru.txt (see the conditional .INCLUDE in NECORE.MAC).
; The item blocks are changed by Lmenu_select: the text starts with "> " or "  " (MNB_CHAR).

; The macros of the strings (the PPU command CMDSTR block: the screen address, the ink, the paper index, the text)
; A string of a screen: row, column, ink, paper, text. MSTRB: the same, the text as the codes (tools/conv_lang.py)
.MACRO	MSTR	ROW, COL, INK, PAPER, TEXT
	.WORD	SCREEN+<ROW*TILEH*LINEW>+COL, INK, PAPER
	.ASCIZ	/TEXT/
	.EVEN
.ENDM
.MACRO	MSTRB	ROW, COL, INK, PAPER, BYTES
	.WORD	SCREEN+<ROW*TILEH*LINEW>+COL, INK, PAPER
	.BYTE	BYTES, 0
	.EVEN
.ENDM
; A string of the panel of the game: row, column in the panel (HUD_COL)
.MACRO	HSTR	ROW, COL, INK, PAPER, TEXT
	.WORD	SCREEN+<ROW*TILEH*LINEW>+HUD_COL+COL, INK, PAPER
	.ASCIZ	/TEXT/
	.EVEN
.ENDM
.MACRO	HSTRB	ROW, COL, INK, PAPER, BYTES
	.WORD	SCREEN+<ROW*TILEH*LINEW>+HUD_COL+COL, INK, PAPER
	.BYTE	BYTES, 0
	.EVEN
.ENDM

; The game screen: the panel on the right (the numbers: NEHUD.MAC) and the radar label
;@ GAME SCREEN
; The static part
HUDTAB:
	HSTR	0., 1., 7, 0, < DAY: >
	HSTR	1., 1., 7, 0, <TIME: >
	HSTR	3., 0., 6, 0, <   STATUS>
	HSTR	4., 0., 6, 0, <INSIG  HUMAN>
	HSTR	6., 2., 5, 0, <WARBASES>
	HSTR	7., 2., 5, 0, <ELECTR'S>
	HSTR	8., 2., 5, 0, <NUCLEAR>
	HSTR	9., 2., 5, 0, <PHASERS>
	HSTR	10., 2., 5, 0, <MISSILES>
	HSTR	11., 2., 5, 0, < CANNON>
	HSTR	12., 2., 5, 0, <CHASSIS>
	HSTR	13., 2., 5, 0, < ROBOTS>
	HSTR	15., 2., 6, 0, <RESOURCES>
	HSTR	17., 1., 4, 0, <GENERAL >
	HSTR	18., 1., 4, 0, <ELECTR' >
	HSTR	19., 1., 4, 0, <NUCLEAR >
	HSTR	20., 1., 4, 0, <PHASERS >
	HSTR	21., 1., 4, 0, <MISSILE >
	HSTR	22., 1., 4, 0, <CANNON >
	HSTR	23., 1., 4, 0, <CHASSIS >
; "RADAR:" under the game area, double height (control code 4, '2'), two tile rows
	.WORD	SCREEN+<23.*TILEH*LINEW>+<VIEW_COL-1>, 5, 0
	.BYTE	4, '2
	.ASCIZ	/RADAR:/
	.EVEN
	.WORD	0

;@ GAME OVER
; The end of the game: the defeat and the victory, two lines under the radar, centered (the screen is 40 columns of 16 pixels), an empty row between them
GOVL:
	MSTR	28., 9., 2, 0, <YOU HAVE NO BASES LEFT>
	MSTR	30., 9., 2, 0, <BETTER LUCK NEXT TIME!>
	.WORD	0
GOVW:
	MSTR	28., 9., 6, 0, < INSIGNIANS DESTROYED >
	MSTR	30., 9., 6, 0, <    YOU HAVE WON !    >
	.WORD	0

; The main menu
;@ MAIN MENU
; The title: double height (control code 4, '2')
MNTITLE:
	.WORD	SCREEN+<8.*TILEH*LINEW>+17., 7, 0
	.BYTE	4, '2
	.ASCIZ	/NETHER/
	.EVEN
	.WORD	SCREEN+<10.*TILEH*LINEW>+18., 7, 0
	.BYTE	4, '2
	.ASCIZ	/EARTH/
	.EVEN
; the lines at the bottom: the original and the port with the version (VERSIO.MAC is generated by !compilelink.bat)
	MSTR	30., 2., 5, 0, <ZX SPECTRUM 1987 ICON DESIGN LTD>
	.WORD	SCREEN+<32.*TILEH*LINEW>+2, 5, 0
	.ASCII	/UKNC 2026 NZEEMIN  /
.INCLUDE /VERSIO.MAC/
	.BYTE	0
	.EVEN
	.WORD	0

; The main menu: four items
MNOPTS:
	.WORD	SCREEN+<16.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
	.WORD	SCREEN+<19.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
	.WORD	SCREEN+<22.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
	.WORD	SCREEN+<25.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
MNOPT1:	.WORD	SCREEN+<16.*TILEH*LINEW>+12., 6, 0
	.BYTE	4, '2
	.ASCIZ	/> START GAME/
	.EVEN
MNOPT2:	.WORD	SCREEN+<19.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '1
	.ASCIZ	/  PALETTE/
	.EVEN
MNOPT3:	.WORD	SCREEN+<22.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '1
	.ASCIZ	/  LOAD SAVED GAME/
	.EVEN
MNOPT4:	.WORD	SCREEN+<25.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '1
	.ASCIZ	/  EXIT/
	.EVEN
	.WORD	0
MNTAB:	.WORD	MNOPT1, MNOPT2, MNOPT3, MNOPT4

; The pause menu
;@ PAUSE MENU
; The pause menu: the title and three items
PMTITLE:
	.WORD	SCREEN+<8.*TILEH*LINEW>+14., 5, 0
	.BYTE	4, '2
	.ASCIZ	/GAME PAUSED/
	.EVEN
	.WORD	0
PMOPTS:
	.WORD	SCREEN+<14.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
	.WORD	SCREEN+<17.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
	.WORD	SCREEN+<20.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '2
	.ASCIZ	/                 /
	.EVEN
PMOPT1:	.WORD	SCREEN+<14.*TILEH*LINEW>+12., 6, 0
	.BYTE	4, '2
	.ASCIZ	/> CONTINUE/
	.EVEN
PMOPT2:	.WORD	SCREEN+<17.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '1
	.ASCIZ	/  SAVE GAME/
	.EVEN
PMOPT3:	.WORD	SCREEN+<20.*TILEH*LINEW>+12., 7, 0
	.BYTE	4, '1
	.ASCIZ	/  ABORT GAME/
	.EVEN
	.WORD	0
PMTAB:	.WORD	PMOPT1, PMOPT2, PMOPT3

; The robot construction screen
;@ ROBOT CONSTRUCTION
; The texts of the screen (as in the original, Lc85d): the title in two lines (double height) and the
; resources on the left (the numbers of the resources: Lcbe0)
CSTEXT:	.WORD	SCREEN+<0.*TILEH*LINEW>+2., 7, 0
	.BYTE	4, '2
	.ASCIZ	/ROBOT/
	.EVEN
	.WORD	SCREEN+<2.*TILEH*LINEW>+2., 7, 0
	.BYTE	4, '2
	.ASCIZ	/CONSTRUCTION/
	.EVEN
	MSTR	6., 1., 6, 0, <-- RESOURCES -->
	MSTR	7., 1., 6, 0, <-- AVAILABLE -->
; the names are right aligned: they end in column 10, so the texts start in column 4 and are padded to 8 characters
; with spaces at the left (the translation too), except ELECTRONICS (column 1, 11 characters)
	MSTR	9., 4., 4, 0, < GENERAL>
	MSTR	11., 1., 4, 0, <ELECTRONICS>
	MSTR	12., 4., 4, 0, < NUCLEAR>
	MSTR	13., 4., 4, 0, < PHASERS>
	MSTR	14., 4., 4, 0, <MISSILES>
	MSTR	15., 4., 4, 0, <  CANNON>
	MSTR	16., 4., 4, 0, < CHASSIS>
	MSTR	18., 4., 4, 0, <   TOTAL>
; the pieces: the names (cyan) and under them the costs (magenta)
;@ ROBOT CONSTRUCTION PIECES
CSPN7:
	MSTR	1., 22., 5, 0, < ELECTRONICS>
	MSTR	2., 24., 3, 0, <3>
CSPN6:
	MSTR	4., 22., 5, 0, < NUCLEAR>
	MSTR	5., 24., 3, 0, <20>
CSPN5:
	MSTR	7., 22., 5, 0, < PHASERS>
	MSTR	8., 24., 3, 0, <4>
CSPN4:
	MSTR	10., 22., 5, 0, < MISSILES>
	MSTR	11., 24., 3, 0, <4>
CSPN3:
	MSTR	13., 22., 5, 0, < CANNON>
	MSTR	14., 24., 3, 0, <2>
CSPN2:
	MSTR	16., 22., 5, 0, < ANTI-GRAV>
	MSTR	17., 24., 3, 0, <10>
CSPN1:
	MSTR	19., 22., 5, 0, < TRACKS>
	MSTR	20., 24., 3, 0, <5>
CSPN0:
	MSTR	22., 22., 5, 0, < BIPOD>
	MSTR	23., 24., 3, 0, <3>
; START ROBOT and EXIT MENU go on in the same column with the same step of 3 rows. The current item is yellow
; with ">" right before the text (the ink word and the first character of the block, a space or ">", are changed
; by the CPU), the others white (the pieces: cyan). The place at the left is for the preview of the robot.
CSOPT1:
	MSTR	25., 22., 7, 0, < START ROBOT>
CSOPT2:
	MSTR	28., 22., 7, 0, < EXIT MENU>
	.WORD	0

;@ ROBOT MENU
; The menu of the robot the player has landed on, in the right panel (row = row of the ZX screen). RMLIST is
; drawn at once (CMDSTS): the items of two lines (the first block of an item has the mark ">" or " " before the text,
; in the first column of the panel and the text from the second, the continuation of an item is indented by 2 spaces; the ink and the mark are changed by the CPU), and -ORDERS-.
RMLIST:
RMI0A:
	HSTR	4., 0., 5, 0, < DIRECT>
RMI0B:
	HSTR	5., 0., 5, 0, <  CONTROL>
RMI1A:
	HSTR	7., 0., 5, 0, < GIVE>
RMI1B:
	HSTR	8., 0., 5, 0, <  ORDERS>
RMI2A:
	HSTR	10., 0., 5, 0, < COMBAT>
RMI2B:
	HSTR	11., 0., 5, 0, <  MODE>
RMI3A:
	HSTR	13., 0., 5, 0, < LEAVE>
RMI3B:
	HSTR	14., 0., 5, 0, <  ROBOT>
	HSTR	17., 1., 6, 0, <-ORDERS->
	.WORD	0
; The name of the orders of the robot (3 lines), drawn by CMDSTS, one list for each of the orders
RMO0:
	HSTR	18., 1., 5, 0, < STOP   >
	HSTR	19., 1., 5, 0, <  AND   >
	HSTR	20., 1., 5, 0, < DEFEND >
	.WORD	0
RMO1:
	HSTR	18., 1., 5, 0, <ADVANCE >
	HSTR	19., 1., 5, 0, <        >
	HSTR	20., 1., 5, 0, < MILES  >
	.WORD	0
RMO2:
	HSTR	18., 1., 5, 0, <RETREAT >
	HSTR	19., 1., 5, 0, <        >
	HSTR	20., 1., 5, 0, < MILES  >
	.WORD	0
RMO3:
	HSTR	18., 1., 5, 0, <DESTROY >
	HSTR	19., 1., 5, 0, < ENEMY  >
	HSTR	20., 1., 5, 0, < ROBOTS >
	.WORD	0
RMO4:
	HSTR	18., 1., 5, 0, <DESTROY >
	HSTR	19., 1., 5, 0, < ENEMY  >
	HSTR	20., 1., 5, 0, <FACTORYS>
	.WORD	0
RMO5:
	HSTR	18., 1., 5, 0, <DESTROY >
	HSTR	19., 1., 5, 0, < ENEMY  >
	HSTR	20., 1., 5, 0, <WARBASES>
	.WORD	0
RMO6:
	HSTR	18., 1., 5, 0, <CAPTURE >
	HSTR	19., 1., 5, 0, <NEUTRAL >
	HSTR	20., 1., 5, 0, <FACTORYS>
	.WORD	0
RMO7:
	HSTR	18., 1., 5, 0, <CAPTURE >
	HSTR	19., 1., 5, 0, < ENEMY  >
	HSTR	20., 1., 5, 0, <FACTORYS>
	.WORD	0
RMO8:
	HSTR	18., 1., 5, 0, <CAPTURE >
	HSTR	19., 1., 5, 0, < ENEMY  >
	HSTR	20., 1., 5, 0, <WARBASES>
	.WORD	0
; The strength of the robot, for both menus: the label STRENGTH and the number with "%" (the block RMSTRB is
; written by the CPU: 3 characters and "%"), one list
RMSTL:
	HSTR	23., 1., 6, 0, <STRENGTH>
RMSTRB:	.WORD	SCREEN+<24.*TILEH*LINEW>+HUD_COL+3, 7, 0
	.BLKB	6
	.WORD	0

;@ COMBAT MODE
; The menu of the combat mode of the robot (the right panel, as [ROBOT MENU]): 6 items of two lines.
CMLIST:
CMI0A:
	HSTR	4., 0., 5, 0, < NUCLEAR>
CMI0B:
	HSTR	5., 0., 5, 0, <  BOMB>
CMI1A:
	HSTR	7., 0., 5, 0, < FIRE>
CMI1B:
	HSTR	8., 0., 5, 0, <  PHASERS>
CMI2A:
	HSTR	10., 0., 5, 0, < FIRE>
CMI2B:
	HSTR	11., 0., 5, 0, <  MISSILES>
CMI3A:
	HSTR	13., 0., 5, 0, < FIRE>
CMI3B:
	HSTR	14., 0., 5, 0, <  CANNON>
CMI4A:
	HSTR	16., 0., 5, 0, < MOVE>
CMI4B:
	HSTR	17., 0., 5, 0, <  ROBOT>
CMI5A:
	HSTR	19., 0., 5, 0, < STOP>
CMI5B:
	HSTR	20., 0., 5, 0, <  COMBAT>
	.WORD	0

;@ ROBOT ORDERS
; The menus of GIVE ORDERS (the right panel, as [ROBOT MENU]): the orders, the target of SEARCH & DESTROY and of
; SEARCH & CAPTURE, the distance of ADVANCE and RETREAT.
OMLIST:
	HSTR	4., 2., 7, 0, <SELECT>
	HSTR	5., 2., 7, 0, <ORDERS>
OMI0A:
	HSTR	7., 0., 5, 0, < STOP AND>
OMI0B:
	HSTR	8., 0., 5, 0, <  DEFEND>
OMI1A:
	HSTR	10., 0., 5, 0, < ADVANCE>
OMI1B:
	HSTR	11., 0., 5, 0, <  ?? MILES>
OMI2A:
	HSTR	13., 0., 5, 0, < RETREAT>
OMI2B:
	HSTR	14., 0., 5, 0, <  ?? MILES>
OMI3A:
	HSTR	16., 0., 5, 0, < SEARCH &>
OMI3B:
	HSTR	17., 0., 5, 0, <  DESTROY>
OMI4A:
	HSTR	19., 0., 5, 0, < SEARCH &>
OMI4B:
	HSTR	20., 0., 5, 0, <  CAPTURE>
	.WORD	0
ODLIST:
	HSTR	4., 1., 7, 0, <SEARCH &>
	HSTR	5., 1., 7, 0, < DESTROY>
	HSTR	8., 2., 5, 0, <SELECT>
	HSTR	9., 2., 5, 0, <TARGET>
ODI0A:
	HSTR	12., 0., 5, 0, < ENEMY>
ODI0B:
	HSTR	13., 0., 5, 0, <  ROBOTS>
ODI1A:
	HSTR	15., 0., 5, 0, < ENEMY>
ODI1B:
	HSTR	16., 0., 5, 0, <  FACTORYS>
ODI2A:
	HSTR	18., 0., 5, 0, < ENEMY>
ODI2B:
	HSTR	19., 0., 5, 0, <  WARBASES>
	.WORD	0
OCLIST:
	HSTR	4., 1., 7, 0, <SEARCH &>
	HSTR	5., 1., 7, 0, < CAPTURE>
	HSTR	8., 2., 5, 0, <SELECT>
	HSTR	9., 2., 5, 0, <TARGET>
OCI0A:
	HSTR	12., 0., 5, 0, < NEUTRAL>
OCI0B:
	HSTR	13., 0., 5, 0, <  FACTORYS>
OCI1A:
	HSTR	15., 0., 5, 0, < ENEMY>
OCI1B:
	HSTR	16., 0., 5, 0, <  FACTORYS>
OCI2A:
	HSTR	18., 0., 5, 0, < ENEMY>
OCI2B:
	HSTR	19., 0., 5, 0, <  WARBASES>
	.WORD	0
ADLIST:
	HSTR	5., 1., 7, 0, <ADVANCE >
	HSTR	6., 1., 7, 0, <?? MILES>
	HSTR	9., 2., 5, 0, < SELECT>
	HSTR	10., 2., 5, 0, <DISTANCE>
	HSTR	13., 4., 6, 0, <MILES>
	.WORD	0
RELIST:
	HSTR	5., 1., 7, 0, <RETREAT >
	HSTR	6., 1., 7, 0, <?? MILES>
	HSTR	9., 2., 5, 0, < SELECT>
	HSTR	10., 2., 5, 0, <DISTANCE>
	HSTR	13., 4., 6, 0, <MILES>
	.WORD	0
; The distance chosen (the number is written by the CPU: 2 characters), and the distance in the orders of the robot
RMMB:	.WORD	SCREEN+<13.*TILEH*LINEW>+HUD_COL+1, 6, 0
	.BLKB	4
RMOMB:	.WORD	SCREEN+<19.*TILEH*LINEW>+HUD_COL+3, 5, 0
	.BLKB	4

; End of NEMSGS.MAC
