; Start of NEHUD.MAC
; The right panel ("STATUS") next to the game area: texts and numbers, drawn by the PPU as a list of
; strings (CMDSTS). Layout and colors are from the Z80 code Ld1e5_draw_in_game_right_hud and
; Ld293_update_stats_in_right_hud; the panel is 10 characters wide, row = row of the ZX screen.
; The status table is 12 columns wide: the number of the enemy (column 0), a space, the name (8), a space, the number of
; the player (column 11); the resources part (green names + numbers) is 10 columns wide, columns 1..11.
; Colors: 3-bit GRB indices (1 blue, 2 red, 4 green, 5 cyan, 6 yellow, 7 white).


; Draw the panel: the static texts, then the numbers from the game state
DRHUD:	PPUSTS	HUDTAB
	CALL	HUDDYN
	PPUSTS	HUDBUF
	RETURN

; Shows the day and the time on the panel. Waits only for the previous PPU command to finish
; (HUDBUF is rewritten after the PPU has read the previous list), not for this one.
DRTIME:	TST	@#PPUCOM
	BNE	DRTIME
	MOV	#HUDBUF, R4
	CALL	HBTIME
	CLR	(R4)+
	MOVHW	HUDBUF, @#PPUDAT
	MOV	#CMDSTS, @#PPUCOM
	RETURN

; Builds the strings with the numbers of the panel in HUDBUF
HUDDYN:	MOV	#HUDBUF, R4		; the buffer pointer
	CALL	HBTIME
; the resources of the player: 7 numbers, rows 17..23, columns 10..11, white on black
	MOV	#2, HDIGS
	MOV	#' , HFILL
	MOV	#Lfd22_player1_resource_counts, R5
	MOV	#<SCREEN+<17.*TILEH*LINEW>+HUD_COL+10.>, HSCR
	MOV	#7, HCNT
10$:	CLR	R0
	BISB	(R5)+, R0
	MOV	HSCR, R1
	MOV	#7, R2
	CLR	R3
	CALL	HBNUM
	ADD	#<TILEH*LINEW>, HSCR
	DEC	HCNT
	BNE	10$
; warbases and factories of the enemy (column 0) and of the player (column 9), 7 digits each, rows 6..12,
; then the number of robots, rows 13
	MOV	#Lfd42_p2_base_factory_counts, R5
	MOV	#<SCREEN+<6.*TILEH*LINEW>+HUD_COL>, HSCR
	MOV	#<SCREEN+<13.*TILEH*LINEW>+HUD_COL>, HSCR2
	CALL	HBCNTS
	MOV	#Lfd3a_p1_base_factory_counts, R5
	MOV	#<SCREEN+<6.*TILEH*LINEW>+HUD_COL+11.>, HSCR
	MOV	#<SCREEN+<13.*TILEH*LINEW>+HUD_COL+10.>, HSCR2
	CALL	HBCNTS
	CLR	(R4)+			; the end of the list
	RETURN

; The day (5 characters, leading spaces) and the time (hours.minutes) next to " DAY: " and "TIME: " (both start in column 1):
; white on black, columns 7..11 of the panel, rows 0 and 1 (Lad62_increase_time).
HBTIME:	MOV	#<SCREEN+HUD_COL+7.>, (R4)+
	MOV	#7, (R4)+
	CLR	(R4)+
	MOV	Lfd37_days, R0
	MOV	#HDTAB, R2
	CLR	R5			; no digits printed yet
10$:	CLR	R1
20$:	CMP	R0, (R2)
	BLO	30$
	SUB	(R2), R0
	INC	R1
	BR	20$
30$:	TST	R1
	BNE	40$
	TST	R5
	BNE	40$
	MOVB	#' , (R4)+		; leading zero: a space
	BR	50$
40$:	MOV	#1, R5
	ADD	#'0, R1
	MOVB	R1, (R4)+
50$:	TST	(R2)+
	CMP	R2, #HDTABE
	BNE	10$
	ADD	#'0, R0			; the unit digit
	MOVB	R0, (R4)+
	CLRB	(R4)+			; the terminator
	MOV	#<SCREEN+<TILEH*LINEW>+HUD_COL+7.>, (R4)+
	MOV	#7, (R4)+
	CLR	(R4)+
	CLR	R0
	BISB	Lfd36_hours, R0
	CALL	HBDIG2
	MOVB	#'., (R4)+
	CLR	R0
	BISB	Lfd35_minutes, R0
	CALL	HBDIG2
	CLRB	(R4)+			; the terminator
	RETURN

; Two digits of R0 (0..99) with the leading zero to the buffer at R4 (as bytes)
HBDIG2:	CLR	R1
10$:	CMP	R0, #10.
	BLO	20$
	SUB	#10., R0
	INC	R1
	BR	10$
20$:	ADD	#'0, R1
	MOVB	R1, (R4)+
	ADD	#'0, R0
	MOVB	R0, (R4)+
	RETURN

HDTAB:	.WORD	10000., 1000., 100., 10.
HDTABE:

; Strings of the counts of one player: R5 = counts (7 bytes + the number of robots), HSCR = screen
; address of the first digit, HSCR2 = screen address of the number of robots.
HBCNTS:	MOV	#1, HDIGS
	MOV	#7, HCNT
10$:	CLR	R0
	BISB	(R5)+, R0
	MOV	HSCR, R1
	MOV	#7, R2
	CLR	R3
	CALL	HBNUM
	ADD	#<TILEH*LINEW>, HSCR
	DEC	HCNT
	BNE	10$
	MOV	#2, HDIGS
	MOV	#'0, HFILL
	CLR	R0
	BISB	(R5)+, R0
	MOV	HSCR2, R1
	MOV	#7, R2
	CLR	R3
	CALL	HBNUM
	RETURN

; Appends a string block with a number to the buffer at R4: R0 = value (0..99), R1 = screen address,
; R2 = ink, R3 = paper index; HDIGS = number of digits (1 or 2), HFILL = the character for the
; leading zero of two digits. Clobbers R0-R3, advances R4.
HBNUM:	MOV	R1, (R4)+
	MOV	R2, (R4)+
	MOV	R3, (R4)+
	CLR	R1			; tens
10$:	CMP	R0, #10.
	BLO	20$
	SUB	#10., R0
	INC	R1
	BR	10$
20$:	ADD	#'0, R0			; the unit digit
	CMP	HDIGS, #2
	BLO	40$			; one digit: the terminator is in the high byte
	SWAB	R0
	TST	R1
	BNE	30$
	MOV	HFILL, R1		; no tens: the filler
	BR	35$
30$:	ADD	#'0, R1
35$:	BIS	R1, R0			; the tens digit in the low byte, the unit digit in the high byte
	MOV	R0, (R4)+
	CLR	(R4)+			; the terminator
	RETURN
40$:	MOV	R0, (R4)+
	RETURN

HDIGS:	.WORD	0
HFILL:	.WORD	0
HSCR:	.WORD	0
HSCR2:	.WORD	0
HCNT:	.WORD	0
HUDBUF:	.BLKW	<<7+7+1+7+1>*5>+1+6+6	; at most 5 words per number, 6 words for the day and the time

; End of NEHUD.MAC
