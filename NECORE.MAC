; Nether Earth UKNC port: CPU side game logic.
; Included from NEARTH.MAC. The game loop (La69a_game_loop) and the control of the player; the
; game state comes from the snapshot (NESNAP.MAC). Not ported yet: robots, bullets, AI, menus.
; STOP exits and prints the PPU measurements.
; With TESTREF defined (tools/run_snap_tests.py assembles with -s "TESTREF=1") the frame buffer and the
; radar buffers are compared with the ones of the original game (NEREF.MAC) before the first cycle and
; the number of different bytes is printed on exit.
; With TESTSPEED defined (tools/run_speed_test.py) the speed of the renderer is measured.

GAME:
	CALL	Lstart_ppu
.IF DF TESTFONT
	CALL	TESTFN			; shows the fonts, waits for STOP, then exits
	JMP	Lgame_exit
.ENDC
La600_start:
.IF NDF NOMENU
	CALL	Lc100_title_screen	; the main menu (the tests skip it: NOMENU)
	TST	R0
	BMI	Lgame_exit		; STOP in the menu: exit
	CALL	Lnew_game
.ENDC
.IF DF TESTNEW
	CALL	Lnew_game
	CALL	TESTNW
.ENDC
.IF DF TESTLAND
	CALL	Lnew_game		; the player on a robot of his: the robot menu opens at once
	MOV	#Lda00_player1_robots, R5
	MOVB	#11, ROBOT_STRUCT_PIECES(R5)	; bipod and cannon (the bits of the pieces)
.IF DF TESTLANDB
	MOVB	#<11.+64.>, ROBOT_STRUCT_PIECES(R5)	; and the nuclear bomb
.ENDC
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	MOVB	#18., ROBOT_STRUCT_HEIGHT(R5)
	CLRB	ROBOT_STRUCT_CONTROL(R5)		; ROBOT_CONTROL_AUTO = 0
	CLRB	ROBOT_STRUCT_DESIRED_DIRECTION(R5)	; the robot stands under the player
	MOVB	#5, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	CLRB	ROBOT_STRUCT_ORDERS(R5)		; ORDERS_STOP_AND_DEFEND = 0
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
.IF DF TESTDEAD
	CLRB	ROBOT_STRUCT_STRENGTH(R5)	; the robot is destroyed at once
.ENDC
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOV	#24., R3
	MOV	#8., R4
	MOV	#24., Lfd0e_player_x
	MOVB	#8., Lfd0d_player_y
	MOVB	#18., Lfd10_player_altitude
	CLRB	Lfd30_player_elevate_timer
	CALL	Lcc7c_set_robot_position
	CALL	Lbb40_count_robots
.IF DF TESTLANDF
	MOVB	#1, ROBOT_STRUCT_DIRECTION(R5)	; the robot faces right, an enemy robot is at (30, 8): the fire of the combat menu
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#12., ROBOT_STRUCT_HEIGHT(R5)
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	MOVB	#377, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	#200, ROBOT_STRUCT_CONTROL(R5)
	MOV	#30., R3
	MOV	#8., R4
	CALL	Lcc7c_set_robot_position
.ENDC
.ENDC
.IF DF TESTMOVE
	CALL	Lnew_game		; a robot of the player walks to the right, the player stays away
	MOV	#Lda00_player1_robots, R5
	MOVB	#11, ROBOT_STRUCT_PIECES(R5)	; bipod and cannon
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)	; faces down
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	MOVB	#18., ROBOT_STRUCT_HEIGHT(R5)
	CLRB	ROBOT_STRUCT_CONTROL(R5)
	MOVB	#1, ROBOT_STRUCT_DESIRED_DIRECTION(R5)	; to the right
	MOVB	#5, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	MOVB	#ORDERS_ADVANCE, ROBOT_STRUCT_ORDERS(R5)
	MOVB	#12., ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; 6 miles
.IF DF TESTBACK
	MOVB	#2, ROBOT_STRUCT_DESIRED_DIRECTION(R5)	; to the left
	MOVB	#ORDERS_RETREAT, ROBOT_STRUCT_ORDERS(R5)
.ENDC
.IF DF TESTFAR
	MOVB	#50., ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; 25 miles: the robot meets the buildings
.ENDC
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOV	#24., R3
	MOV	#8., R4
	CALL	Lcc7c_set_robot_position
	CALL	Lbb40_count_robots
.ENDC
.IF DF TESTTGT
	CALL	TESTTG			; the search of the target (see TESTTG)
.ENDC
.IF DF TESTRAY
	CALL	TESTRY			; the rays (see TESTRY)
.ENDC
.IF DF TESTFIRE
	CALL	TESTFI			; a shot (see TESTFI)
.ENDC
.IF DF TESTAI
	CALL	Lnew_game		; the whole game without the player: two robots of the player (a cannon robot that hunts the robots, a robot with a
	MOV	#Lda00_player1_robots, R5	; cannon that captures neutral factories) and the AI of the enemy
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#ORDERS_DESTROY_ENEMY_ROBOTS, ROBOT_STRUCT_ORDERS(R5)
	MOV	#45., R3
	CALL	TAMK
	MOV	#<Lda00_player1_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#ORDERS_CAPTURE_NEUTRAL_FACTORIES, ROBOT_STRUCT_ORDERS(R5)
	MOV	#34., R3
	CALL	TAMK
	CALL	Lbb40_count_robots
.ENDC
.IF DF TESTEND
	INC	TECNT			; how many times the test started (the restart after the end)
.IF DF NOMENU
	CALL	Lnew_game		; the end: TESTEND: the bases 1..3 of the enemy are destroyed (the victory), TESTENDD: the base 0 of the player
.ENDC
.IF NDF TESTENDD
	MOV	#1, R0
	CALL	Lbbf9_destroy_warbase
	MOV	#2, R0
	CALL	Lbbf9_destroy_warbase
	MOV	#3, R0
	CALL	Lbbf9_destroy_warbase
.IFF
	CLR	R0
	CALL	Lbbf9_destroy_warbase
.ENDC
	CALL	Lbb09_update_base_factory_counts
.ENDC
.IF DF TESTDAY
	CALL	Lnew_game		; the day: the factory 0 (type 4) to the player, resources 95 and 10, the enemy 0; 23:55
	CLR	R0
	CLR	R2
	CALL	Lbb61_assign_factory_to_player
	CALL	Lbb09_update_base_factory_counts
	MOVB	#95., Lfd22_player1_resource_counts
	MOVB	#10., Lfd22_player1_resource_counts+1
	CLRB	Lfd4a_player2_resource_counts
	MOVB	#23., Lfd36_hours
	MOVB	#55., Lfd35_minutes
.ENDC
.IF DF TESTAIO
	CALL	Lnew_game		; new orders of a robot of the enemy, 64 times: the histogram of the orders in AIOCNT
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)	; TESTAIOB: with the nuclear bomb
.IF DF TESTAIOB
	MOVB	#<9.+64.>, ROBOT_STRUCT_PIECES(R5)
.ENDC
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#377, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	#200, ROBOT_STRUCT_CONTROL(R5)
	MOVB	#1, Lfd51_robot_player_or_enemy
	MOV	#60., R3
	MOV	#8., R4
	CALL	Lcc7c_set_robot_position
	MOV	#64., AIOI
10$:	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	CALL	Lb95d_assign_new_orders
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	ASL	R0
	INC	AIOCNT(R0)
	DEC	AIOI
	BNE	10$
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOVB	#4, ROBOT_STRUCT_ORDERS(R5)	; the robot has orders: Lb920 keeps them mostly
.ENDC
.IF DF TESTAIB
	CALL	Lnew_game		; the enemy builds robots (nothing else is set up)
	CALL	Lbb40_count_robots
.ENDC
.IF DF TESTBOMB
	CALL	Lnew_game		; a robot at (39, 5): the bomb destroys the factory 0 at (39, 6); TESTBOMBC: at (44, 5), TESTBOMBD:
	MOV	#Lda00_player1_robots, R5	; at (43, 8): out of the range
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#377, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	CLRB	ROBOT_STRUCT_CONTROL(R5)
	MOV	#39., R3
	MOV	#5, R4
.IF DF TESTBOMBC
	MOV	#44., R3
.ENDC
.IF DF TESTBOMBD
	MOV	#43., R3
	MOV	#8., R4
.ENDC
.IF DF TESTBOMBE
	MOV	#32., R3			; the element of the type 17 at (32, 3) is in the window
.ENDC
	CALL	Lcc7c_set_robot_position
.IF DF TESTBOMBW
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5	; the robots of the enemy: (41, 7) in the window,
	MOV	#41., R3					; (45, 5) out of it
	MOV	#7, R4
	CALL	TBMK
	MOV	#<Ldb80_player2_robots+<2*ROBOT_STRUCT_SIZE>>, R5
	MOV	#45., R3
	MOV	#5, R4
	CALL	TBMK
.ENDC
.IF NDF TESTBOMBN
	MOV	#Lda00_player1_robots, R5
	CALL	Lb99f_fire_nuclear_bomb
.ENDC
.ENDC
.IF DF TESTBLD
	CALL	Lnew_game		; the factory 0 and the warbase 1 are destroyed (see the screen and the records)
.IF NDF TESTBLDN
	CLR	R0
	CALL	Lbbd8_destroy_factory
	MOV	#1, R0
	CALL	Lbbf9_destroy_warbase
	CALL	Lbb09_update_base_factory_counts
.ENDC
	MOV	#34., Lfd0e_player_x		; the player looks at the factory 0 (39, 6), TESTBLDB: at the warbase 1 (261, 8)
.IF DF TESTBLDB
	MOV	#256., Lfd0e_player_x
.ENDC
	MOVB	#8., Lfd0d_player_y
	MOVB	#18., Lfd10_player_altitude
.ENDC
.IF DF TESTSEEK
	CALL	Lnew_game		; a robot of the player (orders 3) at x = 45 looks for the enemy robot at x = 60
	MOV	#60., R3
	MOV	#8., R4
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	#200, ROBOT_STRUCT_CONTROL(R5)
	CALL	Lcc7c_set_robot_position
	MOV	#Lda00_player1_robots, R5
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	CLRB	ROBOT_STRUCT_CONTROL(R5)
	MOVB	#ORDERS_DESTROY_ENEMY_ROBOTS, ROBOT_STRUCT_ORDERS(R5)
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CLRB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	MOV	#45., R3
	MOV	#8., R4
.IF DF TESTSEEKB
	MOVB	#ORDERS_CAPTURE_NEUTRAL_FACTORIES, ROBOT_STRUCT_ORDERS(R5)	; the factory 0 is at x = 39, y = 6
	MOV	#34., R3
.IF DF TESTSEEKX
	MOVB	#ORDERS_DESTROY_ENEMY_FACTORIES, ROBOT_STRUCT_ORDERS(R5)	; the bomb: the factory 0 is the enemy's
	MOVB	#<9.+64.>, ROBOT_STRUCT_PIECES(R5)
	MOV	R5, -(SP)
	MOV	R3, -(SP)
	MOV	R4, -(SP)
	CLR	R0
	MOV	#1, R2
	CALL	Lbb61_assign_factory_to_player
	MOV	(SP)+, R4
	MOV	(SP)+, R3
	MOV	(SP)+, R5
.ENDC
.ENDC
	CALL	Lcc7c_set_robot_position
	CALL	Lbb40_count_robots
.ENDC
.IF DF TESTCONS
	CALL	Lnew_game		; the player above the "H" of his warbase: the construction screen opens at once
	MOV	#22., Lfd0e_player_x
	MOVB	#5, Lfd0d_player_y
	MOVB	#16., Lfd10_player_altitude
	CLRB	Lfd30_player_elevate_timer
.ENDC
	CALL	Ld0ca_draw_in_game_screen
.IF DF TESTSPEED
	CALL	BENCH
.ENDC
.IF DF TESTREF
	CALL	CMPREF
	CALL	TESTRN
.ENDC
;
	MOV	@#PPUTCK, CYCT0
;
; The game play (the landing, the robots) is compiled in the normal build and in the tests TESTCONS, TESTLAND
; (the other tests with NOMENU compare the state of a snapshot)
.IF NDF NOMENU
LANDING = 1
.IFF
.IF DF TESTCONS
LANDING = 1
.ENDC
.IF DF TESTLAND
LANDING = 1
.ENDC
.IF DF TESTMOVE
LANDING = 1
.ENDC
.IF DF TESTTGT
LANDING = 1
.ENDC
.IF DF TESTSEEK
LANDING = 1
.ENDC
.IF DF TESTRAY
LANDING = 1
.ENDC
.IF DF TESTFIRE
LANDING = 1
.ENDC
.IF DF TESTBLD
LANDING = 1
.ENDC
.IF DF TESTBOMB
LANDING = 1
.ENDC
.IF DF TESTAIB
LANDING = 1
.ENDC
.IF DF TESTAIO
LANDING = 1
.ENDC
.IF DF TESTAI
LANDING = 1
.ENDC
.IF DF TESTDAY
LANDING = 1
.ENDC
.IF DF TESTEND
LANDING = 1
.ENDC
.IF DF TESTLANDB
NOGAMEOVER = 1
.ENDC
.ENDC
; The main game loop
La69a_game_loop:
	CALL	Ld37c_read_keyboard_input
	CALL	Laf11_player_ship_control
.IF DF LANDING
	CALL	Lb0ca_update_robots_and_ai
.ENDC
	CALL	DRPORT			; Lccbd_redraw_game_area
	CALL	Lad62_increase_time
.IF DF LANDING
	CALL	Lcca0_compute_player_map_ptr
	BITB	#MAPB_OCCUPIED, Ldd00_map(R3)
	BEQ	La70d_game_loop_continue
	CALL	Lcdd8_get_robot_at_ptr
	BNE	La6c8_not_landed_on_a_robot
	CMP	R5, #<Lda00_player1_robots+<MAX_ROBOTS_PER_PLAYER*ROBOT_STRUCT_SIZE>>
	BHIS	La70d_game_loop_continue		; a robot of the enemy: ignore
	CLR	R0
	BISB	Lfd10_player_altitude, R0
	CLR	R1
	BISB	ROBOT_STRUCT_HEIGHT(R5), R1
	SUB	R1, R0
	CLR	R1
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R1
	SUB	R1, R0
	BNE	La70d_game_loop_continue		; not right on top of the robot
	CALL	La720_land_on_robot
	BR	La70d_game_loop_continue
La6c8_not_landed_on_a_robot:
	CALL	Lcdf5_find_decoration_with_ptr
	BNE	La70d_game_loop_continue		; not on top of any ownable building
	TSTB	DECOR_STRUCT_TYPE(R5)
	BNE	La70d_game_loop_continue		; not on top of the "H" of a warbase
	CMPB	Lfd10_player_altitude, #15.
	BNE	La70d_game_loop_continue		; not at the right height
	MOV	(R5), R3
	ADD	#4000, R3				; 4 rows down: the warbase
; bit 6 in a 2x2 area around the base of the warbase: something (a robot) is in the way
	MOVB	Ldd00_map(R3), R0
	ADD	#1000, R3
	BISB	Ldd00_map(R3), R0
	DEC	R3
	BISB	Ldd00_map(R3), R0
	INC	R3
	INC	R3
	BISB	Ldd00_map(R3), R0
	BIT	#MAPB_OCCUPIED, R0
	BNE	La70d_game_loop_continue
	CALL	Lc849_construction_if_possible
.ENDC
La70d_game_loop_continue:
	BIT	#PKEYST, @#PPUKEY	; STOP key?
	BEQ	La69a_game_loop
.IF NDF NOMENU
	CALL	Lpause_menu		; STOP: the pause menu
	TST	R0
	BEQ	La69a_game_loop		; CONTINUE
	BR	La600_start		; ABORT GAME: the main menu
.ENDC
;
; Exit: stop the PPU program, then (normal build) restore the palette and the screen and leave the
; program (FNCORE); the test builds show the measurements and wait for a key
Lgame_exit:
	CALL	STOPPU
.IF NDF NOMENU
	JMP	FNCORE
.IFF
	MOV	#EXITSC, R1
	CALL	PRINT
.IF DF TESTSPEED
	MOV	#MSGSPB, R1
	CALL	PRINT
	MOV	SPTB, R0
	CALL	PRDEC
	MOV	#MSGSPF, R1
	CALL	PRINT
	MOV	SPTF, R0
	CALL	PRDEC
	MOV	#MSGSPN, R1
	CALL	PRINT
.ENDC
.IF DF TESTNEW
	MOV	#MSGNEW, R1
	CALL	PRINT
	MOV	#NWSUM, R4
	MOV	(R4)+, R0
	CALL	PRDEC
	MOV	#MSGSP, R1
	CALL	PRINT
	MOV	(R4)+, R0
	CALL	PRDEC
	MOV	#MSGSP, R1
	CALL	PRINT
	MOV	(R4)+, R0
	CALL	PRDEC
	MOV	#MSGSP, R1
	CALL	PRINT
	MOV	(R4)+, R0
	CALL	PRDEC
.ENDC
.IF DF TESTREF
	MOV	#MSGRND, R1
	CALL	PRINT
	MOV	RNDSUM, R0
	CALL	PRDEC
	MOV	#MSGDIF, R1
	CALL	PRINT
	MOV	DIFCNT, R0
	CALL	PRDEC
	MOV	#MSGFST, R1
	CALL	PRINT
	MOV	DIFFST, R0
	CALL	PRDEC
	MOV	#MSGRAD, R1
	CALL	PRINT
	MOV	DIFRAD, R0
	CALL	PRDEC
	MOV	#MSGFST, R1
	CALL	PRINT
	MOV	DIFRDF, R0
	CALL	PRDEC
.ENDC
	MOV	#MSGPAS, R1
	CALL	PRINT
	MOV	@#PPUPAS, R0
	CALL	PRDEC
	MOV	#MSGTCK, R1
	CALL	PRINT
	MOV	@#PPUTCK, R0
	CALL	PRDEC
	MOV	#MSGEND, R1
	CALL	PRINT
	TSTB	@#177560
	BPL	.-4
	MOV	OSTACK, SP
	EMT	350			; .EXIT
.ENDC

; Parameter blocks for the PPU print command: screen address, ink, paper index, string
FRMBLK:	.WORD	SCREEN+<<VIEW_ROW-1>*TILEH*LINEW>+<VIEW_COL-1>, VIEW_W+2, <VIEW_H/TILEH>+2, 0, 7

.IF DF TESTSPEED
MSGSPB:	.ASCIZ	/Render, 50Hz ticks for 20 frames: blank map /
MSGSPF:	.ASCIZ	/, whole frame /
MSGSPN:	.BYTE	15, 12
	.ASCIZ	/(PPU runs at the same time)/
.ENDC
.IF DF TESTNEW
MSGNEW:	.BYTE	15, 12
	.ASCIZ	/New game checksums: /
MSGSP:	.ASCIZ	/ /
.ENDC
.IF DF TESTREF
MSGRND:	.BYTE	15, 12
	.ASCIZ	/Random checksum: /
MSGDIF:	.ASCIZ	/Different bytes: /
MSGFST:	.ASCIZ	/  first at: /
MSGRAD:	.BYTE	15, 12
	.ASCIZ	/Radar different bytes: /
.ENDC
MSGPAS:	.BYTE	15, 12
	.ASCIZ	/PPU passes: /
MSGTCK:	.ASCIZ	/  ticks (50Hz): /
MSGEND:	.BYTE	15, 12
	.ASCIZ	/Press any key/
	.EVEN

;------------------------------------------------------------------------------

; Render the game area with the port code into the frame buffer
; The frame is rendered into RNDBUF and then copied to FRBUF, which the PPU shows (no half drawn frames).
DRPORT:	CALL	Lcfd7_draw_blank_map_in_buffer
	CALL	Lccc6_draw_map_to_buffer
	MOV	#RNDBUF, R0
	MOV	#FRBUF, R1
	MOV	#<VIEW_BYTES/2>, R2
10$:	MOV	(R0)+, (R1)+
	SOB	R2, 10$
	RETURN

.IF DF TESTSPEED
; Speed of the renderer on the CPU: ticks (PPUTCK, passed by the PPU every 50Hz tick) for SPN frames
SPN = 20.
SPT0:	.WORD	0
SPTB:	.WORD	0			; the blank map: Lcfd7_draw_blank_map_in_buffer
SPTF:	.WORD	0			; the whole frame: blank map + Lccc6_draw_map_to_buffer
SPCNT:	.WORD	0

BENCH:	MOV	@#PPUTCK, SPT0
	MOV	#SPN, SPCNT
10$:	CALL	Lcfd7_draw_blank_map_in_buffer
	DEC	SPCNT
	BNE	10$
	MOV	@#PPUTCK, SPTB
	SUB	SPT0, SPTB
	MOV	@#PPUTCK, SPT0
	MOV	#SPN, SPCNT
20$:	CALL	DRPORT
	DEC	SPCNT
	BNE	20$
	MOV	@#PPUTCK, SPTF
	SUB	SPT0, SPTF
	RETURN
.ENDC

.IF DF TESTREF
RNDSUM:	.WORD	0			; The checksum of 1000 numbers of the random generator
RNDCNT:	.WORD	0

; Runs the random generator 1000 times and restores its state: RNDSUM = sum = sum * 2 + number
TESTRN:	MOV	Lfd00_random_seed, -(SP)
	MOV	Lfd00_random_seed+2, -(SP)
	MOVB	Ld370_random_index, -(SP)
	CLR	RNDSUM
	MOV	#1000., RNDCNT
10$:	CALL	Ld358_random
	MOV	RNDSUM, R1
	ASL	R1
	ADD	R0, R1
	MOV	R1, RNDSUM
	DEC	RNDCNT
	BNE	10$
	MOVB	(SP)+, Ld370_random_index
	MOV	(SP)+, Lfd00_random_seed+2
	MOV	(SP)+, Lfd00_random_seed
	RETURN

DIFCNT:	.WORD	0			; Number of different bytes
DIFFST:	.WORD	0			; Index of the first different byte
DIFRAD:	.WORD	0			; Number of different bytes in the radar buffers
DIFRDF:	.WORD	0			; Index of the first different byte

; Compare the frame buffer with the original: DIFCNT = number of different bytes, DIFFST = first
CMPREF:	CLR	DIFRAD
	MOV	#-1, DIFRDF
	MOV	#Ld800_radar_view1, R0
	MOV	#REFRAD, R1
	MOV	#512., R2
5$:	CMPB	(R0)+, (R1)+
	BEQ	6$
	INC	DIFRAD
	TST	DIFRDF
	BPL	6$
	MOV	R0, DIFRDF
	SUB	#Ld800_radar_view1+1, DIFRDF
6$:	SOB	R2, 5$
	CLR	DIFCNT
	MOV	#-1, DIFFST
	MOV	#FRBUF, R0
	MOV	#REFBUF, R1
	MOV	#VIEW_BYTES, R2
10$:	CMPB	(R0)+, (R1)+
	BEQ	20$
	INC	DIFCNT
	TST	DIFFST
	BPL	20$
	MOV	R0, DIFFST
	SUB	#FRBUF+1, DIFFST
20$:	SOB	R2, 10$
	RETURN
.ENDC

;------------------------------------------------------------------------------
; The new game: La600_start (the initial state) and Lbc6f_initialize_map, which builds the map and the
; records of the buildings from the descriptors of NEMAP.MAC. Map pointers are offsets.

MAPXB:	.WORD	0			; the x of the first column of the list being added (0 or 256.)
BLDW:	.WORD	0			; the next record of a warbase
BLDF:	.WORD	0			; the next record of a factory

; The state at the start of a game
Lnew_game:
; clear the state block (the index of the random generator is kept, as in the original)
	CLR	R2
	BISB	Ld370_random_index, R2
	MOV	R2, -(SP)
	MOV	#GSTATE, R0
	MOV	#<GS_SIZE/2>, R1
10$:	CLR	(R0)+
	SOB	R1, 10$
	MOV	(SP)+, R2
	MOVB	R2, Ld370_random_index
; free slots of the robots, bullets and decorations
	MOV	#Lda00_player1_robots, R0
	MOV	#<MAX_ROBOTS_PER_PLAYER*2>, R1
20$:	MOV	#NOSLOT, (R0)
	ADD	#ROBOT_STRUCT_SIZE, R0
	SOB	R1, 20$
	MOV	#Ld7d3_bullets, R0
	MOV	#MAX_BULLETS, R1
30$:	MOV	#NOSLOT, (R0)
	ADD	#BULLET_STRUCT_SIZE, R0
	SOB	R1, 30$
	MOV	#Lff01_building_decorations, R0
	MOV	#56., R1
40$:	MOV	#NOSLOT, (R0)
	ADD	#DECOR_STRUCT_SIZE, R0
	SOB	R1, 40$
; the initial values
	MOV	#12345., Lfd00_random_seed
	MOV	#12345., Lfd00_random_seed+2
	MOV	#17., Lfd0e_player_x
	MOVB	#10., Lfd0d_player_y
	MOVB	#3, Lfd30_player_elevate_timer	; the player floats a bit at the start
	MOVB	#INITIAL_PLAYER_RESOURCES, Lfd22_player1_resource_counts
	MOVB	#INITIAL_PLAYER_RESOURCES, Lfd4a_player2_resource_counts
; the map; the player is put to the map and the radar is updated at its end
Lbc6f_initialize_map:
	MOV	#Ldd00_map, R0
	MOV	#<MAP_SIZE/2>, R1
10$:	CLR	(R0)+
	SOB	R1, 10$
	MOV	#Ld800_radar_view1, R0		; both radar views
	MOV	#<512./2>, R1
20$:	CLR	(R0)+
	SOB	R1, 20$
	MOV	#Lbda9_map_elements_part1, R5
	CLR	MAPXB
	CALL	Lbcd6_add_elements_to_map
	MOV	#Lbe79_map_elements_part2, R5
	MOV	#256., MAPXB
	CALL	Lbcd6_add_elements_to_map
	MOV	#Lfd70_warbases, BLDW
	MOV	#Lfd84_factories, BLDF
	MOV	#Lbf46_warbases_factories_part1, R5
	CLR	MAPXB
	CALL	Lbcf9_add_warbases_and_factories
	MOV	#Lbf6e_warbases_factories_part2, R5
	MOV	#256., MAPXB
	CALL	Lbcf9_add_warbases_and_factories
	CLR	R0
	CLR	R2
	CALL	Lbb86_assign_warbase_to_player	; the warbase 0 to the player 1
	MOV	#1, R0
	MOV	#1, R2
	CALL	Lbb86_assign_warbase_to_player	; the warbases 1, 2 and 3 to the player 2
	MOV	#2, R0
	MOV	#1, R2
	CALL	Lbb86_assign_warbase_to_player
	MOV	#3, R0
	MOV	#1, R2
	CALL	Lbb86_assign_warbase_to_player
	CALL	Lbb09_update_base_factory_counts
	MOVB	#1, Lfd52_update_radar_buffer_signal
	JMP	Lb024_add_player_to_map

; Writes the map byte R1 at the offset R3 (not outside of the map)
PUTMAP:	CMP	R3, #MAP_SIZE
	BHIS	10$
	MOVB	R1, Ldd00_map(R3)
10$:	RETURN

; Adds an element to the map: R3 = the offset of the bottom left cell, R0 = the type. It is 2x2 cells, only
; the bottom left one has bit 5 = 0. Preserves R3. Clobbers R1.
Lbd91_add_element_to_map:
	MOV	R3, -(SP)
	MOV	R0, R1
	CALL	PUTMAP
	BIS	#40, R1
	INC	R3
	CALL	PUTMAP
	SUB	#1001, R3			; one row up, the first column
	CALL	PUTMAP
	INC	R3
	CALL	PUTMAP
	MOV	(SP)+, R3
	RETURN

; Adds a complex structure to the map: R3 = the offset, R0 = the index of the structure.
; Preserves R3. Clobbers R0, R1, R2, R4.
Lbd61_add_complex_structure:
	MOV	R3, -(SP)
	ASL	R0
	MOV	Lbf9c_map_complex_structure_ptrs(R0), R2
10$:	CLR	R0
	BISB	(R2)+, R0
	BEQ	20$
	CALL	Lbd91_add_element_to_map
20$:	MOVB	(R2)+, R1			; the offset to the next element, signed
	MOVB	(R2)+, R4
	MOV	R1, R0
	BIS	R4, R0
	BEQ	30$				; x == y == 0: the end
	ADD	R1, R3
	ASH	#9., R4
	ADD	R4, R3
	BR	10$
30$:	MOV	(SP)+, R3
	RETURN

; Adds a list of map elements (type, x, y; 0 at the end) to the map: R5 = the list, MAPXB = the x of
; the first column. The elements with the bit 7 are complex structures.
Lbcd6_add_elements_to_map:
10$:	CLR	R0
	BISB	(R5)+, R0
	BEQ	90$
	CLR	R3
	BISB	(R5)+, R3
	ADD	MAPXB, R3
	CLR	R1
	BISB	(R5)+, R1
	SWAB	R1
	ASL	R1				; y * 512
	ADD	R1, R3
	BIT	#200, R0
	BNE	20$
	CALL	Lbd91_add_element_to_map
	BR	10$
20$:	BIC	#200, R0
	CALL	Lbd61_add_complex_structure
	BR	10$
90$:	RETURN

; Adds the warbases and the factories (type, x, y; 377 at the end) to the map and to the lists of
; records: R5 = the list, MAPXB = the x of the first column, BLDW and BLDF = the next records.
; The factories get the decoration of their type.
Lbcf9_add_warbases_and_factories:
10$:	MOVB	(R5)+, R0
	BMI	90$
	CLR	R3
	BISB	(R5)+, R3
	ADD	MAPXB, R3			; x
	CLR	R2
	BISB	(R5)+, R2			; y
	TST	R0
	BNE	20$
	MOV	BLDW, R4
	ADD	#BUILDING_STRUCT_SIZE, BLDW
	BR	30$
20$:	MOV	BLDF, R4
	ADD	#BUILDING_STRUCT_SIZE, BLDF
30$:	MOV	R3, BUILDING_STRUCT_X(R4)
	MOVB	R2, BUILDING_STRUCT_Y(R4)
	MOVB	R0, BUILDING_STRUCT_TYPE(R4)
	CLRB	BUILDING_STRUCT_TIMER(R4)
	SWAB	R2
	ASL	R2
	ADD	R2, R3				; the map offset
	MOV	R0, -(SP)			; the type
	TST	R0
	BNE	40$
	CALL	Lbd61_add_complex_structure	; R0 = 0: the structure of a warbase
	BR	50$
40$:	MOV	#1, R0
	CALL	Lbd61_add_complex_structure	; the structure of a factory
	SUB	#2000, R3			; two rows up
	MOV	(SP), R1
	CALL	Lbc43_add_decoration_to_map
50$:	TST	(SP)+
	BR	10$
90$:	RETURN

; Adds a decoration (a flag, "H", the type of a factory) at the map offset R3, type R1: takes the first free
; record and marks the map cell (bit 6). Preserves R1, R3. Clobbers R0, R2.
Lbc43_add_decoration_to_map:
	MOV	#Lff01_building_decorations, R2
	MOV	#56., R0
10$:	CMP	(R2), #NOSLOT
	BEQ	20$
	ADD	#DECOR_STRUCT_SIZE, R2
	SOB	R0, 10$
	RETURN
20$:	BISB	#MAPB_OCCUPIED, Ldd00_map(R3)
	MOV	R3, (R2)
	MOVB	R1, DECOR_STRUCT_TYPE(R2)
	RETURN

; Removes the decoration at the map offset R3, if there is one. Preserves R1, R3, R5.
Lbc5d_remove_decoration:
	MOV	R5, -(SP)
	MOV	R1, -(SP)
	CALL	Lcdf5_find_decoration_with_ptr
	BNE	10$
	MOV	#NOSLOT, (R5)
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)
10$:	MOV	(SP)+, R1
	MOV	(SP)+, R5
	RETURN

; Marks the owner of a warbase or a factory (bit 6: the player 1, bit 5: the player 2) and returns its map
; offset. R0 = the index, R4 = the array of the records, R2 = the owner (0 or 1) => R3.
; Clobbers R0, R1.
Lbbb9_mark_ath_building:
	MOV	R0, R1
	ASL	R1
	ADD	R0, R1
	ASL	R1				; * BUILDING_STRUCT_SIZE
	ADD	R4, R1
	MOV	#100, R0			; the player 1: bit 6
	TST	R2
	BEQ	10$
	MOV	#40, R0				; the player 2: bit 5
10$:	CLR	R3
	BISB	BUILDING_STRUCT_TYPE(R1), R3
	BIC	#^C37, R3
	BIS	R0, R3
	MOVB	R3, BUILDING_STRUCT_TYPE(R1)
	MOV	BUILDING_STRUCT_X(R1), R3
	CLR	R0
	BISB	BUILDING_STRUCT_Y(R1), R0
	SWAB	R0
	ASL	R0
	ADD	R0, R3
	RETURN

; Gives a warbase to a player: R0 = the warbase, R2 = the owner (0 the player, 1 the enemy). Removes the
; old flags above it and puts the new ones: "H" and the flag of the player, or the flag of the enemy.
Lbb86_assign_warbase_to_player:
	MOV	R2, -(SP)
	MOV	#Lfd70_warbases, R4
	CALL	Lbbb9_mark_ath_building
	SUB	#4000, R3			; 4 rows up
	CALL	Lbc5d_remove_decoration
	SUB	#4, R3
	CALL	Lbc5d_remove_decoration
	ADD	#10, R3
	CALL	Lbc5d_remove_decoration
	MOV	(SP)+, R2
	TST	R2
	BEQ	10$
	MOV	#8., R1				; the flag of the enemy
	BR	Lbc43_add_decoration_to_map
10$:	SUB	#4, R3
	CLR	R1				; "H"
	CALL	Lbc43_add_decoration_to_map
	SUB	#4, R3
	MOV	#7, R1				; the flag of the player
	BR	Lbc43_add_decoration_to_map

; Gives a factory to a player: R0 = the factory, R2 = the owner (0 the player, 1 the enemy). Removes the old flags
; above it and puts the new one: the flag of the player (7) or of the enemy (8), to the right.
Lbb61_assign_factory_to_player:
	MOV	R2, -(SP)
	MOV	#Lfd84_factories, R4
	CALL	Lbbb9_mark_ath_building
	SUB	#2000, R3			; 2 rows up
	ADD	#2, R3
	CALL	Lbc5d_remove_decoration		; a flag of the enemy
	SUB	#4, R3
	CALL	Lbc5d_remove_decoration		; a flag of the player
	MOV	(SP)+, R2
	TST	R2
	BEQ	10$
	ADD	#4, R3
	MOV	#8., R1				; the flag of the enemy
	BR	Lbc43_add_decoration_to_map
10$:	MOV	#7, R1				; the flag of the player
	BR	Lbc43_add_decoration_to_map

; Counts the warbases and the factories of each type of each player
Lbb09_update_base_factory_counts:
	MOV	#Lfd3a_p1_base_factory_counts, R1
	MOV	#7, R2
10$:	CLRB	(R1)+
	SOB	R2, 10$
	MOV	#Lfd42_p2_base_factory_counts, R1
	MOV	#7, R2
20$:	CLRB	(R1)+
	SOB	R2, 20$
	MOV	#Lfd70_warbases, R1
	MOV	#<N_WARBASES+N_FACTORIES>, R2
30$:	MOVB	BUILDING_STRUCT_TYPE(R1), R0
	BMI	50$				; destroyed
	BIT	#100, R0
	BEQ	35$
	MOV	#Lfd3a_p1_base_factory_counts, R3
	BR	40$
35$:	BIT	#40, R0
	BEQ	50$				; neutral
	MOV	#Lfd42_p2_base_factory_counts, R3
40$:	BIC	#^C7, R0
	ADD	R0, R3
	INCB	(R3)
50$:	ADD	#BUILDING_STRUCT_SIZE, R1
	SOB	R2, 30$
	RETURN

.IF DF TESTNEW
; The checksums of the state of a new game (tools/conv_map.py --newgame): sum = sum * 2 + byte
NWSUM:	.BLKW	4
NWFOLD:	CLR	R3			; R0 = the address, R1 = the length, R2 = the sum
	BISB	(R0)+, R3
	ASL	R2
	ADD	R3, R2
	SOB	R1, NWFOLD
	RETURN

TESTNW:	MOV	#Ldd00_map, R0
	MOV	#MAP_SIZE, R1
	CLR	R2
	CALL	NWFOLD
	MOV	R2, NWSUM
	MOV	#Lfd70_warbases, R0
	MOV	#<<N_WARBASES+N_FACTORIES>*BUILDING_STRUCT_SIZE>, R1
	CLR	R2
	CALL	NWFOLD
	MOV	R2, NWSUM+2
	MOV	#Lff01_building_decorations, R0
	MOV	#<56.*DECOR_STRUCT_SIZE>, R1
	CLR	R2
	CALL	NWFOLD
	MOV	R2, NWSUM+4
	MOV	#Lfd22_player1_resource_counts, R0
	MOV	#16., R1
	CLR	R2
	CALL	NWFOLD
	MOV	#Lfd3a_p1_base_factory_counts, R0
	MOV	#16., R1
	CALL	NWFOLD
	MOV	R2, NWSUM+6
	RETURN
.ENDC

;------------------------------------------------------------------------------
.IF DF TESTFONT
; The font test (build with -s "TESTFONT=1" and NOMENU): shows the Latin font and the Cyrillic font
; (the capitals in the order of KOI8-R: codes 224..255) and waits for STOP.
TESTFN:	PPUCMW	#CMDCLS
	MOVHW	FNTLST, @#PPUDAT
	PPUCMW	#CMDSTS
10$:	BIT	#PKEYST, @#PPUKEY
	BEQ	10$
	RETURN

FNTLST:	.WORD	SCREEN+<3.*TILEH*LINEW>+4., 7, 0
	.ASCIZ	/ !"#$%&'()*+,-./0123456789:;<=>?/
	.EVEN
	.WORD	SCREEN+<5.*TILEH*LINEW>+4., 7, 0
	.ASCIZ	/@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]^_/
	.EVEN
	.WORD	SCREEN+<7.*TILEH*LINEW>+4., 6, 0		; KOI8-R 224..255: YU A BE TSE DE E EF GE ...
	.BYTE	340,341,342,343,344,345,346,347,350,351,352,353,354,355,356,357
	.BYTE	360,361,362,363,364,365,366,367,370,371,372,373,374,375,376,377,0
	.EVEN
	.WORD	0

.ENDC

;------------------------------------------------------------------------------
; The game screen: clears the screen, draws the panel, the frame, the first frame of the game area and
; the radar, and switches the PPU to the game mode. Also after the screens that replace it.
Ld0ca_draw_in_game_screen:
	PPUCMW	#CMDCLS
	CALL	DRHUD			; the right panel (status)
	PPUFRM	FRMBLK			; the frame around the game area, drawn by the PPU
	CALL	DRPORT			; render
	MOVB	#1, Lfd52_update_radar_buffer_signal
	CALL	Lb029_update_radar_view
	PPUCMW	#CMDGAME		; the PPU shows the game area and the radar
	RETURN

.IF DF LANDING			; the robots, their menus and the construction screen: not in the tests of the snapshots (memory)
;------------------------------------------------------------------------------
; The robots: Lb0ca (every cycle of the game, also inside the menus of the robot). So far no bullets, no enemy AI,
; no movement: a robot only takes its mark off the map and puts it back. TODO: the movement (the step 1 of
; the plan in PORTNOTES.md).

; Flips the robot R5 in the radar views (0 for a robot of the player, 1 for an enemy). Preserves R5
Lrb_flip_radar:
	MOV	R5, -(SP)
	MOV	ROBOT_STRUCT_X(R5), R0
	CLR	R1
	BISB	ROBOT_STRUCT_Y(R5), R1
	CLR	R2
	TSTB	ROBOT_STRUCT_CONTROL(R5)
	BPL	10$
	INC	R2
10$:	CALL	Ld65a_flip_2x2_radar_area
	MOV	(SP)+, R5
	RETURN

; The numbers of the HUD again (not while the panel shows the menu of a robot: Lfd39_current_in_game_right_hud)
Lrb_hud:
	TSTB	Lfd39_current_in_game_right_hud
	BNE	10$
	CALL	HUDDYN
	PPUSTS	HUDBUF
10$:	RETURN

Lb0ca_update_robots_and_ai:
	CALL	Lb7f4_update_enemy_ai
	MOV	#Lda00_player1_robots, R5
	MOV	#<MAX_ROBOTS_PER_PLAYER*2>, R4
10$:	CMP	(R5), #NOSLOT
	BEQ	20$			; no robot in this slot
	MOV	R4, -(SP)
	MOV	R5, -(SP)
	CALL	Lb0fa_robot_update
	MOV	(SP)+, R5
	MOV	(SP)+, R4
20$:	ADD	#ROBOT_STRUCT_SIZE, R5
	SOB	R4, 10$
	MOV	#Ld7d3_bullets, R5
	MOV	#MAX_BULLETS, R4
30$:	CMP	(R5), #NOSLOT
	BEQ	40$			; no bullet in this slot
	MOV	R4, -(SP)
	MOV	R5, -(SP)
	CALL	Lb70d_bullet_update
	MOV	(SP)+, R5
	MOV	(SP)+, R4
40$:	ADD	#BULLET_STRUCT_SIZE, R5
	SOB	R4, 30$
	RETURN

; ----- The bullets. The sound (Lfd53) is a TODO.
; Lb6b8: R4 = the robot that fires => R5 = a free bullet of its side (the player: the slots 1 and 2, the enemy: 3 and
; 4, the slot 0 is for the combat mode of the player), Z: found
Lb6b8_find_new_bullet_ptr:
	MOV	#<Ld7d3_bullets+BULLET_STRUCT_SIZE>, R5
	TSTB	ROBOT_STRUCT_CONTROL(R4)
	BPL	10$
	ADD	#<BULLET_STRUCT_SIZE*2>, R5
10$:	CMP	(R5), #NOSLOT
	BEQ	20$
	ADD	#BULLET_STRUCT_SIZE, R5
	CMP	(R5), #NOSLOT
20$:	RETURN

; Lb6d6: R0 = the weapon (1 cannon, 2 missiles, 3 phasers), R5 = the bullet, R4 = the robot that fires
Lb6d6_weapon_fire:
	MOVB	R0, BULLET_STRUCT_TYPE(R5)
	MOV	#WEAPON_RANGE_DEFAULT, R1
	CMP	R0, #2
	BNE	10$
	MOV	#WEAPON_RANGE_MISSILES, R1	; the missiles go further
10$:	TSTB	ROBOT_STRUCT_PIECES(R4)
	BPL	20$
	INC	R1				; the electronics: +1
20$:	MOVB	R1, BULLET_STRUCT_RANGE(R5)
	MOVB	ROBOT_STRUCT_DIRECTION(R4), BULLET_STRUCT_DIRECTION(R5)
	MOVB	#10., BULLET_STRUCT_ALTITUDE(R5)
	MOV	ROBOT_STRUCT_X(R4), R3
	CLR	R0
	BISB	ROBOT_STRUCT_Y(R4), R0
	MOV	R0, R4
	BR	Lb724_bullet_update_internal

; Lb70d: the update of the bullet R5 (every cycle): the range, the step, the hit
Lb70d_bullet_update:
	MOV	BULLET_STRUCT_MAP_PTR(R5), R3
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)	; the bullet is off the map
	DECB	BULLET_STRUCT_RANGE(R5)
	BEQ	Lb7ea_bullet_disappear
	MOV	BULLET_STRUCT_X(R5), R3
	CLR	R4
	BISB	BULLET_STRUCT_Y(R5), R4
; R3 = x, R4 = y, R5 = the bullet: 2 cells in its direction
Lb724_bullet_update_internal:
	CLR	R0
	BISB	BULLET_STRUCT_DIRECTION(R5), R0
	BIT	#1, R0
	BEQ	10$
	ADD	#2, R3				; right
	BR	50$
10$:	BIT	#2, R0
	BEQ	20$
	SUB	#2, R3				; left
	BR	50$
20$:	BIT	#4, R0
	BEQ	30$
	ADD	#2, R4				; down
	BR	40$
30$:	BIT	#10, R0
	BEQ	50$
	SUB	#2, R4				; up
40$:	CMP	R4, #MAP_WIDTH
	BHIS	Lb7ea_bullet_disappear		; out of the map in y (in x there are always obstacles at the ends)
50$:	MOV	R3, BULLET_STRUCT_X(R5)
	MOVB	R4, BULLET_STRUCT_Y(R5)
	CALL	Lb5d6_map_altitude_2x2
	CLR	R1
	BISB	BULLET_STRUCT_ALTITUDE(R5), R1
	CMP	R0, R1
	BHIS	Lb7ea_bullet_disappear		; the ground is as high as the bullet
	MOV	R4, R0
	CALL	Lcca6_compute_map_ptr
	MOV	R3, BULLET_STRUCT_MAP_PTR(R5)
	MOV	#BLTOFS, R2			; the 3x3 cells around: an object (bit 6)?
	MOV	#9., R1
60$:	MOV	R3, R0
	ADD	(R2)+, R0
	CMP	R0, #MAP_SIZE
	BHIS	70$				; out of the map
	BITB	#MAPB_OCCUPIED, Ldd00_map(R0)
	BNE	Lb7a7_potentially_hit_a_robot
70$:	SOB	R1, 60$
	BISB	#MAPB_OCCUPIED, Ldd00_map(R3)	; the bullet is on the map again
	RETURN
BLTOFS:	.WORD	-<MAP_LENGTH+1>, -MAP_LENGTH, -<MAP_LENGTH-1>, -1, 0, 1, MAP_LENGTH-1, MAP_LENGTH, MAP_LENGTH+1

; Lb7a7: R0 = the cell with an object, R5 = the bullet: a living robot there loses (60 - (its height + altitude)) / 4
; * (1 + the type of the bullet) of the strength (cannon x2, missiles x3, phasers x4); <= 0: -4 (it blinks, then Lb0fa
; destroys it). The bullet disappears
Lb7a7_potentially_hit_a_robot:
	MOV	R5, -(SP)
	MOV	R0, R3
	CALL	Lcdd8_get_robot_at_ptr
	BNE	80$				; not a robot
	MOVB	ROBOT_STRUCT_STRENGTH(R5), R0
	BLE	80$				; already destroyed
	MOV	#60., R0
	CLR	R1
	BISB	ROBOT_STRUCT_HEIGHT(R5), R1
	SUB	R1, R0
	CLR	R1
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R1
	SUB	R1, R0
	BIC	#177400, R0
	ASR	R0
	ASR	R0				; the base damage
	MOV	R0, R2
	MOV	(SP), R1
	MOVB	BULLET_STRUCT_TYPE(R1), R1
90$:	ADD	R2, R0
	SOB	R1, 90$
	MOVB	ROBOT_STRUCT_STRENGTH(R5), R1
	SUB	R0, R1
	BGT	95$
	MOV	#-4, R1
95$:	MOVB	R1, ROBOT_STRUCT_STRENGTH(R5)
80$:	MOV	(SP)+, R5
; Lb7ea: the bullet disappears
Lb7ea_bullet_disappear:
	MOV	#NOSLOT, (R5)
	RETURN

; The update cycle of the robot R5, checking if it has to be destroyed
Lb0fa_robot_update:
	MOVB	ROBOT_STRUCT_STRENGTH(R5), R0
	BEQ	Lb116_robot_destroyed
	BPL	Lb154_robot_ai_update
; the strength is negative: the robot is destroyed, it only blinks
	INCB	ROBOT_STRUCT_STRENGTH(R5)
	MOV	ROBOT_STRUCT_MAP_PTR(R5), R3
	BIT	#1, R0
	BNE	10$
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)	; blink out
	RETURN
10$:	BISB	#MAPB_OCCUPIED, Ldd00_map(R3)	; blink in
	RETURN

; The robot is destroyed: the mark off the map, debris if nothing is left there, off the radar, the slot is free
Lb116_robot_destroyed:
	MOV	ROBOT_STRUCT_MAP_PTR(R5), R3
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)
	CLR	R0
	BISB	Ldd00_map(R3), R0	; the 2x2 cells of the robot
	BISB	Ldd00_map+1(R3), R0
	MOV	R3, R2
	SUB	#MAP_LENGTH, R2		; the row above
	BISB	Ldd00_map(R2), R0
	BISB	Ldd00_map+1(R2), R0
	BIC	#177700, R0
	BNE	10$			; there is something in the map
	MOV	R3, -(SP)
	CALL	Ld358_random
	MOV	(SP)+, R3
	BIC	#177776, R0
	ADD	#6, R0
	CALL	Lbd91_add_element_to_map	; some debris
10$:	CALL	Lrb_flip_radar		; the robot is off the radar
	MOV	#NOSLOT, (R5)		; the slot is free
	CALL	Lbb40_count_robots
	JMP	Lrb_hud

; The robot R5 acts when its counter of the cycles is 0
Lb154_robot_ai_update:
	CMPB	ROBOT_STRUCT_CONTROL(R5), #ROBOT_CONTROL_PLAYER_LANDED
	BNE	3$
	RETURN				; the player is on top of the robot
3$:	CLRB	Lfd51_robot_player_or_enemy
	TSTB	ROBOT_STRUCT_CONTROL(R5)
	BPL	10$
	INCB	Lfd51_robot_player_or_enemy	; the enemy AI
10$:	DECB	ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	BNE	Lb154_exit		; not yet
	MOV	ROBOT_STRUCT_MAP_PTR(R5), R3
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)	; its mark is off the map while it acts
	CALL	Lrb_flip_radar
	MOV	ROBOT_STRUCT_MAP_PTR(R5), R3
	CALL	Lb513_movement_possibilities
	CMPB	ROBOT_STRUCT_CONTROL(R5), #ROBOT_CONTROL_DIRECT_CONTROL
	BNE	5$
	JMP	Lb450_direct_control
5$:
	MOV	R4, -(SP)
	CALL	Lb626_check_enemy_robots	; R1 = the directions with an enemy robot in line
	MOV	(SP)+, R4
	TST	R1
	BEQ	Lb1e9_no_enemy_in_sight
	CLR	R0
	BISB	ROBOT_STRUCT_DIRECTION(R5), R0
	MOV	R1, R2
	COM	R2
	BIC	R2, R0				; the enemy is in the direction the robot faces?
	BEQ	Lb1d7_no_enemy_ahead
; an enemy ahead: the robot fires a random weapon of its own if it has a free bullet (Lb6b8, Lb6d6) and stands (the
; desired direction 0), else it goes on in the direction (Lb1cd)
	MOV	R4, R2
	COM	R2
	BIC	R2, R0				; and it is possible
	MOVB	R0, ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	MOV	R5, -(SP)
	MOV	R5, R4				; R4 = the robot that fires
	CALL	Lb6b8_find_new_bullet_ptr
	BNE	Lb1cd_do_not_fire
	CALL	Ld358_random
	MOVB	ROBOT_STRUCT_PIECES(R4), R1
	COM	R1
	BIC	R1, R0
	BIC	#^C70, R0			; the weapons it has (cannon 10, missiles 20, phasers 40)
	BEQ	Lb1cd_do_not_fire
	MOV	#3, R1				; Lb1b7: the highest weapon bit: 3 phasers, 2 missiles, 1 cannon
	BIT	#40, R0
	BNE	15$
	DEC	R1
	BIT	#20, R0
	BNE	15$
	DEC	R1
15$:	MOV	R1, R0
	CALL	Lb6d6_weapon_fire
	MOV	(SP)+, R5
	CLRB	ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	MOVB	#1, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	JMP	Lb20d_move_robot
Lb1cd_do_not_fire:
	MOV	(SP)+, R5
	MOVB	#1, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	JMP	Lb20d_move_robot
; Lb1d7: the enemy is in another direction: the robot turns towards it
Lb1d7_no_enemy_ahead:
	MOV	R1, R4				; c = the directions with an enemy
	MOV	R4, R3				; b
	CALL	Lb505_count_directions
	BEQ	10$
	CALL	Lb33e_pick_direction_at_random	; several: one of them
10$:	MOVB	R4, ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	MOVB	#2, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	JMP	Lb20d_move_robot
; Lb1e9: no enemy robots in sight
Lb1e9_no_enemy_in_sight:
; the steps are counted, the robot keeps walking in its desired direction while it can
	DECB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	BMI	Lb1f5_move_in_a_new_direction
	CLR	R0
	BISB	ROBOT_STRUCT_DESIRED_DIRECTION(R5), R0
	BIT	R4, R0
	BEQ	Lb1f5_move_in_a_new_direction
	JMP	Lb20d_move_robot		; it can go on
; Lb1f5: a new direction for 3..6 steps (R4 = the possible directions)
Lb1f5_move_in_a_new_direction:
	CALL	Ld358_random
	BIC	#^C3, R0
	ADD	#3, R0
	MOVB	R0, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	CALL	Lb505_count_directions
	BCS	10$				; no possible direction
	CALL	Lb222_choose_direction_to_move
10$:	CMP	(R5), #NOSLOT
	BEQ	Lb154_exit			; the robot was destroyed by its orders (the nuclear bomb)
	MOVB	R4, ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	JMP	Lb20d_move_robot
Lb154_exit:
	RETURN

; Lb505: the number of the directions of R4 (the lower 4 bits): Z = one, C = none (the flags of CMP #1)
Lb505_count_directions:
	CLR	R0
	MOV	R4, R1
	BIC	#^C17, R1
10$:	ASR	R1
	ADC	R0
	TST	R1
	BNE	10$
	CMP	R0, #1
	RETURN

; ----- The search of the target of the orders (Lb34d..Lb450): the nearest robot of the opponent or the nearest free
; building of the wanted kind (only the x counts). The side of the robot that searches: Lfd51_robot_player_or_enemy
; (0: the player, 1: the enemy AI). The result is an index (a robot 0..23 of the table of the opponent, a factory
; 0..23, a warbase 0..3), 377 = none.
TGX:	.WORD	0			; the x of the robot that searches
TGBEST:	.WORD	0			; the distance to the nearest found
TGNEAR:	.WORD	0			; its index, 377 = none yet
TGORD:	.WORD	0			; the orders

; Lb411: R3 = the x of the reference robot: the search starts
Lb411_prepare_nearest_search:
	MOV	R3, TGX
	MOV	#8192., TGBEST
	MOV	#377, TGNEAR
	RETURN

; Lb3ca: R0 = |R3 - the x of the reference robot|
Lb3ca_distance:
	MOV	R3, R0
	SUB	TGX, R0
	BGE	10$
	NEG	R0
10$:	RETURN

; Lb3b3: R3 = the x of a candidate, R4 = its index: it is the nearest if it is nearer than the nearest so far
Lb3b3_check_if_nearer:
	CALL	Lb3ca_distance
	CMP	R0, TGBEST
	BHIS	10$
	MOV	R0, TGBEST
	MOV	R4, TGNEAR
10$:	RETURN

; Lb41d: R3 = the x of the robot that searches => R2 = the index of the nearest robot of the opponent (377 = none),
; Z = none. Clobbers R0, R1, R3, R4
Lb41d_find_nearest_robot:
	CALL	Lb411_prepare_nearest_search
	MOV	R5, -(SP)
	MOV	#Lda00_player1_robots, R5	; the enemy AI looks for the robots of the player,
	TSTB	Lfd51_robot_player_or_enemy
	BNE	10$
	MOV	#Ldb80_player2_robots, R5	; the player for the robots of the enemy
10$:	CLR	R4
	MOV	#MAX_ROBOTS_PER_PLAYER, R1
20$:	CMP	(R5), #NOSLOT
	BEQ	30$
	MOV	ROBOT_STRUCT_X(R5), R3
	CALL	Lb3b3_check_if_nearer
30$:	ADD	#ROBOT_STRUCT_SIZE, R5
	INC	R4
	SOB	R1, 20$
	MOV	(SP)+, R5
	CLR	R2
	BISB	TGNEAR, R2
	CMP	R2, #377
	RETURN

; Lb3f9: R5 = the robot that searches => R2 = the target robot (the row of the table of the opponent by the argument of
; the orders). Clobbers R0
Lb3f9_find_target_robot_ptr:
	MOV	#Lda00_player1_robots, R2	; the enemy AI looks for the robots of the player,
	TSTB	Lfd51_robot_player_or_enemy
	BNE	10$
	MOV	#Ldb80_player2_robots, R2	; the player for the robots of the enemy
10$:	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5), R0
	ASH	#4, R0				; * ROBOT_STRUCT_SIZE
	ADD	R0, R2
	RETURN

; Lb3d5: R0 = the orders => R5 = the first building to look at, R1 = their number, R2 = the flags of the wanted
; buildings in the type byte: 040 enemy of the player (bit 5), 0100 of the player (bit 6) as seen by the robot that
; searches, 0 neutral
Lb3d5_prepare_building_search:
	MOV	#Lfd84_factories, R5
	MOV	#N_FACTORIES, R1
	CMP	R0, #ORDERS_DESTROY_ENEMY_WARBASES
	BEQ	10$
	CMP	R0, #ORDERS_CAPTURE_ENEMY_WARBASES
	BNE	20$
10$:	MOV	#Lfd70_warbases, R5
	MOV	#N_WARBASES, R1
20$:	MOV	#40, R2
	TSTB	Lfd51_robot_player_or_enemy
	BEQ	30$
	ASL	R2
30$:	CMP	R0, #ORDERS_CAPTURE_NEUTRAL_FACTORIES
	BNE	40$
	CLR	R2
40$:	RETURN

; Lb36c: the building R5 with the index R4: if no other robot of the same side with the same orders has it as its
; target, it is checked if it is the nearest. Preserves R1, R2, R4, R5
Lb36c_check_building:
	MOV	R1, -(SP)
	MOV	#Lda00_player1_robots, R3
	TSTB	Lfd51_robot_player_or_enemy
	BEQ	10$
	MOV	#Ldb80_player2_robots, R3
10$:	MOV	#MAX_ROBOTS_PER_PLAYER, R1
20$:	CMP	(R3), #NOSLOT
	BEQ	30$
	MOVB	ROBOT_STRUCT_ORDERS(R3), R0
	CMP	R0, TGORD
	BNE	30$			; other orders
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS_ARGUMENT(R3), R0
	CMP	R0, R4
	BEQ	40$			; another robot has the building as its target already
30$:	ADD	#ROBOT_STRUCT_SIZE, R3
	SOB	R1, 20$
	MOV	(SP)+, R1
	MOV	BUILDING_STRUCT_X(R5), R3
	BR	Lb3b3_check_if_nearer
40$:	MOV	(SP)+, R1
	RETURN

; Lb34d: the target of the orders R0 (3..8) for the robot at the x R3 => R2 = the index (377 = none), Z = none.
; Preserves R5
Lb34d_find_target:
	CMP	R0, #ORDERS_DESTROY_ENEMY_ROBOTS
	BEQ	Lb41d_find_nearest_robot
	MOV	R0, TGORD
	MOV	R5, -(SP)
	CALL	Lb411_prepare_nearest_search
	CALL	Lb3d5_prepare_building_search
	CLR	R4
10$:	MOVB	BUILDING_STRUCT_TYPE(R5), R0
	BIC	#^C340, R0			; the flags: bit 7 destroyed, 6 player, 5 enemy
	CMP	R0, R2
	BNE	20$				; not of the wanted kind
	CALL	Lb36c_check_building
20$:	ADD	#BUILDING_STRUCT_SIZE, R5
	INC	R4
	SOB	R1, 10$
	MOV	(SP)+, R5
	CLR	R2
	BISB	TGNEAR, R2
	CMP	R2, #377
	RETURN

.IF DF TESTTGT
; The test of the search of the target (build -s "TESTTGT=1" -s "NOMENU=1"): a new game, 2 robots of the enemy (the
; table index 2 at x = 100 and 5 at x = 40), 4 robots of the player at x = 24 with the orders 3 (destroy robots),
; 6 (capture neutral factories), 8 (capture enemy warbases), 4 (destroy enemy factories), 6 again (another factory):
; the robots get the targets
TGTORD:	.BYTE	3, 6, 8., 4, 6, 0
TGTN:	.WORD	0
TGTP:	.WORD	0
TGTR:	.WORD	0
TGTY:	.WORD	0
; R5 = the robot, R3 = x, R4 = y, R0 = the control: the robot stands there (pieces bipod + cannon)
TGMK:	MOV	R5, -(SP)
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	R0, ROBOT_STRUCT_CONTROL(R5)
	CALL	Lcc7c_set_robot_position
	MOV	(SP)+, R5
	RETURN
TESTTG:	CALL	Lnew_game
	MOV	#100., R3
	MOV	#8., R4
	MOV	#<Ldb80_player2_robots+<2*ROBOT_STRUCT_SIZE>>, R5
	MOV	#200, R0
	CALL	TGMK
	MOV	#40., R3
	MOV	#12., R4
	MOV	#<Ldb80_player2_robots+<5*ROBOT_STRUCT_SIZE>>, R5
	MOV	#200, R0
	CALL	TGMK
	MOV	#5, TGTN
	MOV	#TGTORD, TGTP
	MOV	#Lda00_player1_robots, TGTR
	MOV	#6, TGTY
10$:	MOV	TGTR, R5
	MOV	#24., R3
	MOV	TGTY, R4
	CLR	R0
	CALL	TGMK
	MOV	TGTP, R1
	MOVB	(R1)+, R0
	MOV	R1, TGTP
	MOVB	R0, ROBOT_STRUCT_ORDERS(R5)
	CLRB	Lfd51_robot_player_or_enemy
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	MOV	R5, -(SP)
	MOV	ROBOT_STRUCT_X(R5), R3
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	CALL	Lb34d_find_target
	MOV	(SP)+, R5
	MOVB	R2, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	ADD	#ROBOT_STRUCT_SIZE, TGTR
	ADD	#2, TGTY
	DEC	TGTN
	BNE	10$
	RETURN
.ENDC

.IF DF TESTRAY
; The test of the rays (build -s "TESTRAY=1" -s "NOMENU=1"): 3 robots of the player look, 3 of the enemy are in line: the
; robot 0 at (24, 6) faces right, an enemy at (30, 7) is on the row below: right = 1; the robot 1 at (24, 10) faces left,
; an enemy at (24, 13) is below in the column (a simple ray, 4 cells): down = 4; the robot 2 at (36, 12) faces down,
; an enemy at (37, 15) is in the column on the right: down = 4. The results go to the arguments of the robots.
TESTRY:	CALL	Lnew_game
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOV	#30., R3
	MOV	#7, R4
	MOV	#200, R0
	MOV	#4, R1
	CALL	TRMK
	MOV	#<Ldb80_player2_robots+<2*ROBOT_STRUCT_SIZE>>, R5
	MOV	#24., R3
	MOV	#13., R4
	MOV	#200, R0
	MOV	#4, R1
	CALL	TRMK
	MOV	#<Ldb80_player2_robots+<3*ROBOT_STRUCT_SIZE>>, R5
	MOV	#37., R3
	MOV	#15., R4
	MOV	#200, R0
	MOV	#4, R1
	CALL	TRMK
	MOV	#Lda00_player1_robots, R5
	MOV	#24., R3
	MOV	#6, R4
	CLR	R0
	MOV	#1, R1
	CALL	TRMK
	MOV	#<Lda00_player1_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOV	#24., R3
	MOV	#10., R4
	CLR	R0
	MOV	#2, R1
	CALL	TRMK
	MOV	#<Lda00_player1_robots+<2*ROBOT_STRUCT_SIZE>>, R5
	MOV	#36., R3
	MOV	#12., R4
	CLR	R0
	MOV	#4, R1
	CALL	TRMK
	MOV	#3, R2
	MOV	#Lda00_player1_robots, R5
10$:	MOV	R2, -(SP)
	MOV	R5, -(SP)
	CALL	Lb626_check_enemy_robots
	MOV	(SP)+, R5
	MOVB	R1, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	MOV	(SP)+, R2
	ADD	#ROBOT_STRUCT_SIZE, R5
	SOB	R2, 10$
	RETURN
; a robot: R5, R3 = x, R4 = y, R0 = the control, R1 = the direction
TRMK:	MOV	R5, -(SP)
	MOVB	R1, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	R0, ROBOT_STRUCT_CONTROL(R5)
	CALL	Lcc7c_set_robot_position
	MOV	(SP)+, R5
	RETURN
.ENDC

.IF DF TESTFIRE
; The test of the shot (build -s "TESTFIRE=1" -s "NOMENU=1"; add "TESTFIREM=1" for the missiles, "TESTFIREP=1" for the
; phasers, "TESTFIRER=1" for an enemy out of the range): a robot of the player at (45, 8) faces right and fires, an
; enemy robot (height 12, altitude 0, strength 100) stands at (51, 8). The bullet goes 2 cells per cycle and hits on the
; second update: the cannon takes 24, the missiles 36, the phasers 48 (60 - 12) / 4 = 12 * (1 + the type). Both robots
; stand (their counters are large). The enemy is out of the range at x = 57: nothing is hit, the bullet is free.
FIREW = 1
.IF DF TESTFIREM
FIREW = 2
.ENDC
.IF DF TESTFIREP
FIREW = 3
.ENDC
TESTFI:	CALL	Lnew_game
	MOV	#<Ldb80_player2_robots+<1*ROBOT_STRUCT_SIZE>>, R5
	MOV	#51., R3
.IF DF TESTFIRER
	MOV	#57., R3
.ENDC
	MOV	#8., R4
	MOV	#200, R0
	MOV	#4, R1
	CALL	TFMK
	MOV	#Lda00_player1_robots, R5
	MOV	#45., R3
	MOV	#8., R4
	CLR	R0
	MOV	#1, R1
	CALL	TFMK
	MOV	#Lda00_player1_robots, R4
	CALL	Lb6b8_find_new_bullet_ptr
	MOV	#FIREW, R0
	JMP	Lb6d6_weapon_fire
; a robot: R5, R3 = x, R4 = y, R0 = the control, R1 = the direction
TFMK:	MOV	R5, -(SP)
	MOVB	R1, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#12., ROBOT_STRUCT_HEIGHT(R5)
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	MOVB	#377, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	R0, ROBOT_STRUCT_CONTROL(R5)
	CALL	Lcc7c_set_robot_position
	MOV	(SP)+, R5
	RETURN
.ENDC

; Lb222: the direction for the orders of the robot R5; R4 = the possible directions => R4 = the chosen one
Lb222_choose_direction_to_move:
	MOV	R4, R3				; b = the possible directions
	MOVB	ROBOT_STRUCT_ORDERS(R5), R0
	BEQ	10$				; STOP AND DEFEND: no direction
	CMP	R0, #ORDERS_DESTROY_ENEMY_ROBOTS
	BLO	Lb326_choose_by_orders
	BEQ	6$
	JMP	Lb289_choose_direction_buildings
; DESTROY ENEMY ROBOTS: the target robot
6$:
	TSTB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	BMI	Lb258_find_new_robot_target	; no target yet
	CALL	Lb3f9_find_target_robot_ptr
	CMP	(R2), #NOSLOT
	BEQ	Lb258_find_new_robot_target	; the target is destroyed
	MOV	ROBOT_STRUCT_X(R5), R0
	SUB	ROBOT_STRUCT_X(R2), R0
	BGE	5$
	NEG	R0
5$:	CMP	R0, #50.
	BHIS	Lb258_find_new_robot_target	; the target is too far
	BR	Lb26d_choose_direction_to_target
10$:	CLR	R4
	RETURN

; Lb258: the nearest robot of the opponent becomes the target (none: a random direction)
Lb258_find_new_robot_target:
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	MOV	R3, -(SP)
	MOV	R4, -(SP)
	MOV	ROBOT_STRUCT_X(R5), R3
	CALL	Lb41d_find_nearest_robot
	MOV	(SP)+, R4
	MOV	(SP)+, R3
	MOVB	R2, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CMP	R2, #377
	BEQ	Lb33e_pick_direction_at_random
; Lb26d: the target robot: dy = y - the y of the target (R1), dx = x - the x of the target (R0)
Lb26d_choose_direction_to_target:
	CALL	Lb3f9_find_target_robot_ptr
	MOVB	ROBOT_STRUCT_Y(R5), R1
	MOVB	ROBOT_STRUCT_Y(R2), R0
	SUB	R0, R1
	MOV	ROBOT_STRUCT_X(R5), R0
	SUB	ROBOT_STRUCT_X(R2), R0
	CLR	R2				; d = the good directions (none yet)
	TST	R0
	BEQ	Lb2dc_x_considered	; the same x
; Lb2d5: R0 = dx, R1 = dy: the good directions in R2: the target is to the right: 1, to the left: 2
Lb2d5_choose_direction_xy:
	MOV	#2, R2
	TST	R0
	BGE	Lb2dc_x_considered
	MOV	#1, R2
Lb2dc_x_considered:
	TST	R1
	BEQ	Lb2e8_directions_done
	BLT	10$
	BIS	#10, R2				; the target is above (dy > 0)
	BR	Lb2e8_directions_done
10$:	BIS	#4, R2				; below
Lb2e8_directions_done:
	TST	R2
	BNE	Lb306_not_at_target
; at the target: the nuclear bomb for the orders 4 and 5 (Lb99f), else (Lb2f9) down until
; the first collision
	CLR	R4
	CMPB	ROBOT_STRUCT_ORDERS(R5), #ORDERS_DESTROY_ENEMY_FACTORIES
	BLO	Lb2f9_inconsistent_orders
	CMPB	ROBOT_STRUCT_ORDERS(R5), #ORDERS_CAPTURE_NEUTRAL_FACTORIES
	BHIS	Lb2f9_inconsistent_orders
	CALL	Lb99f_fire_nuclear_bomb		; on the target the nuclear bomb destroys a building and the robot
	CLR	R4
	RETURN
Lb2f9_inconsistent_orders:
	CMPB	ROBOT_STRUCT_DIRECTION(R5), #4
	BEQ	Lb2f9_exit			; it faces down: c = 0
	MOV	#4, R4				; down, until it collides
	MOVB	#377, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
Lb2f9_exit:
	RETURN

; Lb306: R0 = dx, R2 = the good directions, R4 = c, R3 = b: |dx| >= 8: follow the target (Lb326), else a random
; direction among the good and possible ones for |dx| - 1 steps
Lb306_not_at_target:
	MOVB	R0, R1				; l = the low byte of dx
	BPL	10$
	NEG	R1
10$:	MOV	R4, R3				; b = c
	CMP	R1, #8.
	BLO	20$
	MOV	R2, R0				; the good directions
	BR	Lb326_choose_by_orders
20$:	BIT	R4, R2
	BEQ	Lb33e_pick_direction_at_random	; no good direction is possible
	MOV	R2, R3
	MOV	R4, R0
	COM	R0
	BIC	R0, R3				; b = the good ones that are possible
	BIT	#3, R3
	BEQ	Lb33e_pick_direction_at_random	; it cannot go left/right
	TST	R1
	BEQ	Lb33e_pick_direction_at_random	; the same x
	DEC	R1
	MOVB	R1, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	BR	Lb33e_pick_direction_at_random

; Lb326: ADVANCE (1: right) / RETREAT (2: left): R0 = the orders, R3 = b = the possible directions, R4 = c
Lb326_choose_by_orders:
	MOV	R0, R1
	BIC	#^C3, R1			; d = the good directions
	MOV	#374, R2
	XOR	R1, R2				; e = the possible ones with the up/down reversed
	BIT	R1, R4
	BEQ	Lb33e_pick_direction_at_random	; no good direction is possible
	MOV	R1, R4
	CALL	Ld358_random			; two tries to pick a good one
	BIT	R1, R0
	BNE	Lb33e_done
	CALL	Ld358_random
	BIT	R1, R0
	BNE	Lb33e_done
	MOV	R2, R0
	COM	R0
	BIC	R0, R3				; b = b and e
Lb33e_pick_direction_at_random:
	MOV	R3, R4				; c = b
10$:	CALL	Ld358_random
	MOV	R4, R1
	COM	R1
	BIC	R1, R0
	MOV	R0, R4				; c = c and the random number
	CALL	Lb505_count_directions
	BEQ	Lb33e_done			; exactly one
	BCC	10$				; more than one: again
	MOV	R3, R4				; none: from the possible ones again
	BR	10$
Lb33e_done:
	RETURN

; Lb2b0: R0 = the index of a building of the kind wanted by the orders of the robot R5 => R1 = its structure, R2 = the flags
; of the wanted buildings (Lb3d5). Clobbers R0
Lb2b0_building_ptr:
	MOV	R0, -(SP)
	MOVB	ROBOT_STRUCT_ORDERS(R5), R0
	MOV	R5, -(SP)
	CALL	Lb3d5_prepare_building_search
	MOV	R5, R1
	MOV	(SP)+, R5
	MOV	(SP)+, R0
	ASL	R0
	ADD	R0, R1
	ASL	R0
	ADD	R0, R1				; + 6 * the index (BUILDING_STRUCT_SIZE)
	RETURN

; Lb289: the orders to capture / destroy a building: the target is the building of the argument of the orders if it is
; still of the wanted kind, else a new one is searched (Lb34d); none: c = 0 and an enemy AI robot goes for the robots.
; (In the original after the search the coordinates are taken from a pointer that is not the target at that moment;
; here from the target.)
Lb289_choose_direction_buildings:
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5), R0
	CMP	R0, #377
	BEQ	10$				; no target yet
	CALL	Lb2b0_building_ptr
	MOVB	BUILDING_STRUCT_TYPE(R1), R0
	BIC	#^C340, R0
	CMP	R0, R2
	BEQ	Lb2bb_to_building
10$:	MOV	R3, -(SP)			; a new target
	MOV	R4, -(SP)
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	MOV	ROBOT_STRUCT_X(R5), R3
	CALL	Lb34d_find_target
	MOV	(SP)+, R4
	MOV	(SP)+, R3
	CMP	R2, #377
	BNE	20$				; Lb2b8: the target is found
	CLR	R4				; no target
	TSTB	ROBOT_STRUCT_CONTROL(R5)
	BPL	90$
	MOVB	#ORDERS_DESTROY_ENEMY_ROBOTS, ROBOT_STRUCT_ORDERS(R5)	; the enemy AI goes for the robots
90$:	RETURN
20$:	MOVB	R2, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	MOV	R2, R0
	CALL	Lb2b0_building_ptr
; Lb2bb: the building R1: dx = x - its x (R0), dy = y - its y (R1); if the x differs, the target is 3 rows below it
Lb2bb_to_building:
	MOV	R1, R2
	MOVB	ROBOT_STRUCT_Y(R5), R1
	MOVB	BUILDING_STRUCT_Y(R2), R0
	SUB	R0, R1
	MOV	ROBOT_STRUCT_X(R5), R0
	SUB	BUILDING_STRUCT_X(R2), R0
	CLR	R2
	TST	R0
	BNE	30$
	JMP	Lb2dc_x_considered
30$:	SUB	#3, R1
	JMP	Lb2d5_choose_direction_xy

; ----- The movement of the robots (Lb513..Lb5f3, Lb471..Lb4f2, Lb20d). The map offsets: a step in y is MAP_LENGTH.
; The flags of the collision checks: Z = free, NZ = a collision (as in the original).

; The element at the offset R3 is walkable for the chassis (the type < R1) and has no object of the mask R2
Lb5cd_map_collision:
	MOVB	Ldd00_map(R3), R0
	BIC	#177740, R0
	CMP	R0, R1
	BHIS	Lb5ca_collision		; the element is not walkable for this chassis
	BITB	R2, Ldd00_map(R3)
	RETURN
Lb5c8_no_collision:
	CLR	R0
	RETURN
Lb5ca_collision:
	MOV	#1, R0
	RETURN

; Can the robot walk to the right (R3 = the map offset of the robot, R1 = the highest element of the chassis,
; R2 = the mask of the objects that block)
Lb557_robot_collision_inc_x:
	ADD	#<2-MAP_LENGTH>, R3		; x += 2, y -= 1
	CALL	Lb5cd_map_collision
	BNE	90$
	ADD	#MAP_LENGTH, R3
	CALL	Lb5cd_map_collision
	BNE	90$
	ADD	#MAP_LENGTH, R3
	CMP	R3, #MAP_SIZE
	BHIS	Lb5c8_no_collision		; out of the map
	BITB	R2, Ldd00_map(R3)
90$:	RETURN

Lb56f_robot_collision_dec_x:
	SUB	#<MAP_LENGTH+1>, R3		; y -= 1, x -= 1
	CALL	Lb5cd_map_collision
	BNE	90$
	DEC	R3
	BITB	R2, Ldd00_map(R3)
	BNE	90$
	ADD	#MAP_LENGTH, R3
	BITB	R2, Ldd00_map(R3)
	BNE	90$
	INC	R3
	CALL	Lb5cd_map_collision
	BNE	90$
	ADD	#<MAP_LENGTH-1>, R3
	CMP	R3, #MAP_SIZE
	BHIS	Lb5c8_no_collision
	BITB	R2, Ldd00_map(R3)
90$:	RETURN

Lb58f_robot_collision_inc_y:
	ADD	#MAP_LENGTH, R3
	CMP	R3, #MAP_SIZE
	BHIS	Lb5ca_collision			; out of the map
	CALL	Lb5cd_map_collision
	BNE	90$
	INC	R3
	CALL	Lb5cd_map_collision
	BNE	90$
	ADD	#MAP_LENGTH, R3
	CMP	R3, #MAP_SIZE
	BHIS	Lb5c8_no_collision
	BITB	R2, Ldd00_map(R3)
	BNE	90$
	DEC	R3
	BITB	R2, Ldd00_map(R3)
	BNE	90$
	DEC	R3
	BITB	R2, Ldd00_map(R3)
90$:	RETURN

Lb5b1_robot_collision_dec_y:
	SUB	#<2*MAP_LENGTH>, R3		; y -= 2
	BLT	Lb5ca_collision			; out of the map
	DEC	R3
	BITB	R2, Ldd00_map(R3)
	BNE	90$
	INC	R3
	CALL	Lb5cd_map_collision
	BNE	90$
	INC	R3
	BR	Lb5cd_map_collision
90$:	RETURN

; Lb513: the directions the robot R5 can move in: R3 = its map offset => R4 = 1 right, 2 left, 4 down, 10 up.
; The player blocks if he is lower than the robot (bit 7), other robots always (bit 6)
Lb513_movement_possibilities:
	CLR	R4
	CLR	R0
	BISB	Lfd10_player_altitude, R0
	CLR	R1
	BISB	ROBOT_STRUCT_HEIGHT(R5), R1
	SUB	R1, R0
	CLR	R1
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R1
	SUB	R1, R0
	BIC	#^C200, R0			; the player is lower than the robot
	BIS	#100, R0
	MOV	R0, R2				; the mask of the objects
	MOV	#8., R1				; the bipod
	BITB	#1, ROBOT_STRUCT_PIECES(R5)
	BNE	10$
	MOV	#12., R1			; the tracks
	BITB	#2, ROBOT_STRUCT_PIECES(R5)
	BNE	10$
	MOV	#15., R1			; the anti-grav
10$:	MOV	R3, -(SP)
	CALL	Lb557_robot_collision_inc_x
	BNE	11$
	BIS	#1, R4				; right
11$:	MOV	(SP)+, R3
	MOV	R3, -(SP)
	CALL	Lb56f_robot_collision_dec_x
	BNE	21$
	BIS	#2, R4				; left
21$:	MOV	(SP)+, R3
	MOV	R3, -(SP)
	CALL	Lb58f_robot_collision_inc_y
	BNE	31$
	BIS	#4, R4				; down
31$:	MOV	(SP)+, R3
	MOV	R3, -(SP)
	CALL	Lb5b1_robot_collision_dec_y
	BNE	41$
	BIS	#10, R4				; up
41$:	MOV	(SP)+, R3
	RETURN

; Lb5d6: the highest altitude of the 2x2 cells: R3 = x, R4 = y => R0. Preserves R3, R4
Lb5d6_map_altitude_2x2:
	MOV	R3, -(SP)
	MOV	R4, -(SP)
	MOV	R4, R0
	CALL	Lcca6_compute_map_ptr
	MOV	R3, R2
	CLR	R1
	CALL	Lb08a_get_map_altitude
	INC	R2
	CALL	Lb08a_get_map_altitude
	SUB	#MAP_LENGTH, R2
	CALL	Lb08a_get_map_altitude
	DEC	R2
	CALL	Lb08a_get_map_altitude
	MOV	R1, R0
	MOV	(SP)+, R4
	MOV	(SP)+, R3
	RETURN

; Lb5f3: the cycles of the robot R5 up to its next step, by the terrain (its altitude) and the chassis
Lb5f3_speed_by_terrain:
	CLR	R0
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R0
	CLR	R1				; flat
	TST	R0
	BEQ	10$
	MOV	#3, R1				; rugged
	CMP	R0, #4
	BLO	10$
	MOV	#6, R1				; mountains
10$:	MOVB	ROBOT_STRUCT_PIECES(R5), R0
	CLR	R2
20$:	ASR	R0				; the first set bit: the chassis
	BCS	30$
	INC	R2
	BR	20$
30$:	ADD	R2, R1
	MOVB	Lb61d_robot_movement_speed_table(R1), ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	RETURN
; bipod, tracks, anti-grav: flat, rugged, mountains
Lb61d_robot_movement_speed_table:
	.BYTE	6, 4, 3
	.BYTE	8., 6, 3
	.BYTE	9., 7, 4
	.EVEN

; Lb450: the robot R5 controlled by the player (R4 = the possible directions): the keys give the direction; if the robot
; is already facing it, only the possible ones count (a turn needs no free way); with several keys the robot keeps
; its desired direction while it is possible. The keys are filtered and left for the ship of the player (Laf11)
Lb450_direct_control:
	MOV	R4, R3				; b = the possible directions
	CALL	Ld37c_read_keyboard_input	; R0 = the keys
	CLR	R1
	BISB	ROBOT_STRUCT_DIRECTION(R5), R1
	CMP	R0, R1
	BNE	10$				; another direction: it turns, the collisions do not matter
	MOV	R4, R1
	COM	R1
	BIC	R1, R0				; the possible keys
10$:	MOV	R0, R4				; c = the directions we want
	CALL	Lb505_count_directions
	BEQ	20$				; only one
	CLR	R0
	BISB	ROBOT_STRUCT_DESIRED_DIRECTION(R5), R0
	MOV	R3, R1
	COM	R1
	BIC	R1, R0				; keep going if it is possible, else stop
	MOV	R0, R4
20$:	MOVB	R4, ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	MOV	R4, Lfd0c_keyboard_state	; the ship of the player follows the robot
	BR	Lb20d_move_robot

; Lb4de: the robot moved against the direction of its orders: the distance grows (not for the direct control)
Lb4de_advance_against_orders:
	CMPB	ROBOT_STRUCT_CONTROL(R5), #ROBOT_CONTROL_DIRECT_CONTROL
	BEQ	90$
	INCB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CMPB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5), #100.
	BLO	90$
	MOVB	#99., ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; not more than 99
90$:	RETURN

; Lb4f2: the robot moved in the direction of its orders: the distance shrinks, at 0 it stops and defends
Lb4f2_advance_with_orders:
	CMPB	ROBOT_STRUCT_CONTROL(R5), #ROBOT_CONTROL_DIRECT_CONTROL
	BEQ	90$
	DECB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	BNE	90$
	CLRB	ROBOT_STRUCT_ORDERS(R5)		; STOP AND DEFEND
	CLRB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
90$:	RETURN

; Lb4b9: the step of the robot R5 in the direction R0 (one-hot): R3 = x, R4 = y change
Lb4b9_robot_advance:
	ASR	R0
	BCC	Lb4c7_not_right
	INC	R3				; right
	MOVB	ROBOT_STRUCT_ORDERS(R5), R0
	DEC	R0
	BEQ	Lb4f2_advance_with_orders
	DEC	R0
	BEQ	Lb4de_advance_against_orders
	RETURN
Lb4c7_not_right:
	ASR	R0
	BCC	Lb4d5_not_left
	DEC	R3				; left
	MOVB	ROBOT_STRUCT_ORDERS(R5), R0
	DEC	R0
	BEQ	Lb4de_advance_against_orders
	DEC	R0
	BEQ	Lb4f2_advance_with_orders
	RETURN
Lb4d5_not_left:
	ASR	R0
	BCC	Lb4da_not_down
	INC	R4				; down
	RETURN
Lb4da_not_down:
	ASR	R0
	BCC	90$
	DEC	R4				; up
90$:	RETURN

; Lb471: R0 = the desired direction (one-hot) of the robot R5, R3 = x, R4 = y. If it faces another way, it turns
; (90 degrees at a time, a step of turning is not a step of walking), else it makes the step
Lb471_move_robot_one_step:
	TST	R0
	BEQ	90$				; it does not want to move
	CLR	R1
	BISB	ROBOT_STRUCT_DIRECTION(R5), R1
	CMP	R0, R1
	BEQ	Lb495_step
	MOV	R0, R2				; the new direction
	BIS	R0, R1
	CMP	R1, #3
	BNE	10$
	ASL	R2				; right/left: the turn by 180 degrees is a turn by 90
	ASL	R2
	BR	20$
10$:	CMP	R1, #14
	BNE	20$
	ASR	R2				; down/up
	ASR	R2
20$:	MOVB	R2, ROBOT_STRUCT_DIRECTION(R5)
	INCB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
90$:	RETURN
Lb495_step:
	CALL	Lb4b9_robot_advance
	CALL	Lb5d6_map_altitude_2x2
	MOVB	R0, ROBOT_STRUCT_ALTITUDE(R5)
	CMPB	ROBOT_STRUCT_CONTROL(R5), #ROBOT_CONTROL_DIRECT_CONTROL
	BNE	90$
	MOV	R3, -(SP)			; the direct control: the player ship moves like the robot
	MOV	R4, -(SP)
	MOV	R5, -(SP)
	CALL	Laf11_player_ship_control
	MOV	(SP)+, R5
	MOV	(SP)+, R4
	MOV	(SP)+, R3
	CLR	R0
	BISB	ROBOT_STRUCT_HEIGHT(R5), R0
	CLR	R1
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R1
	ADD	R1, R0
	MOVB	R0, Lfd10_player_altitude	; the player is on top of the robot
90$:	RETURN

; Lb20d: the robot R5 moves (turns) in its desired direction, its speed, its place on the map and on the radar
Lb20d_move_robot:
	CLR	R0
	BISB	ROBOT_STRUCT_DESIRED_DIRECTION(R5), R0
	MOV	ROBOT_STRUCT_X(R5), R3
	CLR	R4
	BISB	ROBOT_STRUCT_Y(R5), R4
	CALL	Lb471_move_robot_one_step
	CALL	Lb5f3_speed_by_terrain
	JMP	Lcc7c_set_robot_position

;------------------------------------------------------------------------------
; Lb7f4: the AI of the enemy (every cycle, first in Lb0ca). With the probability 1/4 nothing. A random robot of the
; enemy (0..23): if the slot is free the enemy tries to build a robot in a random warbase of its own (TODO: the
; control of the robot that exists: Lb920).
AIX:	.WORD	0			; the position of the warbase
AIY:	.WORD	0
AIB:	.WORD	0			; the warbases left
.IF DF TESTAIO
AIOI:	.WORD	0
AIOCNT:	.BLKW	9.
.ENDC
AID:	.WORD	0			; the general resources needed by the robot
AIRES:	.BLKB	8.			; the working copy of the resources of the enemy
AIHGT:	.BYTE	11., 7, 8., 6, 6, 7, 7, 7	; the heights of the pieces (Ld7b4)
Lb7f4_update_enemy_ai:
	CALL	Ld358_random
	BIC	#^C37, R0
	CMP	R0, #MAX_ROBOTS_PER_PLAYER
	BHIS	90$				; 1/4: nothing
	ASH	#4, R0				; * ROBOT_STRUCT_SIZE
	ADD	#Ldb80_player2_robots, R0
	MOV	R0, R5				; a random robot of the enemy
	MOVB	#1, Lfd51_robot_player_or_enemy
	CMP	(R5), #NOSLOT
	BEQ	5$
	JMP	Lb920_enemy_ai_control_robot	; the slot is used: the control of the robot
5$:
	MOV	#Lfd70_warbases, R4
	MOV	#N_WARBASES, AIB
10$:	CALL	Ld358_random
	BIT	#1, R0
	BEQ	20$
	CMPB	BUILDING_STRUCT_TYPE(R4), #40
	BEQ	Lb0ca_enemy_ai_control_warbase	; a warbase of the enemy that is not destroyed
20$:	ADD	#BUILDING_STRUCT_SIZE, R4
	DEC	AIB
	BNE	10$
90$:	RETURN

; The enemy builds a robot in the warbase R4 in the free slot R5: the entrance must be free, the pieces are random: one
; chassis, 1..3 weapons (not none, not all 4) and at least (the robots of the enemy / 8 + 1) & 3 of them (as in the
; original, where the comment says "at most"), the resources must be enough: the shortage goes to the general ones, of
; which at most a half (but 11 at least) can be spent.
Lb0ca_enemy_ai_control_warbase:
	MOV	BUILDING_STRUCT_X(R4), R3
	MOV	R3, AIX
	CLR	R0
	BISB	BUILDING_STRUCT_Y(R4), R0
	MOV	R0, AIY
	CALL	Lcca6_compute_map_ptr
	MOVB	Ldd00_map(R3), R0		; the entrance: 4 cells
	BISB	Ldd00_map+MAP_LENGTH(R3), R0
	BISB	Ldd00_map+MAP_LENGTH-1(R3), R0
	BISB	Ldd00_map+MAP_LENGTH+1(R3), R0
	BIT	#MAPB_OCCUPIED, R0
	BNE	17$			; blocked
	CALL	Ld358_random			; (twice in the original, too)
	CALL	Ld358_random
	MOV	R0, R2				; c
	MOVB	R2, ROBOT_STRUCT_PIECES(R5)
	BIC	#^C7, R0
	CMP	R0, #1
	BEQ	10$
	CMP	R0, #2
	BEQ	10$
	CMP	R0, #4
	BNE	17$			; not exactly one chassis
10$:	MOV	R2, R0
	ASH	#-3, R0
	BIC	#^C17, R0			; the weapons
	BEQ	17$
	CMP	R0, #17
	BEQ	17$			; none or all 4
	MOV	R0, R4
	CLR	R1
	BISB	Lfd49_player2_robot_count, R1
	ASH	#-3, R1
	INC	R1
	BIC	#^C3, R1			; b
	MOV	R1, -(SP)
	CALL	Lb505_count_directions		; R0 = the number of the weapons
	MOV	(SP)+, R1
	CMP	R0, R1
	BHIS	18$
17$:	RETURN
18$:
	MOV	#Lfd4a_player2_resource_counts, R0	; the resources of the enemy: a working copy
	MOV	#AIRES, R1
	MOV	#4, R3
20$:	MOV	(R0)+, (R1)+
	SOB	R3, 20$
	CLR	AID
	CLR	R2
	BISB	ROBOT_STRUCT_PIECES(R5), R2
	CLR	R3				; the piece
30$:	ASR	R2
	BCC	40$
	CLR	R0
	BISB	CSCOST(R3), R0
	CLR	R1
	BISB	CSTYPE(R3), R1
	MOVB	AIRES(R1), R4
	SUB	R0, R4
	BGE	35$
	NEG	R4				; the shortage: general resources
	ADD	R4, AID
	CLR	R4
35$:	MOVB	R4, AIRES(R1)
40$:	INC	R3
	CMP	R3, #8.
	BNE	30$
	CLR	R0
	BISB	AIRES, R0
	ASR	R0
	CMP	R0, #11.
	BHIS	50$
	MOV	#11., R0
50$:	CMP	R0, AID
	BLO	Lb7f4_ret			; too many general resources
	CLR	R0
	BISB	AIRES, R0
	SUB	AID, R0
	BLT	Lb7f4_ret			; not enough
	MOVB	R0, AIRES
	MOV	#AIRES, R0			; the price is paid
	MOV	#Lfd4a_player2_resource_counts, R1
	MOV	#4, R3
60$:	MOV	(R0)+, (R1)+
	SOB	R3, 60$
; the robot starts: down from the entrance, STOP AND DEFEND
	MOVB	#ROBOT_CONTROL_ENEMY_AI, ROBOT_STRUCT_CONTROL(R5)
	MOV	AIX, R3
	MOV	AIY, R4
	CALL	Lcc7c_set_robot_position
	MOVB	#4, ROBOT_STRUCT_DESIRED_DIRECTION(R5)
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#3, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	CLRB	ROBOT_STRUCT_ORDERS(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CLR	R2				; the height: the sum of the heights of the pieces
	BISB	ROBOT_STRUCT_PIECES(R5), R2
	CLR	R3
	CLR	R1
70$:	ASR	R2
	BCC	80$
	CLR	R0
	BISB	AIHGT(R1), R0
	ADD	R0, R3
80$:	INC	R1
	CMP	R1, #8.
	BNE	70$
	MOVB	R3, ROBOT_STRUCT_HEIGHT(R5)
	CALL	Lbb40_count_robots
	JMP	Lrb_hud
Lb7f4_ret:
	RETURN

;------------------------------------------------------------------------------
; Lb920: the enemy AI controls the robot R5. STOP AND DEFEND: new orders. Else 31 of 32 times nothing; orders that are not
; against buildings (< 4): new orders; against a building: new orders if the flags of the target are the wanted ones
; (in the original `jr z`, probably meant `nz`: kept as in the original), or the robot is not on the target; the robot
; on the target keeps its orders.
Lb920_enemy_ai_control_robot:
	CLR	R1
	BISB	ROBOT_STRUCT_ORDERS(R5), R1
	BEQ	Lb95d_assign_new_orders
	CALL	Ld358_random
	BIT	#37, R0
	BNE	90$				; 31/32: the orders are kept
	CMP	R1, #ORDERS_DESTROY_ENEMY_FACTORIES
	BLO	Lb95d_assign_new_orders
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5), R0
	CALL	Lb2b0_building_ptr		; R1 = the target building, R2 = the flags wanted
	MOVB	BUILDING_STRUCT_TYPE(R1), R0
	BIC	#^C340, R0
	CMP	R0, R2
	BEQ	Lb95d_assign_new_orders
	CMPB	ROBOT_STRUCT_Y(R5), BUILDING_STRUCT_Y(R1)
	BNE	Lb95d_assign_new_orders
	CMP	ROBOT_STRUCT_X(R5), BUILDING_STRUCT_X(R1)
	BNE	Lb95d_assign_new_orders
90$:	RETURN				; on the target: the orders are kept

; Lb95d: new orders of the robot R5: with the nuclear bomb (the piece bit 6) destroy the factories or the warbases of the
; player at random, else capture at random the neutral factories, the factories or the warbases of the player; then
; the target (Lb989): none: DESTROY ENEMY ROBOTS
Lb95d_assign_new_orders:
	BITB	#100, ROBOT_STRUCT_PIECES(R5)
	BEQ	Lb976_no_nuclear
	CALL	Ld358_random
	MOV	R0, R2
	ASH	#-7, R2
	BIS	R0, R2				; the bit 0: the bit 7 | the bit 0 (rlca, or)
	BIC	#^C1, R2
	ADD	#ORDERS_DESTROY_ENEMY_FACTORIES, R2
	BR	Lb989_orders_assigned
Lb976_no_nuclear:
	CALL	Ld358_random
	CLR	R2
	BIT	#1, R0
	BNE	10$
	INC	R2
	BIT	#2, R0
	BNE	10$
	INC	R2
10$:	ADD	#ORDERS_CAPTURE_NEUTRAL_FACTORIES, R2
Lb989_orders_assigned:
	MOVB	R2, ROBOT_STRUCT_ORDERS(R5)
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	MOV	ROBOT_STRUCT_X(R5), R3
	CALL	Lb34d_find_target
	MOVB	R2, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CMP	R2, #377
	BNE	90$
	MOVB	#ORDERS_DESTROY_ENEMY_ROBOTS, ROBOT_STRUCT_ORDERS(R5)	; no target
90$:	RETURN

;------------------------------------------------------------------------------
; Lae38: the resources of the day (once a day, from Lad62): for each player the general resources + 5 * the bases, the
; resources of each type of the factories + 2 * the factories of that type, each at most 99. Then the panel
Lae38_gain_day_resources:
	MOV	#Lfd22_player1_resource_counts, R4
	MOV	#Lfd3a_p1_base_factory_counts, R3
	CALL	Lae4e_gain_day_resources_player
	MOV	#Lfd4a_player2_resource_counts, R4
	MOV	#Lfd42_p2_base_factory_counts, R3
	CALL	Lae4e_gain_day_resources_player
	JMP	Lrb_hud

; R4 = the resources of a player, R3 = the numbers of his bases and factories (7 bytes each)
Lae4e_gain_day_resources_player:
	CLR	R0
	BISB	(R3)+, R0
	MOV	R0, R1
	ASL	R0
	ASL	R0
	ADD	R1, R0				; the bases * 5
	CALL	Lae62_add_limit_100
	MOV	#6, R2
10$:	INC	R4
	CLR	R0
	BISB	(R3)+, R0
	ASL	R0				; the factories * 2
	CALL	Lae62_add_limit_100
	SOB	R2, 10$
	RETURN

; (R4) += R0, at most 99
Lae62_add_limit_100:
	CLR	R1
	BISB	(R4), R1
	ADD	R0, R1
	CMP	R1, #100.
	BLO	10$
	MOV	#99., R1
10$:	MOVB	R1, (R4)
	RETURN

;------------------------------------------------------------------------------
; Lae6b: the end of the game (every cycle, from Lad62): the enemy has no bases: the victory, else the player has no
; bases: the defeat. The game area and the radar stop (CMDMENU: the picture stays), the panel is the usual one, two
; lines of the message under the game area, 2 seconds, then any key and the game starts again (the stack is reset: it
; is called from the loops of the menus too). TODO: the beep (Lccac, 250)
Lae6b_game_over_check:
	TSTB	Lfd42_p2_base_factory_counts
	BEQ	10$
	TSTB	Lfd3a_p1_base_factory_counts
	BNE	90$
	CALL	Lgo_stop_and_panel
	PPUSTS	GOVL
	BR	20$
10$:	CALL	Lgo_stop_and_panel
	PPUSTS	GOVW
20$:	MOV	@#PPUTCK, R2			; 2 seconds
25$:	MOV	@#PPUTCK, R0
	SUB	R2, R0
	CMP	R0, #100.
	BLO	25$
30$:	TST	@#PPUKEY			; the keys are released
	BNE	30$
	CLR	@#PPUKEL
40$:	MOV	@#PPUKEY, R0			; any key
	BIS	@#PPUKEL, R0
	BEQ	40$
	CLR	@#PPUKEL
	MOV	#<STACK+<STKW*2>>, SP
	JMP	La600_start
90$:	RETURN

.IF DF TESTEND
TECNT:	.WORD	0
.ENDC
Lgo_stop_and_panel:
	PPUCMW	#CMDMENU
	JMP	Lrm_close			; the usual panel

;------------------------------------------------------------------------------
; The destruction of the buildings (for the nuclear bomb)

; Lbc1c: marks the building R0 of the array R4 (Lfd70_warbases, Lfd84_factories) as destroyed (the type 200) and
; returns its map offset in R3. Clobbers R0, R1
Lbc1c_mark_building_destroyed:
	MOV	R0, R1
	ASL	R1
	ADD	R0, R1
	ASL	R1				; * BUILDING_STRUCT_SIZE
	ADD	R4, R1
	MOVB	#200, BUILDING_STRUCT_TYPE(R1)
	MOV	BUILDING_STRUCT_X(R1), R3
	CLR	R0
	BISB	BUILDING_STRUCT_Y(R1), R0
	SWAB	R0
	ASL	R0
	ADD	R0, R3
	RETURN

; Lbbd8: destroys the factory R0: the flags and the type above it are removed, debris in its place
Lbbd8_destroy_factory:
	MOV	#Lfd84_factories, R4
	CALL	Lbc1c_mark_building_destroyed
	MOV	R3, -(SP)
	SUB	#2000, R3			; 2 rows up
	ADD	#2, R3
	CALL	Lbc5d_remove_decoration		; a flag of the enemy
	SUB	#2, R3
	CALL	Lbc5d_remove_decoration		; the type of the factory
	SUB	#2, R3
	CALL	Lbc5d_remove_decoration		; a flag of the player
	MOV	(SP)+, R3
	MOV	#Lbfe2_factory, R2
	BR	Lbc27_replace_building_by_debris

; Lbbf9: destroys the warbase R0: the flags and the "H" above it are removed, debris in its place
Lbbf9_destroy_warbase:
	MOV	#Lfd70_warbases, R4
	CALL	Lbc1c_mark_building_destroyed
	MOV	R3, -(SP)
	SUB	#4000, R3			; 4 rows up
	CALL	Lbc5d_remove_decoration		; a flag of the enemy
	SUB	#4, R3
	CALL	Lbc5d_remove_decoration		; a flag of the player
	ADD	#10, R3
	CALL	Lbc5d_remove_decoration		; "H"
	MOV	(SP)+, R3
	MOV	#Lbfb2_warbase, R2

; Lbc27: the building definition R2 (like a complex structure) at the map offset R3 with random debris (6 or 7) in
; place of every element. Clobbers R0, R1, R2, R3, R4
Lbc27_replace_building_by_debris:
	CLR	R0
	BISB	(R2)+, R0
	BEQ	10$
	CALL	Ld358_random
	BIC	#^C1, R0
	ADD	#6, R0
	CALL	Lbd91_add_element_to_map
10$:	MOVB	(R2)+, R1
	MOVB	(R2)+, R4
	MOV	R1, R0
	BIS	R4, R0
	BEQ	90$				; x == y == 0: the end
	ADD	R1, R3
	ASH	#9., R4
	ADD	R4, R3
	BR	Lbc27_replace_building_by_debris
90$:	RETURN

;------------------------------------------------------------------------------
.IF DF TESTBOMBW
TBMK:	MOV	R5, -(SP)
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#9., ROBOT_STRUCT_PIECES(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#377, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	MOVB	#200, ROBOT_STRUCT_CONTROL(R5)
	CALL	Lcc7c_set_robot_position
	MOV	(SP)+, R5
	RETURN
.ENDC
.IF DF TESTAI
TAMK:	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#18., ROBOT_STRUCT_HEIGHT(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	CLRB	ROBOT_STRUCT_CONTROL(R5)
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	CLRB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)
	MOV	#8., R4
	JMP	Lcc7c_set_robot_position
.ENDC
; Lb99f: the nuclear bomb of the robot R5: destroys at most one building (the first found: the warbases first) near
; the robot: the distance in y: |y + 1 (+ 4 for a warbase) - y of the building| and in x: |x - x of the building| both
; < 7 and their sum < 10 for a warbase, < 5 and < 7 for a factory. The robot is destroyed too (by Lb0fa in the next
; cycle). TODO: the robots and the map elements around (the window 9x9), the visual effect, the sound.
BMAX:	.WORD	0			; the maximal distance in each axis
BMSUM:	.WORD	0			; the maximal sum of the distances
BMDY:	.WORD	0
BMIDX:	.WORD	0			; the building
Lb99f_fire_nuclear_bomb:
	MOV	R5, -(SP)
	CLR	BMIDX
	MOV	#7, BMAX
	MOV	#10., BMSUM
	MOV	#Lfd70_warbases, R4
10$:	BITB	#200, BUILDING_STRUCT_TYPE(R4)
	BNE	50$				; already destroyed
	CLR	R0
	BISB	ROBOT_STRUCT_Y(R5), R0
	CMP	BMIDX, #N_WARBASES
	BHIS	15$
	ADD	#4, R0				; a warbase
15$:	INC	R0
	CLR	R1
	BISB	BUILDING_STRUCT_Y(R4), R1
	SUB	R1, R0
	BGE	16$
	NEG	R0
16$:	CMP	R0, BMAX
	BHIS	50$				; too far
	MOV	R0, BMDY
	MOV	BUILDING_STRUCT_X(R4), R0
	SUB	ROBOT_STRUCT_X(R5), R0
	BGE	17$
	NEG	R0
17$:	CMP	R0, BMAX
	BHIS	50$
	ADD	BMDY, R0
	CMP	R0, BMSUM
	BLO	60$				; in range
50$:	ADD	#BUILDING_STRUCT_SIZE, R4
	INC	BMIDX
	CMP	BMIDX, #N_WARBASES
	BNE	55$
	MOV	#5, BMAX			; the factories
	MOV	#7, BMSUM
55$:	CMP	BMIDX, #<N_WARBASES+N_FACTORIES>
	BNE	10$
	BR	70$
60$:	MOV	BMIDX, R0
	CMP	R0, #N_WARBASES
	BHIS	65$
	CALL	Lbbf9_destroy_warbase
	BR	70$
65$:	SUB	#N_WARBASES, R0
	CALL	Lbbd8_destroy_factory
70$:	MOV	(SP), R5
	CALL	Lba02_nuclear_window
	MOV	(SP)+, R5
	CMP	(R5), #NOSLOT
	BEQ	75$				; already destroyed in the window
	MOV	(R5), R3			; the robot is destroyed: its mark is off the map, the slot is free
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)
	MOV	#NOSLOT, (R5)
75$:	CALL	Lcca0_compute_player_map_ptr	; the player is on the map again (the debris may have covered the mark)
	BISB	#MAPB_PLAYER, Ldd00_map(R3)
	MOVB	#1, Lfd52_update_radar_buffer_signal
	CALL	Lbb40_count_robots
	CALL	Lbb09_update_base_factory_counts
	JMP	Lrb_hud

; Lba02: the window 9x9 around the robot R5 (the corners are cut: the rows of 5, 7, 9, ..., 7, 5 cells), the row 0 and
; the rows out of the map are skipped: a robot there is destroyed (the slot is free, the mark is off), a map element
; of the types 17..20 (not the terrain, not the fences, not the parts of the buildings) becomes random debris.
; Clobbers R0..R4, R5
BWROW:	.WORD	0			; the first cell of the row of the window
BWC:	.WORD	0			; the rows left
BWB:	.WORD	0			; the cells left in the row
Lba02_nuclear_window:
	MOV	ROBOT_STRUCT_MAP_PTR(R5), R4
	SUB	#<4*MAP_LENGTH+4>, R4
	MOV	R4, BWROW
	MOV	#9., BWC
10$:	MOV	BWROW, R4
	CMP	R4, #MAP_LENGTH
	BLO	80$				; out of the map: the row 0 is skipped too
	CMP	R4, #MAP_SIZE
	BHIS	80$
	MOV	BWC, R0
	MOV	#9., R1
	CMP	R0, #1
	BEQ	12$
	CMP	R0, #9.
	BEQ	12$
	CMP	R0, #2
	BEQ	14$
	CMP	R0, #8.
	BNE	16$
	BR	14$
12$:	INC	R4				; the first and the last row: 5 cells
	SUB	#2, R1
14$:	INC	R4				; the second and the last but one: 7 cells
	SUB	#2, R1
16$:	MOV	R1, BWB
20$:	MOV	R4, R3
	BITB	#MAPB_OCCUPIED, Ldd00_map(R3)
	BEQ	30$
	CALL	Lcdd8_get_robot_at_ptr
	BNE	30$
	MOV	#NOSLOT, (R5)			; the robot is destroyed
	BICB	#MAPB_OCCUPIED, Ldd00_map(R3)
30$:	MOVB	Ldd00_map(R3), R0
	BIT	#40, R0
	BNE	40$
	BIC	#^C37, R0
	CMP	R0, #17.
	BLO	40$				; the terrain
	CMP	R0, #21.
	BHIS	40$				; the fences, the parts of the buildings
	CALL	Ld358_random
	BIC	#^C1, R0
	ADD	#6, R0
	CALL	Lbd91_add_element_to_map
40$:	INC	R4
	DEC	BWB
	BNE	20$
80$:	ADD	#MAP_LENGTH, BWROW
	DEC	BWC
	BNE	10$
	RETURN

;------------------------------------------------------------------------------
; Ladb7: the capture of the buildings (every cycle, from Lad62). A building (4 warbases, 24 factories) with a robot at
; its position counts the cycles; after BUILDING_CAPTURE_TIME the side of the robot owns it. Then the counts and the
; panel are updated
.IF DF TESTFASTCAP
CAPTIME = 10.
.IFF
CAPTIME = BUILDING_CAPTURE_TIME
.ENDC
CPIDX:	.WORD	0			; the building
CPCNT:	.WORD	0			; the number of the captures in this cycle

Ladb7_capture_buildings:
	CLR	CPIDX
	CLR	CPCNT
	MOV	#Lfd70_warbases, R4
10$:	MOV	BUILDING_STRUCT_X(R4), R3
	CLR	R0
	BISB	BUILDING_STRUCT_Y(R4), R0
	SWAB	R0
	ASL	R0
	ADD	R0, R3				; the map offset of the building
	BITB	#MAPB_OCCUPIED, Ldd00_map(R3)
	BNE	20$
	CLRB	BUILDING_STRUCT_TIMER(R4)	; nothing in front of it
	BR	90$
20$:	INCB	BUILDING_STRUCT_TIMER(R4)
	CMPB	BUILDING_STRUCT_TIMER(R4), #CAPTIME
	BLO	90$
	CLRB	BUILDING_STRUCT_TIMER(R4)	; captured, if it is a robot
	CALL	Lcdd8_get_robot_at_ptr
	BNE	90$				; no robot (the player, the debris)
	CLR	R2
	TSTB	ROBOT_STRUCT_CONTROL(R5)
	BPL	30$
	INC	R2				; the robot of the enemy
30$:	INC	CPCNT
	MOV	R4, -(SP)
	MOV	CPIDX, R0
	CMP	R0, #N_WARBASES
	BHIS	40$
	CALL	Lbb86_assign_warbase_to_player	; a warbase
	BR	50$
40$:	SUB	#N_WARBASES, R0
	CALL	Lbb61_assign_factory_to_player	; a factory
50$:	MOV	(SP)+, R4
90$:	ADD	#BUILDING_STRUCT_SIZE, R4
	INC	CPIDX
	CMP	CPIDX, #<N_WARBASES+N_FACTORIES>
	BNE	10$
	TST	CPCNT
	BEQ	95$
	CALL	Lbb09_update_base_factory_counts
	JMP	Lrb_hud				; the numbers of the panel
95$:	RETURN

; ----- The enemy robots in line (Lb626, Lb66e): from the robot R5 a ray goes in each of the 4 directions (up, down, left,
; right, the bits 8, 4, 2, 1) over the cells of the map up to the first object (bit 6); if it is a living robot of the
; other side the direction is marked. In the direction the robot faces 3 parallel rays (the robot is 2 cells wide) go
; up to 10 cells (12 with the electronics), in the other directions 1 ray up to 8 cells.
TRDIST:	.WORD	0			; the length of the rays of the direction
TRBASE:	.WORD	0			; the map offset of the robot
Lb6b0_direction_offsets:
	.WORD	1, -1, MAP_LENGTH, -MAP_LENGTH	; right, left, down, up

; Lb66e: R3 = the start (the map offset), R0 = the maximal distance, R2 = the direction (one bit), R5 = the robot that
; looks, R1 = the directions found: the bit 0 is set if a living robot of the other side is in line. Preserves R2, R3, R5
Lb66e_check_enemy_in_line:
	MOV	R3, -(SP)
	MOV	R4, -(SP)
	MOV	#Lb6b0_direction_offsets, R4
	MOV	R2, -(SP)
10$:	ASR	(SP)
	BCS	20$
	ADD	#2, R4
	BR	10$
20$:	TST	(SP)+
	MOV	(R4), R4			; the step of the ray
30$:	ADD	R4, R3
	BLT	90$				; out of the map
	CMP	R3, #MAP_SIZE
	BHIS	90$
	BITB	#MAPB_OCCUPIED, Ldd00_map(R3)
	BNE	40$				; an object
	SOB	R0, 30$
90$:	MOV	(SP)+, R4
	MOV	(SP)+, R3
	RETURN
40$:	MOV	R1, -(SP)
	MOV	R5, -(SP)
	CALL	Lcdd8_get_robot_at_ptr
	BNE	80$				; not a robot
	MOVB	ROBOT_STRUCT_CONTROL(R5), R0
	MOV	(SP), R4
	MOVB	ROBOT_STRUCT_CONTROL(R4), R4
	XOR	R4, R0
	BPL	80$				; the same side
	MOVB	ROBOT_STRUCT_STRENGTH(R5), R0
	DEC	R0
	BLT	80$				; already destroyed
	MOV	(SP)+, R5
	MOV	(SP)+, R1
	BIS	#1, R1				; found
	BR	90$
80$:	MOV	(SP)+, R5
	MOV	(SP)+, R1
	BR	90$

; Lb626: the directions with an enemy robot in line for the robot R5 => R1 (up 10, down 4, left 2, right 1).
; Clobbers R0, R2, R3, R4
Lb626_check_enemy_robots:
	MOV	ROBOT_STRUCT_MAP_PTR(R5), TRBASE
	CLR	R1
	MOV	#10, R2				; the first direction: up
10$:	ASL	R1
	MOV	TRBASE, R3
	MOV	#8., TRDIST
	CLR	R0
	BISB	ROBOT_STRUCT_DIRECTION(R5), R0
	CMP	R0, R2
	BNE	50$				; not the direction the robot faces: a simple ray
	MOV	#10., TRDIST
	BITB	#200, ROBOT_STRUCT_PIECES(R5)
	BEQ	20$
	MOV	#12., TRDIST			; the electronics see further
20$:	BIT	#3, R2
	BNE	30$
	DEC	R3				; up/down: the columns x - 1, x, x + 1
	MOV	TRDIST, R0
	CALL	Lb66e_check_enemy_in_line
	INC	R3
	MOV	TRDIST, R0
	CALL	Lb66e_check_enemy_in_line
	INC	R3
	BR	50$
30$:	SUB	#MAP_LENGTH, R3			; left/right: the rows y - 1, y, y + 1
	MOV	TRDIST, R0
	CALL	Lb66e_check_enemy_in_line
	ADD	#MAP_LENGTH, R3
	MOV	TRDIST, R0
	CALL	Lb66e_check_enemy_in_line
	ADD	#MAP_LENGTH, R3
50$:	MOV	TRDIST, R0
	CALL	Lb66e_check_enemy_in_line
	ASR	R2				; the next direction
	BCC	10$
	RETURN

;------------------------------------------------------------------------------
; The tick of the game inside the menus (the game goes on while the menu of a robot is open): the frame, the radar,
; the time, the pause up to the end of the cycle
Lgame_tick:
	CALL	Lb0ca_update_robots_and_ai
	CALL	DRPORT
	CALL	Lb048_update_radar
	JMP	Lad62_increase_time

;------------------------------------------------------------------------------
; The player has landed on a robot of his (La720): the menu in the right panel of the HUD (the texts are in
; NEMSGS.MAC, [ROBOT MENU]). The items: DIRECT CONTROL, GIVE ORDERS, COMBAT MODE, LEAVE ROBOT. COMBAT MODE opens
; its menu ([COMBAT MODE]); so far every other action leaves the robot, and every item of the combat menu goes
; back to the menu of the robot (stubs). The cursor starts on LEAVE ROBOT as in the original.
; The menu on the screen is described by RMTAB (the pairs of blocks of the items: the ink and the mark ">" are
; changed in them), RMLST (the list of the items, CMDSTS), RMCNT (the number of the items), RMCUR (the current one).
RMROB:	.WORD	0			; the robot
RMCUR:	.WORD	0			; the current item
RMCNT:	.WORD	0			; the number of the items
RMTAB:	.WORD	0			; the table of the blocks of the items
RMLST:	.WORD	0			; the list of the strings of the items
RMLAST:	.WORD	0			; the current item of the menu of the robot (kept while the combat menu is open)
RMITAB:	.WORD	RMI0A, RMI0B, RMI1A, RMI1B, RMI2A, RMI2B, RMI3A, RMI3B
RMNIT = 4.
CMITAB:	.WORD	CMI0A, CMI0B, CMI1A, CMI1B, CMI2A, CMI2B, CMI3A, CMI3B, CMI4A, CMI4B, CMI5A, CMI5B
CMNIT = 6.
RMOTAB:	.WORD	RMO0, RMO1, RMO2, RMO3, RMO4, RMO5, RMO6, RMO7, RMO8
; The panel without the day and the time, with the column of the marks on the left of it (CMDBOX)
RMBOX:	.WORD	SCREEN+<2.*TILEH*LINEW>+HUD_COL-1, 13., 23., 0

; R0 = the item, R1 = the ink, R3 = the character before the text: set in the blocks of the item
Lrm_mark:
	MOV	R0, R2
	ASL	R2
	ASL	R2
	ADD	RMTAB, R2
	MOV	(R2), R4
	MOV	R1, MNB_INK(R4)
	MOVB	R3, 6(R4)
	MOV	2(R2), R4
	MOV	R1, MNB_INK(R4)
	RETURN

; The ink and the mark of all the items, the current one is yellow with ">"
Lrm_set_items:
	CLR	R0
10$:	MOV	#5, R1
	MOV	#' , R3
	CMP	R0, RMCUR
	BNE	20$
	MOV	#6, R1
	MOV	#'>, R3
20$:	CALL	Lrm_mark
	INC	R0
	CMP	R0, RMCNT
	BLO	10$
	RETURN

; Draws the menu: the items and what else is in the list
Lrm_draw_menu:
	CALL	Lrm_set_items
	MOV	RMLST, R2
	CLC
	ROR	R2			; the word address for the PPU
10$:	TST	@#PPUCOM
	BNE	10$
	MOV	R2, @#PPUDAT
	PPUCMW	#CMDSTS
	RETURN

; Draws the name of the orders of the robot
Lrm_draw_orders:
	MOV	RMROB, R5
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	ASL	R0
	MOV	RMOTAB(R0), R2
	CLC
	ROR	R2			; the word address for the PPU
10$:	TST	@#PPUCOM
	BNE	10$
	MOV	R2, @#PPUDAT
	PPUCMW	#CMDSTS
	MOV	RMROB, R5		; ADVANCE and RETREAT: the distance in miles
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	DEC	R0
	CMP	R0, #2
	BHIS	20$
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5), R0
	MOV	R0, R1
	ASR	R1
	MOV	#<RMOMB+6>, R4
	MOV	#' , R3
	CALL	Lfmt_dec_2
	CLRB	(R4)
	PPUSTR	RMOMB
20$:	RETURN

; Draws the strength of the robot (0..100 and more) and "%"
Lrm_draw_strength:
	MOV	RMROB, R5
	CLR	R1
	BISB	ROBOT_STRUCT_STRENGTH(R5), R1
	TSTB	ROBOT_STRUCT_STRENGTH(R5)
	BPL	5$
	CLR	R1			; negative: 0
5$:	MOV	#<RMSTRB+6>, R4
	MOV	#3, R2
	MOV	#' , R3
	CALL	Lfmt_dec
	MOVB	#'%, (R4)+
	CLRB	(R4)
	PPUSTS	RMSTL			; the label and the number
	RETURN

; Clears the panel (the HUD without the day and the time)
Lrm_box:
	TST	@#PPUCOM
	BNE	Lrm_box
	MOVHW	RMBOX, @#PPUDAT
	PPUCMW	#CMDBOX
	RETURN

; The panel is cleared, the HUD is drawn again
Lrm_close:
	CLRB	Lfd39_current_in_game_right_hud
	CALL	Lrm_box
	JMP	DRHUD

; The menu loop (Lacd7): up/down move the current item, FIRE chooses it, the game goes on.
; Returns R0 = the item, or -1 if the robot is destroyed
Lrm_menu:
	CALL	Lrm_draw_menu
	CLR	@#PPUKEL		; the presses before the entry do not count
10$:	MOV	RMROB, R5
	CMP	ROBOT_STRUCT_MAP_PTR(R5), #NOSLOT
	BEQ	90$			; the robot is destroyed
	MOV	@#PPUKEL, R1		; the keys pressed since the last poll
	BIC	R1, @#PPUKEL
	BIT	#PKEYFR, R1
	BNE	80$
	BIT	#PKEYUP, R1
	BEQ	20$
	TST	RMCUR
	BEQ	50$
	DEC	RMCUR
	BR	40$
20$:	BIT	#PKEYDN, R1
	BEQ	50$
	MOV	RMCNT, R0
	DEC	R0
	CMP	RMCUR, R0
	BHIS	50$
	INC	RMCUR
40$:	CALL	Lrm_draw_menu
50$:	CALL	Lgame_tick
	BR	10$
80$:	MOV	RMCUR, R0
	RETURN
90$:	MOV	#-1, R0
	RETURN

; The combat mode: the menu of the combat (so far every item goes back to the menu of the robot).
; Returns R0 = -1 if the robot is destroyed
Lcombat_mode:
	MOV	#<CMNIT-1>, RMCUR	; STOP COMBAT
10$:	CALL	Lrm_box
	CALL	Lrm_draw_strength
	MOV	#CMITAB, RMTAB
	MOV	#CMLIST, RMLST
	MOV	#CMNIT, RMCNT
	CALL	Lrm_menu
	BMI	90$			; the robot is destroyed =>
	MOV	R0, R1
	ASL	R1
	CALL	@CMHND(R1)		; the handler of the item (R0 = the item): returns 0 = stay in the menu,
	BEQ	10$			; -1 = leave, the robot is destroyed, 1 = leave
	BMI	90$
	CLR	R0
90$:	RETURN
; The handlers of the items of the combat menu
CMHND:	.WORD	Lcm_fire			; NUCLEAR BOMB
	.WORD	Lcm_fire			; FIRE PHASERS
	.WORD	Lcm_fire			; FIRE MISSILES
	.WORD	Lcm_fire			; FIRE CANNON
	.WORD	Ldirect_control			; MOVE ROBOT: 0 = back to the menu of the combat, -1 = the robot is destroyed
	.WORD	Lcm_stop_combat			; STOP COMBAT

; Lac99: NUCLEAR BOMB / FIRE PHASERS / MISSILES / CANNON (the items 0..3): the robot must have the weapon (the piece bit 6 - the item)
; and the bullet 0 must be free, else nothing (TODO: the beep). The bullet 0 is only for this fire. The game goes on
Lcm_fire:
	MOV	RMROB, R4
	MOV	R0, R2
	NEG	R2
	MOV	#100, R1
	ASH	R2, R1
	BITB	R1, ROBOT_STRUCT_PIECES(R4)
	BEQ	20$
	TST	R0
	BNE	10$
	MOV	R4, R5			; NUCLEAR BOMB (the piece bit 6): the robot is destroyed, the menu is left
	CALL	Lb99f_fire_nuclear_bomb
	MOV	#-1, R0
	RETURN
10$:	CMP	Ld7d3_bullets, #NOSLOT
	BNE	20$
	NEG	R0
	ADD	#4, R0			; the weapon: 3 phasers, 2 missiles, 1 cannon
	MOV	#Ld7d3_bullets, R5
	CALL	Lb6d6_weapon_fire
	CALL	Lgame_tick
20$:	CLR	R0			; stay in the menu
	RETURN

Lcm_stop_combat:
	MOV	#1, R0			; leave the menu
	RETURN

; DIRECT CONTROL (La941): the player drives the robot with the arrows until FIRE (the game goes on). Returns
; R0 = -1 if the robot is destroyed, else 0
Ldirect_control:
	MOV	RMROB, R5
	MOVB	#ROBOT_CONTROL_DIRECT_CONTROL, ROBOT_STRUCT_CONTROL(R5)
	CLRB	ROBOT_STRUCT_DESIRED_DIRECTION(R5)	; the automatic walking stops
10$:	MOV	@#PPUKEY, R0		; wait until no key is pressed (the FIRE that chose the item)
	BIC	#^C37, R0
	BNE	10$
20$:	CALL	Lgame_tick
	CALL	Lrm_draw_strength
	MOV	RMROB, R5
	CMP	(R5), #NOSLOT
	BEQ	90$			; the robot is destroyed
	BIT	#PKEYFR, @#PPUKEY
	BEQ	20$			; FIRE leaves the direct control
	MOVB	#ROBOT_CONTROL_PLAYER_LANDED, ROBOT_STRUCT_CONTROL(R5)
	CLR	R0
	RETURN
90$:	MOV	#-1, R0
	RETURN

; ----- GIVE ORDERS (La971): the menus of the orders; the texts are in NEMSGS.MAC, [ROBOT ORDERS]
RMMIL:	.WORD	0			; the distance in miles
OMITAB:	.WORD	OMI0A, OMI0B, OMI1A, OMI1B, OMI2A, OMI2B, OMI3A, OMI3B, OMI4A, OMI4B
ODITAB:	.WORD	ODI0A, ODI0B, ODI1A, ODI1B, ODI2A, ODI2B
OCITAB:	.WORD	OCI0A, OCI0B, OCI1A, OCI1B, OCI2A, OCI2B

; R2 = a list of strings (the address in the CPU memory): draws it
Lrm_send:
	CLC
	ROR	R2			; the word address for the PPU
10$:	TST	@#PPUCOM
	BNE	10$
	MOV	R2, @#PPUDAT
	PPUCMW	#CMDSTS
	RETURN

; Draws the chosen distance
Lrm_draw_miles:
	MOV	RMMIL, R1
	MOV	#<RMMB+6>, R4
	MOV	#' , R3
	CALL	Lfmt_dec_2
	CLRB	(R4)
	PPUSTR	RMMB
	RETURN

; GIVE ORDERS: returns R0 = -1 if the robot is destroyed
Lgive_orders:
	CALL	Lrm_box
	CALL	Lrm_draw_strength
	MOV	#OMITAB, RMTAB
	MOV	#OMLIST, RMLST
	MOV	#5, RMCNT
	CLR	RMCUR			; STOP AND DEFEND
	CALL	Lrm_menu
	BMI	90$			; the robot is destroyed =>
	MOV	R0, R1
	ASL	R1
	JMP	@OMHND(R1)		; the handler of the item, R0 = the item
90$:	RETURN
; The handlers of the menu items
OMHND:	.WORD	Lgo_stop_and_defend	; STOP AND DEFEND
	.WORD	Lorders_miles		; ADVANCE
	.WORD	Lorders_miles		; RETREAT
	.WORD	Lorders_target		; SEARCH & DESTROY
	.WORD	Lorders_target		; SEARCH & CAPTURE

Lgo_stop_and_defend:
	MOV	RMROB, R5
	CLRB	ROBOT_STRUCT_ORDERS(R5)	; STOP AND DEFEND
	CLR	R0
	RETURN

; ADVANCE / RETREAT (R0 = the item, 1 / 2): the distance in miles, up/down by 5 miles, 0..50, FIRE: done (1 mile = 2 units;
; 0 miles = STOP AND DEFEND). Returns R0 = -1 if the robot is destroyed
Lorders_miles:
	MOV	R0, -(SP)
	MOV	RMROB, R5
	MOVB	R0, ROBOT_STRUCT_ORDERS(R5)
	CLRB	ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; no distance yet (the old argument could be 377: no target)
	CALL	Lrm_box
	CALL	Lrm_draw_strength
	MOV	#ADLIST, R2
	CMP	(SP), #1
	BEQ	10$
	MOV	#RELIST, R2
10$:	CALL	Lrm_send
	CLR	RMMIL
	CALL	Lrm_draw_miles
	CLR	@#PPUKEL		; the presses before the entry do not count
20$:	MOV	RMROB, R5
	CMP	ROBOT_STRUCT_MAP_PTR(R5), #NOSLOT
	BEQ	95$			; the robot is destroyed
	MOV	@#PPUKEL, R1		; the keys pressed since the last poll
	BIC	R1, @#PPUKEL
	BIT	#PKEYFR, R1
	BNE	80$
	BIT	#PKEYUP, R1
	BEQ	30$
	CMP	RMMIL, #45.
	BHI	50$
	ADD	#5, RMMIL
	BR	40$
30$:	BIT	#PKEYDN, R1
	BEQ	50$
	CMP	RMMIL, #5
	BLO	50$
	SUB	#5, RMMIL
40$:	CALL	Lrm_draw_miles
50$:	CALL	Lgame_tick
	BR	20$
80$:	MOV	RMMIL, R0
	ASL	R0
	MOVB	R0, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)
	BNE	90$
	CLRB	ROBOT_STRUCT_ORDERS(R5)
90$:	TST	(SP)+
	CLR	R0
	RETURN
95$:	TST	(SP)+
	MOV	#-1, R0
	RETURN

; The target menus: the table of the blocks of the items, the list of the strings, then the orders of the items
ODMENU:	.WORD	ODITAB, ODLIST
	.BYTE	ORDERS_DESTROY_ENEMY_ROBOTS	; ENEMY ROBOTS
	.BYTE	ORDERS_DESTROY_ENEMY_FACTORIES	; ENEMY FACTORIES
	.BYTE	ORDERS_DESTROY_ENEMY_WARBASES	; ENEMY WARBASES
	.EVEN
OCMENU:	.WORD	OCITAB, OCLIST
	.BYTE	ORDERS_CAPTURE_NEUTRAL_FACTORIES	; NEUTRAL FACTORIES
	.BYTE	ORDERS_CAPTURE_ENEMY_FACTORIES	; ENEMY FACTORIES
	.BYTE	ORDERS_CAPTURE_ENEMY_WARBASES	; ENEMY WARBASES
	.EVEN

; SEARCH & DESTROY (R0 = 3) / SEARCH & CAPTURE (R0 = 4, the items of the menu): the target. Destroying the factories and the warbases needs
; the nuclear weapon, else the order is cancelled. TODO: Lb34d_find_target: the argument of the
; orders, the target is searched by Lb34d. Returns R0 = -1 if the robot is destroyed
Lorders_target:
	MOV	#ODMENU, R2		; the item 3: DESTROY
	CMP	R0, #3
	BEQ	10$
	MOV	#OCMENU, R2		; the item 4: CAPTURE
10$:	MOV	R2, -(SP)
	CALL	Lrm_box
	CALL	Lrm_draw_strength
	MOV	(SP), R2
	MOV	(R2)+, RMTAB
	MOV	(R2)+, RMLST
	MOV	#3, RMCNT
	CLR	RMCUR
	CALL	Lrm_menu
	BMI	95$
	MOV	(SP), R1
	ADD	R0, R1
	MOVB	4(R1), R0		; the orders of the item (the table after the two words of the menu)
	MOV	RMROB, R5
20$:	MOVB	R0, ROBOT_STRUCT_ORDERS(R5)
	CMP	R0, #ORDERS_DESTROY_ENEMY_FACTORIES
	BLO	30$
	CMP	R0, #ORDERS_CAPTURE_NEUTRAL_FACTORIES
	BHIS	30$
	BITB	#100, ROBOT_STRUCT_PIECES(R5)	; the nuclear weapon
	BNE	30$
	CLRB	ROBOT_STRUCT_ORDERS(R5)	; cancelled: STOP AND DEFEND
	BR	40$
30$:	CLRB	Lfd51_robot_player_or_enemy	; the robot of the player
	MOVB	#377, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; no target yet
	MOV	R5, -(SP)
	MOV	ROBOT_STRUCT_X(R5), R3
	CLR	R0
	BISB	ROBOT_STRUCT_ORDERS(R5), R0
	CALL	Lb34d_find_target
	MOV	(SP)+, R5
	MOVB	R2, ROBOT_STRUCT_ORDERS_ARGUMENT(R5)	; the target
	CMP	R2, #377
	BNE	40$
	CLRB	ROBOT_STRUCT_ORDERS(R5)	; no target: STOP AND DEFEND
40$:	TST	(SP)+
	CLR	R0
	RETURN
95$:	TST	(SP)+
	MOV	#-1, R0
	RETURN

La720_land_on_robot:
	MOV	R5, RMROB
	MOVB	#1, Lfd39_current_in_game_right_hud	; the panel shows the menu of the robot
	MOVB	#ROBOT_CONTROL_PLAYER_LANDED, ROBOT_STRUCT_CONTROL(R5)
	MOV	#3, RMLAST		; LEAVE ROBOT
La732_land_on_robot_internal:
	CALL	Lrm_box
	CALL	Lrm_draw_orders
	CALL	Lrm_draw_strength
	MOV	#RMITAB, RMTAB
	MOV	#RMLIST, RMLST
	MOV	#RMNIT, RMCNT
	MOV	RMLAST, RMCUR
	CALL	Lrm_menu
	BMI	90$			; the robot is destroyed =>
	MOV	R0, RMLAST
	MOV	R0, R1
	ASL	R1
	CALL	@RMHND(R1)		; the handler of the item (R0 = the item): returns 0 = back to the menu of the robot,
	BEQ	La732_land_on_robot_internal	; else leave the menu: -1 = the robot is destroyed, 1 = LEAVE ROBOT
90$:	JMP	Lrm_close
; The handlers of the items of the menu of the robot
RMHND:	.WORD	Ldirect_control		; DIRECT CONTROL
	.WORD	Lgive_orders		; GIVE ORDERS
	.WORD	Lcombat_mode		; COMBAT MODE
	.WORD	Lrm_leave_robot		; LEAVE ROBOT

Lrm_leave_robot:
	MOV	RMROB, R5
	CLRB	ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)	; the robot controls itself again
	CLRB	ROBOT_STRUCT_CONTROL(R5)
	MOVB	#5, Lfd30_player_elevate_timer	; the player floats a bit after leaving the robot
	MOV	#1, R0			; leave the menu
	RETURN

;------------------------------------------------------------------------------
; The robot construction screen (the player is on top of the "H" of his warbase)


CSTOT:	.WORD	0			; the sum of the resources

; Lcbe0_draw_resource_counts_in_construction_screen: the numbers of the resources (columns 14..15, white)
; and their sum (columns 13..15). From the working copy of the resources (Lfd29).
Lcbe0_draw_resource_counts:
	MOV	#HUDBUF, R4
	MOV	#2, HDIGS
	MOV	#' , HFILL
	MOV	#CSRES, R5
	MOV	#<SCREEN+<9.*TILEH*LINEW>+14.>, HSCR
	MOV	#7, HCNT
	CLR	CSTOT
10$:	CLR	R0
	BISB	(R5)+, R0
	ADD	R0, CSTOT
	MOV	HSCR, R1
	MOV	#7, R2
	CLR	R3
	CALL	HBNUM
	ADD	#<TILEH*LINEW>, HSCR
	CMP	HCNT, #7
	BNE	20$
	ADD	#<TILEH*LINEW>, HSCR	; a blank row after the general resources
20$:	DEC	HCNT
	BNE	10$
; the sum: three characters, leading spaces
	MOV	#<SCREEN+<18.*TILEH*LINEW>+13.>, (R4)+
	MOV	#7, (R4)+
	CLR	(R4)+
	MOV	CSTOT, R1
	MOV	#3, R2
	MOV	#' , R3
	CALL	Lfmt_dec_z
	CLR	(R4)+			; the end of the list
	PPUSTS	HUDBUF
	RETURN

; The icons of the 8 pieces (Lc85d): a block of 4x3 tiles for each, in columns 18..21, the bipod at the bottom
; (the pieces go up in steps of 24 lines), the south-west graphic (the odd one: the copy shifted by 4 pixels).
; The CPU draws them straight to the screen through the indirect access: the address in RA (176640), the data in
; RD (176642); a word is the byte of the plane 2 (high) and of the plane 1 (low) of the screen byte at the address,
; so both planes = yellow (the plane 0, which only the PPU reaches, stays black). The sprite is drawn bottom-up like
; Ld315: its first row is skipped, at most 24 rows. The screen is black, so the mask is not needed.
CSPCOL = 18.				; the column of the icons
CSPNOT:	.WORD	0			; the bits cleared in the word to draw: 0 = yellow (planes 1 and 2), 377 = green (plane 2 only)
CSPW:	.WORD	0			; the width of the sprite in bytes

; Draws the icons of all the pieces: green = not selected, yellow = selected
Lc85d_draw_pieces:
	CLR	R4			; the piece 0..7
10$:	MOV	#377, CSPNOT
	BITB	CSBIT(R4), Lfd21_constr_selected_pieces
	BEQ	20$
	CLR	CSPNOT
20$:	CALL	Lc85d_draw_piece_icon
	INC	R4
	CMP	R4, #8.
	BLO	10$
	RETURN

; Draws the icon of the piece R4 (0..7) in the color CSPNOT
Lc85d_draw_piece_icon:
	MOV	R4, R0
	ASL	R0
	ASL	R0
	INC	R0			; the direction 1: south-west
	CLR	R1
	BISB	Ld6c8_piece_graphic_indices(R0), R1
	ASL	R1
	INC	R1			; the shifted copy
	ADD	#ISOADD, R1
	ASL	R1
	MOV	ISOPTR(R1), R3		; R3 = the sprite: height, width, then (mask, data) of the rows bottom-up
	CLR	R1
	BISB	(R3)+, R1		; height
	CLR	R2
	BISB	(R3)+, R2		; width
	MOV	R2, CSPW
	ASL	R2
	ADD	R2, R3			; skip the first row
	DEC	R1
	CMP	R1, #24.
	BLOS	20$
	MOV	#24., R1
20$:	MOV	#<SCREEN+<191.*LINEW>+CSPCOL>, R5	; the bottom row of the piece 0
	MOV	R4, R0
	BEQ	30$
25$:	SUB	#<24.*LINEW>, R5	; the next piece goes up by 24 lines
	SOB	R0, 25$
30$:	MOV	R5, @#176640		; RA: the first byte of the row
	MOV	CSPW, R2
40$:	INC	R3			; the mask: skipped
	CLR	R0
	BISB	(R3)+, R0		; the data
	MOV	R0, -(SP)
	SWAB	R0
	BIS	(SP)+, R0		; the byte in both planes
	BIC	CSPNOT, R0
	MOV	R0, @#176642
	INC	@#176640		; the next byte of the row
	SOB	R2, 40$
	SUB	#LINEW, R5		; the row above
	SOB	R1, 30$
	RETURN

; The state of the screen: the selected pieces (Lfd21_constr_selected_pieces, 1 bit per piece: 0 bipod, 1 tracks,
; 2 anti-grav, 3 cannon, 4 missiles, 5 phasers, 6 nuclear, 7 electronics), the working copy of the resources of
; the player (CSRES, the price of the robot is subtracted), the free robot structure (CSROB) for the preview.
CSBIT:	.BYTE	1, 2, 4, 10, 20, 40, 100, 200
; The costs of the pieces and the resource that pays for each: 6 chassis (bipod, tracks, anti-grav), 5 cannon,
; 4 missiles, 3 phasers, 2 nuclear, 1 electronics (index in the resources; 0 = general)
CSCOST:	.BYTE	3, 5, 10., 2, 4, 4, 20., 3
CSTYPE:	.BYTE	6, 6, 6, 5, 4, 3, 2, 1
CSRES:	.BLKB	8.
CSROB:	.WORD	0
CSPD:	.WORD	0			; the bit of the piece being toggled

; Lcac1: R4 = the piece removed from the robot: its cost goes back to the working copy of the resources; what is
; more than the player had goes to the general resources
Lc85d_refund_piece:
	CLR	R1
	BISB	CSCOST(R4), R1
	CLR	R0
	BISB	CSTYPE(R4), R0
	CLR	R2
	BISB	CSRES(R0), R2
	ADD	R1, R2			; the new count
	CLR	R1
	BISB	Lfd22_player1_resource_counts(R0), R1	; what the player had
	CMP	R2, R1
	BLOS	10$
	SUB	R1, R2			; the excess
	CLR	R3
	BISB	CSRES, R3
	ADD	R2, R3
	MOVB	R3, CSRES
	MOV	R1, R2			; capped
10$:	MOVB	R2, CSRES(R0)
	RETURN

; FIRE on a piece: R4 = the piece 0..7. Selects it (a chassis replaces the chassis selected before; at most 3 of the
; 4 weapons; the cost is paid from its resource, the shortage from the general resources) or removes it.
; Then the icons, the numbers and the preview are drawn again.
Lc85d_toggle_piece:
	CLR	R3
	BISB	CSBIT(R4), R3
	MOV	R3, CSPD
	BITB	R3, Lfd21_constr_selected_pieces
	BEQ	10$
	CALL	Lc85d_refund_piece	; it was selected: removed
	BICB	CSPD, Lfd21_constr_selected_pieces
	BR	90$
10$:	CMP	R4, #3
	BHIS	30$			; not a chassis
	BITB	#7, Lfd21_constr_selected_pieces
	BEQ	30$			; no chassis yet
	MOV	R4, -(SP)		; replace the chassis: the selected one is removed
	CLR	R4
20$:	BITB	CSBIT(R4), Lfd21_constr_selected_pieces
	BNE	25$
	INC	R4
	BR	20$
25$:	CALL	Lc85d_refund_piece
	BICB	#7, Lfd21_constr_selected_pieces
	MOV	(SP)+, R4
30$:	MOVB	Lfd21_constr_selected_pieces, R0
	BIS	CSPD, R0
	BIC	#177607, R0		; the weapons: bits 3..6
	CMP	R0, #170
	BEQ	90$			; all the 4 weapons: not allowed
	CLR	R1
	BISB	CSCOST(R4), R1		; the cost
	CLR	R0
	BISB	CSTYPE(R4), R0		; its resource
	CLR	R2
	BISB	CSRES(R0), R2
	SUB	R1, R2
	BHIS	40$			; enough
	NEG	R2			; the shortage
	CLR	R3
	BISB	CSRES, R3
	SUB	R2, R3
	BLO	90$			; the general resources are not enough
	MOVB	R3, CSRES
	CLR	R2
40$:	MOVB	R2, CSRES(R0)
	BISB	CSPD, Lfd21_constr_selected_pieces
90$:	CALL	Lc85d_draw_pieces
	CALL	Lcbe0_draw_resource_counts
	BR	Lcc1f_update_pieces_and_preview

; Lcc7c: sets the position of the robot R5: R3 = x, R4 = y. Marks the map cell as occupied and flips the robot in the
; radar view (0 for a robot of the player, 1 for an enemy robot: the bit 7 of the control)
Lcc7c_set_robot_position:
	MOV	R3, ROBOT_STRUCT_X(R5)
	MOVB	R4, ROBOT_STRUCT_Y(R5)
	MOV	R4, R0
	CALL	Lcca6_compute_map_ptr	; R3 = the map offset
	MOV	R3, ROBOT_STRUCT_MAP_PTR(R5)
	BISB	#MAPB_OCCUPIED, Ldd00_map(R3)
	MOV	ROBOT_STRUCT_X(R5), R0
	CLR	R1
	BISB	ROBOT_STRUCT_Y(R5), R1
	CLR	R2
	TSTB	ROBOT_STRUCT_CONTROL(R5)
	BPL	10$
	INC	R2
10$:	JMP	Ld65a_flip_2x2_radar_area

; Lcb52: START ROBOT. Needs a chassis and a weapon (else nothing happens, C = 0). The price of the robot is taken from
; the resources of the player, the robot is put 4 rows below the player (the entrance of the factory) and has the
; selected pieces. C = 1: the robot is made, the screen is left. TODO: the sound.
Lc85d_start_robot:
	BITB	#7, Lfd21_constr_selected_pieces
	BEQ	90$			; no chassis
	BITB	#170, Lfd21_constr_selected_pieces
	BEQ	90$			; no weapon
	MOV	#CSRES, R0
	MOV	#Lfd22_player1_resource_counts, R1
	MOV	#4, R2
10$:	MOV	(R0)+, (R1)+		; the resources without the price of the robot
	SOB	R2, 10$
	MOV	Lfd0e_player_x, R3
	CLR	R4
	BISB	Lfd0d_player_y, R4
	ADD	#4, R4
	MOV	CSROB, R5
	CLRB	ROBOT_STRUCT_CONTROL(R5)		; ROBOT_CONTROL_AUTO = 0
	MOVB	Lfd21_constr_selected_pieces, ROBOT_STRUCT_PIECES(R5)
	CALL	Lcc7c_set_robot_position
	MOV	CSROB, R5		; the initial state of the new robot
	MOVB	#4, ROBOT_STRUCT_DESIRED_DIRECTION(R5)	; moves down by default
	MOVB	#5, ROBOT_STRUCT_KEEP_WALKING_STEPS(R5)	; walks 5 steps after leaving the base, and stops
	CLRB	ROBOT_STRUCT_ORDERS(R5)		; ORDERS_STOP_AND_DEFEND = 0
	MOVB	#100., ROBOT_STRUCT_STRENGTH(R5)
	MOVB	#1, ROBOT_STRUCT_CYCLES_TO_UPDATE(R5)
	CALL	Lbb40_count_robots	; the HUD shows the number of robots
	SEC
	RETURN
90$:	CLC
	RETURN

; Lbb40: counts the robots of each player (the numbers go to the table of the HUD)
Lbb40_count_robots:
	MOV	#Lda00_player1_robots, R5
	CALL	Lbb50_count_player_robots
	MOVB	R0, Lfd41_player1_robot_count
	CALL	Lbb50_count_player_robots
	MOVB	R0, Lfd49_player2_robot_count
	RETURN

; Lbb50: R5 = the table of the robots of a player (moves to the next table) => R0 = the number of the robots
Lbb50_count_player_robots:
	CLR	R0
	MOV	#MAX_ROBOTS_PER_PLAYER, R1
10$:	CMP	(R5), #NOSLOT
	BEQ	20$
	INC	R0
20$:	ADD	#ROBOT_STRUCT_SIZE, R5
	SOB	R1, 10$
	RETURN

; Lcc1f: the preview of the robot: it is drawn to the buffer (the original isometric coordinates 0a07), the block of
; 4 bytes x 72 lines from the line 82 is copied to the screen, to the column 1 (the original has 0) and the line 120 (rows 15..23), yellow:
; the byte goes to both planes (see the icons)
PVW = 4.
PVH = 72.
Lcc1f_update_pieces_and_preview:
	CALL	Lcffe_clear_5b00_buffer
	MOV	CSROB, R5
	MOVB	Lfd21_constr_selected_pieces, ROBOT_STRUCT_PIECES(R5)
	MOV	#005007, R2		; the iso coordinates d = 0a, e = 07
	CALL	Lcee8_draw_robot_to_buffer
	MOVB	Lcf3f_sprite_elevation, ROBOT_STRUCT_HEIGHT(R5)
	MOV	#<RNDBUF+<82.*VIEW_W>>, R3
	MOV	#<SCREEN+<120.*LINEW>+1.>, R5
	MOV	#PVH, R1
10$:	MOV	R5, @#176640
	MOV	#PVW, R2
20$:	CLR	R0
	BISB	(R3)+, R0
	MOV	R0, -(SP)
	SWAB	R0
	BIS	(SP)+, R0
	MOV	R0, @#176642
	INC	@#176640
	SOB	R2, 20$
	ADD	#<VIEW_W-PVW>, R3
	ADD	#LINEW, R5
	SOB	R1, 10$
	RETURN

; The items of the screen, from the top: the pieces 7..0 (ELECTRONICS .. BIPOD), START ROBOT, EXIT MENU.
; The blocks of their texts (CMDSTR), the ink word MNB_INK is changed to show the current one.
CSBTAB:	.WORD	CSPN7, CSPN6, CSPN5, CSPN4, CSPN3, CSPN2, CSPN1, CSPN0, CSOPT1, CSOPT2
CSCUR:	.WORD	0			; the current item 0..9
CSNITM = 10.

; R0 = item: the ink of its text to R1 (the current one is yellow, the pieces are cyan, the items white)
Lc85d_item_ink:
	MOV	#5, R1
	CMP	R0, #8.
	BLO	10$
	MOV	#7, R1
10$:	CMP	R0, CSCUR
	BNE	20$
	MOV	#6, R1
20$:	RETURN

; R0 = the item, R1 = its ink: sets the ink of its block and the mark before the text (">" for the current one).
; Returns R2 = the block (all the blocks are made by MSTR: the text starts at the byte 6).
Lc85d_set_block:
	MOV	R0, R4
	ASL	R4
	MOV	CSBTAB(R4), R2
	MOV	R1, MNB_INK(R2)
	MOV	#' , R3
	CMP	R1, #6
	BNE	10$
	MOV	#'>, R3
10$:	MOVB	R3, 6(R2)
	RETURN

; Sets the ink words of all the item blocks (before they are drawn)
Lc85d_set_item_inks:
	CLR	R0
10$:	MOV	R0, -(SP)
	CALL	Lc85d_item_ink
	MOV	(SP), R0
	CALL	Lc85d_set_block
	MOV	(SP)+, R0
	INC	R0
	CMP	R0, #CSNITM
	BLO	10$
	RETURN

; Sets the ink of the item R0 and draws its text again (CMDSTR)
Lc85d_redraw_item:
	CALL	Lc85d_item_ink
	CALL	Lc85d_set_block
	CLC
	ROR	R2			; the word address for the PPU
10$:	TST	@#PPUCOM		; wait for the PPU to be free (it may still read PPUDAT)
	BNE	10$
	MOV	R2, @#PPUDAT
	PPUCMW	#CMDSTR
	RETURN

; The cursor loop: up/down move the current item, STOP leaves. Returns R0 = the item where FIRE was pressed
; (0..7 pieces by the screen order, 8 = START ROBOT, 9 = EXIT MENU), or -1 for STOP.
Lc85d_cursor_loop:
	CLR	@#PPUKEL		; the presses before the entry do not count
10$:	MOV	@#PPUKEL, R1		; the keys pressed since the last poll
	BIC	R1, @#PPUKEL
	BIT	#PKEYST, R1
	BNE	90$
	BIT	#PKEYFR, R1
	BNE	80$
	BIT	#PKEYUP, R1
	BEQ	20$
	MOV	CSCUR, R3
	BEQ	10$
	DEC	R3
	BR	30$
20$:	BIT	#PKEYDN, R1
	BEQ	10$
	MOV	CSCUR, R3
	CMP	R3, #<CSNITM-1>
	BHIS	10$
	INC	R3
30$:	MOV	CSCUR, R0		; the old item: its ink changes first
	MOV	R3, CSCUR
	CALL	Lc85d_redraw_item
	MOV	CSCUR, R0
	CALL	Lc85d_redraw_item
	BR	10$
80$:	MOV	CSCUR, R0
	RETURN
90$:	MOV	#-1, R0
	RETURN

; Checks if the player has less than the maximum number of robots, and if so, opens the construction
; screen with R5 pointing to a free robot structure.
Lc849_construction_if_possible:
	MOV	#Lda00_player1_robots, R5
	MOV	#MAX_ROBOTS_PER_PLAYER, R1
10$:	CMP	(R5), #NOSLOT
	BEQ	Lc85d_robot_construction
	ADD	#ROBOT_STRUCT_SIZE, R5
	SOB	R1, 10$
	RETURN

; The robot construction screen. R5 = the free robot structure. A stub for now: it shows the title and
; waits for fire. TODO: the pieces, the resources, the preview, the new robot.
Lc85d_robot_construction:
	MOV	R5, CSROB
	MOVB	#4, ROBOT_STRUCT_DIRECTION(R5)	; the robot faces south-east
	CLRB	ROBOT_STRUCT_ALTITUDE(R5)
	CLRB	Lfd21_constr_selected_pieces	; nothing is selected
	MOV	#Lfd22_player1_resource_counts, R0
	MOV	#CSRES, R1
	MOV	#4, R2
5$:	MOV	(R0)+, (R1)+		; the working copy of the resources
	SOB	R2, 5$
	MOV	#7, CSCUR		; the cursor starts on the first piece (the bipod)
	CALL	Lc85d_set_item_inks
	PPUCMW	#CMDMENU		; the game area and the radar are not drawn
	PPUCMW	#CMDCLS
	PPUSTS	CSTEXT
	CALL	Lcbe0_draw_resource_counts
	CALL	Lc85d_draw_pieces
	CALL	Lcc1f_update_pieces_and_preview
10$:	CALL	Lc85d_cursor_loop
	TST	R0
	BMI	20$			; STOP
	CMP	R0, #9.
	BEQ	20$			; EXIT MENU
	CMP	R0, #8.
	BNE	15$
	CALL	Lc85d_start_robot	; START ROBOT
	BCS	20$			; the robot is made: back to the game
	BR	10$
15$:
	MOV	#7, R4
	SUB	R0, R4			; the piece: the items go from the top, the pieces from ELECTRONICS
	CALL	Lc85d_toggle_piece
	BR	10$
20$:
; the exit (Lcb8e_construction_screen_exit)
	MOVB	#5, Lfd30_player_elevate_timer	; the player levitates a bit after exiting
	CALL	Ld0ca_draw_in_game_screen
	MOV	@#PPUTCK, CYCT0		; the time spent in the screen is not a part of the cycle
	RETURN

.ENDC
;------------------------------------------------------------------------------
; The main menu (the PPU is in the menu mode: the screen is free for the texts)


MNSEL:	.WORD	0			; the selected item: 0 = START GAME, 1 = LOAD SAVED GAME
MNSCL:	.BYTE	'2			; the height scale character of the selected item
	.EVEN

.IF DF LANGRU
.INCLUDE /NEMSGSRU.MAC/			; the texts of the main menu, Russian (tools/conv_lang.py)
.IFF
.INCLUDE /NEMSGS.MAC/			; the texts of the main menu
.ENDC

; The items of a menu: left aligned. The selected one is yellow and double height, the others are white and normal
; height; the mark "> " is a block of its own (the last in the table of the items, in the list after the items): it
; is moved to the two columns left of the selected item. Lmenu_select changes the ink word and the scale character
; of the item blocks (the offsets MNB_INK, MNB_SCALE in the block). The blocks before the items erase the old
; ones (a double height item takes two rows of the screen).
MNB_INK = 2
MNB_SCALE = 7



MNLST:	.WORD	0			; Lmenu_select: the list of the strings of the items
MNTAB1:	.WORD	0			; the table of the item blocks
MNCNT:	.WORD	0			; the number of the items
MNOLD:	.WORD	0			; the item the cursor has left
MNEBS = 26.				; the size in bytes of an erase block (the list of the items starts with one erase block per item)

; Selects an item of a menu: arrows up/down select (MNSEL = the selected item, set by the caller), fire
; (Shift) chooses, STOP leaves. R0 = the word address of the list of the strings of the items (MOVHW, PPU command CMDSTS:
; one erase block of MNEBS bytes for each item, then the blocks of the items and the block of the mark), R1 = the
; table of the addresses of the item blocks in it and after them the block of the mark, R2 = the number of the items.
; The list is drawn once, then only the two items (the one that the cursor leaves and the one it goes to) and the mark are
; drawn again. Returns R0 = the chosen item (0..) or -1 (STOP).
Lmenu_select:
	MOV	R0, MNLST
	MOV	R1, MNTAB1
	MOV	R2, MNCNT
	CLR	@#PPUKEL		; the presses before the entry do not count
	CLR	R0
10$:	MOV	R0, -(SP)
	CALL	Lms_set_item
	MOV	(SP)+, R0
	INC	R0
	CMP	R0, MNCNT
	BLO	10$
20$:	TST	@#PPUCOM		; wait for the PPU to be free (it may still read PPUDAT)
	BNE	20$
	MOV	MNLST, @#PPUDAT
	PPUCMW	#CMDSTS
Lc1a1_wait_for_key_press_loop:
	MOV	@#PPUKEL, R1		; the keys pressed since the last poll
	BIC	R1, @#PPUKEL
	BIT	#PKEYST, R1
	BNE	Lc100_exit
	BIT	#PKEYUP, R1
	BEQ	50$
	TST	MNSEL
	BEQ	Lc1a1_wait_for_key_press_loop
	MOV	MNSEL, MNOLD
	DEC	MNSEL
	BR	Lms_move
50$:	BIT	#PKEYDN, R1
	BEQ	60$
	MOV	MNSEL, R0
	INC	R0
	CMP	R0, MNCNT
	BHIS	Lc1a1_wait_for_key_press_loop
	MOV	MNSEL, MNOLD
	MOV	R0, MNSEL
	BR	Lms_move
60$:	BIT	#PKEYFR, R1
	BEQ	Lc1a1_wait_for_key_press_loop
	MOV	MNSEL, R0
	RETURN
Lc100_exit:
	MOV	#-1, R0
	RETURN

; The same menu goes on (the caller handled the chosen item and the menu stays on the screen): the cursor loop again
; without drawing the list. Returns as Lmenu_select
Lmenu_continue:
	CLR	@#PPUKEL
	BR	Lc1a1_wait_for_key_press_loop

; The cursor moved from MNOLD to MNSEL: the ink and the height of the two items, the mark; then the old place is erased
; and the old item, the new item and the mark are drawn (four CMDSTR)
Lms_move:
	MOV	MNOLD, R0
	CALL	Lms_set_item
	MOV	MNSEL, R0
	CALL	Lms_set_item
	MOV	MNOLD, R0
	MUL	#MNEBS, R0		; R1 = the offset of its erase block
	MOV	MNLST, R5
	ASL	R5			; the byte address of the list
	ADD	R1, R5
	CALL	Lms_send
	MOV	MNOLD, R0
	CALL	Lms_item_blk
	CALL	Lms_send
	MOV	MNSEL, R0
	CALL	Lms_item_blk
	CALL	Lms_send
	MOV	MNCNT, R0		; the mark: after the items in the table
	CALL	Lms_item_blk
	CALL	Lms_send
	BR	Lc1a1_wait_for_key_press_loop

; R0 = the item (MNCNT = the mark) => R5 = its block. Clobbers R1
Lms_item_blk:
	MOV	R0, R1
	ASL	R1
	ADD	MNTAB1, R1
	MOV	(R1), R5
	RETURN

; R5 = a block: the PPU draws it (CMDSTR). Clobbers R0
Lms_send:
10$:	TST	@#PPUCOM		; wait for the PPU to be free (it may still read PPUDAT)
	BNE	10$
	MOV	R5, R0
	CLC
	ROR	R0			; the word address for the PPU
	MOV	R0, @#PPUDAT
	PPUCMW	#CMDSTR
	RETURN

; R0 = the item: its ink and height (the selected one is yellow and double height, the mark is moved to the two columns
; left of it). Clobbers R0, R1, R2, R5
Lms_set_item:
	MOV	R0, -(SP)
	CALL	Lms_item_blk		; R5 = the block of the item
	MOV	MNCNT, R0
	CALL	Lms_item_blk		; R5 = the block of the mark
	MOV	R5, R2
	MOV	(SP), R0
	CALL	Lms_item_blk
	CMP	(SP)+, MNSEL
	BEQ	20$
	MOV	#7, MNB_INK(R5)		; an item: white, normal height
	MOVB	#'1, MNB_SCALE(R5)
	RETURN
20$:	MOV	#6, MNB_INK(R5)
	MOVB	MNSCL, MNB_SCALE(R5)
	MOV	(R5), R1
	SUB	#2, R1
	MOV	R1, (R2)
	MOV	#6, MNB_INK(R2)
	MOVB	MNSCL, MNB_SCALE(R2)
	RETURN

; The main menu: arrows up/down select, fire (Shift) chooses. Returns R0 = 0 to start the game,
; -1 to exit the program (EXIT, or STOP). TODO: PALETTE, LOAD SAVED GAME (needs the disk), the music, the changing color of the title.
Lc100_title_screen:
	CLR	MNSEL
Lc100_title_redraw:
	PPUCMW	#CMDCLS
	PPUSTS	MNTITLE
10$:	MOVHW	MNOPTS, R0
	MOV	#MNTAB, R1
	MOV	#4, R2
	CALL	Lmenu_select
12$:	TST	R0
	BMI	20$			; STOP
	BEQ	30$			; START GAME
	CMP	R0, #1
	BNE	15$
	INC	@#PALNO			; PALETTE: the next palette (the PPU keeps both); the screen is not drawn again
	MOV	@#PALNO, @#PPUDAT
	PPUCMW	#CMDPAL
	CALL	Lmenu_continue
	BR	12$
15$:	CMP	R0, #3
	BNE	17$
	MOV	#-1, R0			; EXIT
	BR	20$
17$:	CALL	Lmenu_continue		; LOAD SAVED GAME: not available yet
	BR	12$
20$:
30$:	RETURN

; Starts the PPU program (the menu mode, the screen is cleared) and tells it where the frame buffer and the
; radar buffers are
Lstart_ppu:
	CALL	RUNPPU
	MOVHW	FRBUF, @#PPUFRB		; the word addresses for the PPU
	MOVHW	Ld800_radar_view1, @#PPURAD	; the radar buffers
	RETURN

; The pause menu (STOP in the game): CONTINUE returns to the game, SAVE GAME does nothing yet, ABORT GAME
; goes to the main menu (no confirmation). STOP works as CONTINUE too.
; Returns R0 = 0 to continue the game (the game screen is drawn again), 1 to abort it.
Lpause_menu:
	PPUCMW	#CMDMENU		; the game area and the radar are not drawn
	PPUCMW	#CMDCLS
	PPUSTS	PMTITLE
	CLR	MNSEL
10$:	MOVHW	PMOPTS, R0
	MOV	#PMTAB, R1
	MOV	#3, R2
	CALL	Lmenu_select
12$:	CMP	R0, #1
	BNE	15$
	CALL	Lmenu_continue		; SAVE GAME: TODO (needs the disk)
	BR	12$
15$:	BHI	30$			; ABORT GAME
	CALL	Ld0ca_draw_in_game_screen
	MOV	@#PPUTCK, CYCT0		; the time spent in the menu is not a part of the cycle
	CLR	R0
	RETURN
30$:	MOV	#1, R0
	RETURN

;------------------------------------------------------------------------------
; Keyboard

; PPUKEY has the same bits as the keyboard state of the original: 0 right, 1 left, 2 down, 3 up, 4 fire
Lfd0c_keyboard_state:	.WORD	0

Ld37c_read_keyboard_input:
	MOV	@#PPUKEY, R0
	BIC	#^C37, R0
	MOV	R0, Lfd0c_keyboard_state
	RETURN

;------------------------------------------------------------------------------
; Numbers to decimal characters (used by the panel, the menus, the construction screen)

; Lfmt_dec with 2 digits
Lfmt_dec_2:
	MOV	#2, R2

; Lfmt_dec: the decimal digits of R1 (0..32767) as the characters at R4: R2 = the number of the digits, the leading zeros
; are replaced with the character R3 (the last digit is always written). R4 is advanced to the end of the digits.
; Clobbers R0, R1, R2; preserves R3, R5
Lfmt_dec:
	ADD	R2, R4
	MOV	R4, -(SP)		; the end of the digits
	CLR	R0
	DIV	#10., R0		; R0 = the quotient, R1 = the remainder
	ADD	#'0, R1
	MOVB	R1, -(R4)		; the last digit
	MOV	R0, R1
	DEC	R2
	BEQ	90$
10$:	TST	R1
	BNE	20$
	MOVB	R3, -(R4)		; a leading zero
	BR	30$
20$:	CLR	R0
	DIV	#10., R0
	ADD	#'0, R1
	MOVB	R1, -(R4)
	MOV	R0, R1
30$:	SOB	R2, 10$
90$:	MOV	(SP)+, R4
	RETURN

; The same and the terminator (the zero byte) and the padding to the even address (a string block of the list for the PPU)
Lfmt_dec_z:
	CALL	Lfmt_dec
	CLRB	(R4)+
	INC	R4
	BIC	#1, R4
	RETURN

;------------------------------------------------------------------------------
; Random numbers: the same generator as in the original: a 32 bit shift register (the 4 bytes of the seed)
; with the new bit from the bits 3 and 6 of the first byte, and an output chosen by the bytes themselves.
; Returns R0 = the next random number (0..255), preserves the other registers.
Ld358_random:
	MOV	R1, -(SP)
	CLR	R0
	BISB	Lfd00_random_seed, R0
	BIC	#^C110, R0			; and 72
	ADD	#70, R0				; add 56
	BIT	#100, R0			; the carry of the 2 rlca of the original is the bit 6
	BEQ	10$
	SEC
	BR	20$
10$:	CLC
20$:	ROLB	Lfd00_random_seed+3
	ROLB	Lfd00_random_seed+2
	ROLB	Lfd00_random_seed+1
	ROLB	Lfd00_random_seed
	CLR	R1
	BISB	Ld370_random_index, R1
	CLR	R0
	BISB	Lfd00_random_seed(R1), R0
	BIC	#^C3, R0
	MOVB	R0, Ld370_random_index		; the next index
	MOV	R0, R1
	CLR	R0
	BISB	Lfd00_random_seed(R1), R0
	MOV	(SP)+, R1
	RETURN

;------------------------------------------------------------------------------
; Time

CYCT0:	.WORD	0			; PPUTCK at the start of the cycle

; Increases the time by 5 minutes and checks if a whole day has passed; shows the time; waits for
; the end of the cycle (the game does not run faster than 5 cycles per second).
Lad62_increase_time:
	CALL	Ld358_random
	CLR	R0
	BISB	Lfd35_minutes, R0
	ADD	#5, R0
	MOVB	R0, Lfd35_minutes
	CMP	R0, #60.
	BNE	Lad85_increase_time_done
	CLRB	Lfd35_minutes
	INCB	Lfd36_hours
	CMPB	Lfd36_hours, #24.
	BNE	Lad85_increase_time_done
	CLRB	Lfd36_hours
	INC	Lfd37_days
.IF DF LANDING
	CALL	Lae38_gain_day_resources
.ENDC
Lad85_increase_time_done:
	CALL	DRTIME			; the day and the time on the panel

.IF DF LANDING
.IF NDF NOGAMEOVER
	CALL	Lae6b_game_over_check
.ENDC
	CALL	Ladb7_capture_buildings
.ENDC
Lae1d_wait_for_the_cycle:
	MOV	@#PPUTCK, R0
	SUB	CYCT0, R0
	CMP	R0, #MIN_INTERRUPTS_PER_GAME_CYCLE
	BLO	Lae1d_wait_for_the_cycle
	MOV	@#PPUTCK, CYCT0
	RETURN

;------------------------------------------------------------------------------
; The player

; Computes the map pointer (offset) of the player
Lcca0_compute_player_map_ptr:
	MOV	Lfd0e_player_x, R3
	CLR	R0
	BISB	Lfd0d_player_y, R0
; Computes the map pointer: R3 = x, R0 = y => R3 = x + y * 512. Clobbers R0.
Lcca6_compute_map_ptr:
	SWAB	R0
	ASL	R0
	ADD	R0, R3
	RETURN

; Removes the player from the map (bit 7), and then draws the player in the radar view
Lb01d_remove_player_from_map:
	CALL	Lcca0_compute_player_map_ptr
	BICB	#MAPB_PLAYER, Ldd00_map(R3)
	JMP	Lb036_flicker_player_in_radar

; Marks that the player is in the map (bit 7), and updates the radar buffers if necessary
Lb024_add_player_to_map:
	CALL	Lcca0_compute_player_map_ptr
	BISB	#MAPB_PLAYER, Ldd00_map(R3)
	JMP	Lb029_update_radar_view

; Controls the player ship using the keyboard
Laf11_player_ship_control:
	CALL	Lb01d_remove_player_from_map
; If the player is pressing up/down, reduce the effect of the elevate timer
	BIT	#014, Lfd0c_keyboard_state
	BEQ	Laf25_ship_control_x
	TSTB	Lfd30_player_elevate_timer
	BEQ	Laf25_ship_control_x
	DECB	Lfd30_player_elevate_timer
Laf25_ship_control_x:
	MOV	Lfd0c_keyboard_state, R0
	BIC	#^C3, R0
	BEQ	Laf77_ship_control_y		; left/right are not pressed
	CMP	R0, #3
	BEQ	Laf77_ship_control_y		; both are pressed
	MOV	Lfd0e_player_x, R3
	BIT	#1, R0
	BNE	Laf42_move_right
	CMP	R3, #MIN_PLAYER_X
	BEQ	Laf77_ship_control_y
	DEC	R3
	BR	Laf4c_move_if_no_collision
Laf42_move_right:
	CMP	R3, #MAX_PLAYER_X
	BEQ	Laf77_ship_control_y
	INC	R3
Laf4c_move_if_no_collision:
	CLR	R0
	BISB	Lfd0d_player_y, R0
	CALL	Lb052_check_player_collision
	BCS	Laf57_collision
	MOV	R3, Lfd0e_player_x
Laf57_collision:
; See if we need to scroll the map
	MOV	Lfd0e_player_x, R0
	SUB	Lfd0a_scroll_x, R0
	BIC	#177400, R0
	MOV	Lfd0a_scroll_x, R1
	CMP	R0, #13.			; player in the left screen edge
	BNE	10$
	DEC	R1
10$:	CMP	R0, #22.			; player in the right screen edge
	BNE	20$
	INC	R1
20$:	MOV	R1, Lfd0a_scroll_x
	MOV	R1, Lfd06_scroll_ptr		; the map pointer of the first column of the view
Laf77_ship_control_y:
	CLR	R2
	BISB	Lfd0d_player_y, R2
	MOV	Lfd0c_keyboard_state, R0
	ASR	R0
	ASR	R0
	BIC	#^C3, R0
	BEQ	Lafa2_ship_control_altitude	; up/down are not pressed
	CMP	R0, #3
	BEQ	Lafa2_ship_control_altitude
	BIT	#1, R0
	BEQ	10$
	INC	R2				; down
10$:	BIT	#2, R0
	BEQ	20$
	DEC	R2				; up
20$:	BIC	#^C17, R2
	BEQ	Lafa2_ship_control_altitude	; do not go beyond the map borders
	MOV	Lfd0e_player_x, R3
	MOV	R2, R4				; (Lb052 does not change R4)
	MOV	R2, R0
	CALL	Lb052_check_player_collision
	BCS	Lafa2_ship_control_altitude	; collision
	MOVB	R4, Lfd0d_player_y
Lafa2_ship_control_altitude:
	TSTB	Lfd30_player_elevate_timer
	BEQ	Lafae_no_auto_elevate
	DECB	Lfd30_player_elevate_timer
	BR	Lafb5_elevate
Lafae_no_auto_elevate:
	BIT	#020, Lfd0c_keyboard_state
	BEQ	Lafc3_gravity
Lafb5_elevate:
	CLR	R0
	BISB	Lfd10_player_altitude, R0
	CMP	R0, #MAX_PLAYER_ALTITUDE
	BHIS	Lafdb_continue
	ADD	#2, R0
	MOVB	R0, Lfd10_player_altitude
	BR	Lafdb_continue
Lafc3_gravity:
	CLR	R4
	BISB	Lfd10_player_altitude, R4
	DEC	R4				; the ship falls with gravity
	BMI	Lafdb_continue
	CLR	R0
	BISB	Lfd0d_player_y, R0
	MOV	Lfd0e_player_x, R3
	CALL	Lb052_check_player_collision
	CMP	R4, R1
	BLO	Lafdb_continue			; collision when going down
	MOVB	R4, Lfd10_player_altitude
Lafdb_continue:
	CALL	Lafe6_radar_scroll
	INCB	Lfd1e_player_visible_in_radar	; the player blinks in the radar
	JMP	Lb024_add_player_to_map

; Checks if we need to scroll the radar view due to the player movement
Lafe6_radar_scroll:
	MOV	Lfd0e_player_x, R0
	ASR	R0
	ASR	R0
	ASR	R0				; x / 8
	CLR	R1
	BISB	Lfd1b_radar_scroll_x_tile, R1
	SUB	R1, R0
	BIC	#177400, R0			; the position in the radar view in tiles, 8 bit
	CMP	R0, #2
	BLO	Lafff_radar_scroll_left
	CMP	R0, #14.
	BHIS	Lb005_radar_scroll_right
	RETURN
Lafff_radar_scroll_left:
	SUB	#8., R1
	BMI	Lafe6_ret			; at the left end of the map
	BR	Lb00b_update_radar_scroll
Lb005_radar_scroll_right:
	ADD	#8., R1
	CMP	R1, #56.
	BEQ	Lafe6_ret			; at the right end of the map
Lb00b_update_radar_scroll:
	MOVB	R1, Lfd1b_radar_scroll_x_tile
	ASL	R1
	ASL	R1
	ASL	R1
	MOV	R1, Lfd1c_radar_scroll_x
	MOVB	#1, Lfd52_update_radar_buffer_signal
Lafe6_ret:
	RETURN

; Checks whether there would be a collision with the player altitude in a 3x3 area centered around
; the coordinates R3 = x, R0 = y. Returns C = collision, R1 = the maximum altitude in the area.
; Preserves R3, R4. Clobbers R0, R2, R5.
Lb052_check_player_collision:
	MOV	R3, -(SP)
	CALL	Lcca6_compute_map_ptr
	MOV	R3, R2
	CLR	R1
	CALL	Lb096_get_altitude_with_objects
	INC	R2				; x += 1
	CALL	Lb096_get_altitude_with_objects
	SUB	#1000, R2			; y -= 1
	CALL	Lb096_get_altitude_with_objects
	DEC	R2				; x -= 1
	CALL	Lb096_get_altitude_with_objects
	DEC	R2				; x -= 1
	CALL	Lb099_get_object_altitude
	ADD	#1000, R2			; y += 1
	CALL	Lb099_get_object_altitude
	ADD	#1000, R2			; y += 1
	CMP	R2, #MAP_SIZE
	BGE	10$				; edge of the map
	CALL	Lb099_get_object_altitude
	INC	R2				; x += 1
	CALL	Lb099_get_object_altitude
	INC	R2				; x += 1
	CALL	Lb099_get_object_altitude
10$:	CLR	R0
	BISB	Lfd10_player_altitude, R0
	CMP	R0, R1
	MOV	(SP)+, R3			; (MOV does not change C)
	RETURN

; Gets the altitude of a position in the map (R2) and updates R1 (the maximum so far)
Lb096_get_altitude_with_objects:
	CALL	Lb08a_get_map_altitude
	BR	Lb099_get_object_altitude
; R1 = max(R1, the altitude of the map element at the offset R2) (without the objects)
Lb08a_get_map_altitude:
	MOVB	Ldd00_map(R2), R0
	BIC	#177740, R0
	MOVB	Ld7bc_map_piece_heights(R0), R0
	BR	Lb0ab_max_of_a_and_c

; Gets the altitude of the robot or the decoration at the position R2, updates R1
Lb099_get_object_altitude:
	MOV	R2, R3
	BITB	#MAPB_OCCUPIED, Ldd00_map(R3)
	BEQ	Lb0ab_ret
	MOV	R1, -(SP)
	CALL	Lcdd8_get_robot_at_ptr
	BNE	10$
	MOV	(SP)+, R1
	CLR	R0
	BISB	ROBOT_STRUCT_HEIGHT(R5), R0
	CLR	R3
	BISB	ROBOT_STRUCT_ALTITUDE(R5), R3
	ADD	R3, R0
	BR	Lb0ab_max_of_a_and_c
10$:	CALL	Lcdf5_find_decoration_with_ptr
	BEQ	20$
	MOV	(SP)+, R1			; neither a robot nor a decoration
	RETURN
20$:	MOV	(SP)+, R1
	CLR	R0
	BISB	DECOR_STRUCT_TYPE(R5), R0
	MOVB	Lb0c1_decoration_altitudes(R0), R0
; R1 = max(R1, R0)
Lb0ab_max_of_a_and_c:
	CMP	R0, R1
	BLO	Lb0ab_ret
	MOV	R0, R1
Lb0ab_ret:
	RETURN

Lb0c1_decoration_altitudes:
	.BYTE	017				; warbase "H"
	.BYTE	026, 025, 025, 026, 026, 026	; pieces on top of factories
	.BYTE	031, 031			; flags

; Altitudes of the map elements (by the type)
Ld7bc_map_piece_heights:
	.BYTE	000, 000, 002, 002, 002, 002, 003, 003, 006, 006, 006, 006, 000, 000, 000, 007
	.BYTE	017, 007, 017, 000, 000, 143, 000
	.EVEN

;------------------------------------------------------------------------------

; Frame buffer: VIEW_W x VIEW_H, 1bpp, VIEW_W bytes per line. The PPU reads it from here.
	.EVEN
; FRBUF (what the PPU shows) is in the memory of the PPU block, see NEPPU.MAC
; The frame is rendered here (NERNDR.MAC) and copied to FRBUF when it is ready
RNDBUF:	.BLKB	VIEW_BYTES
