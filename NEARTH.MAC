	.TITLE	NEARTH
	.ASECT

; Nether Earth (ZX Spectrum, 1986) port for Elektronika MS-0511 UKNC.
; This file: CPU/PPU plumbing, PPU program, palette, console helpers.
; Game logic is in NECORE.MAC (included at the end).

;------------------------------------------------------------------------------

; Set PPU command
.MACRO	PPUCMD	X
	MOV	X, @#PPUCOM
.ENDM
; Set PPU command and wait for acknowledgement
.MACRO	PPUCMW	X
	MOV	X, @#PPUCOM
	TST	@#PPUCOM
	BNE	.-4
.ENDM
; Print string by PPU and wait for completion: BLK = address of the string block (see CMDSTR)
.MACRO	PPUSTR	BLK
	MOV	#BLK, @#PPUDAT
	PPUCMW	#CMDSTR
.ENDM
; Draw the frame by PPU and wait for completion: BLK = address of the frame block (see CMDFRM)
; Print a list of strings by PPU and wait for completion
.MACRO	PPUSTS	LST
	MOV	#LST, @#PPUDAT
	PPUCMW	#CMDSTS
.ENDM
.MACRO	PPUFRM	BLK
	MOV	#BLK, @#PPUDAT
	PPUCMW	#CMDFRM
.ENDM

;------------------------------------------------------------------------------

SCREEN = 100000			; Screen start, indirect address for UKNC
LINEW  = 120			; Screen line step (octal 120 = 80.)
TILEH  = 8.			; Tile height in screen lines (8x8 first, 8x10 maybe later)

; Game area geometry. All sizes derive from these constants, do not use 20/160 in code.
VIEW_W = 20.			; Game area width, bytes (8 pixels each)
VIEW_H = 160.			; Game area height, lines
VIEW_COL = 2			; Game area position on screen, tile column
VIEW_ROW = 1			; Game area position on screen, tile row
VIEW_BYTES = VIEW_W*VIEW_H	; Frame buffer size, bytes
RADAR_ROW = 23.			; Radar position on screen: tile row and column (128x16 pixels)
RADAR_COL = VIEW_COL+5
RADAR_SCR = SCREEN + <RADAR_ROW*TILEH*LINEW> + RADAR_COL
HUD_COL = VIEW_COL+VIEW_W+2	; Right panel (status), tile column; the frame ends at VIEW_COL+VIEW_W
VIEW_SCR = SCREEN + <VIEW_ROW*TILEH*LINEW> + VIEW_COL	; Screen address of the game area

; PPU drawing in cells of 16x8 pixels (one CPU word from every buffer line)
VCELLS = VIEW_W/2		; Cells per row
VROWS  = VIEW_H/TILEH		; Cell rows in the area
VSLICE = VROWS			; Cell rows drawn per PPU main loop pass (VROWS = whole area)

; Game area colors
VINK   = 0			; Game area ink: black (original: bright yellow paper, black ink). Colors are 3-bit GRB indices: 1 blue, 2 red, 3 magenta, 4 green, 5 cyan, 6 yellow, 7 white
VPAPER = 6			; Game area paper: yellow, index into COLTBL

; PPUKEY bits
PKEYRT =: 001	; RIGHT
PKEYLT =: 002	; LEFT
PKEYDN =: 004	; DOWN
PKEYUP =: 010	; UP
PKEYFR =: 020	; FIRE key
PKEYST =: 200	; STOP key

; CPU <-> PPU mailbox words, in the low CPU memory (vectors area)
PPUCOM = 1000 - 2	; PPU/CPU command and acknowledge
PPUADR = 1000 - 4	; allocated PPU address
PPUDAT = 1000 - 6
PPUKEY = 1000 - 10	; keyboard state
PPUFRB = 1000 - 12	; frame buffer address in CPU memory (CPU sets, PPU reads)
PPUPAS = 1000 - 14	; PPU: count of full game area passes (written on exit)
PPUTCK = 1000 - 16	; PPU: count of 50Hz ticks (written on exit)
PPURAD = 1000 - 20	; radar buffers address in CPU memory (CPU sets, PPU reads), 0 = no radar

; PPU commands (PPUCOM); PPU clears PPUCOM when the command is done
CMDSTR =: 2		; Print string: PPUDAT = CPU address of a block (even):
	;   .WORD screen address, ink color, paper color index; then string bytes, zero terminated
CMDSTS =: 4		; Print a list of strings: PPUDAT = CPU address of the list (even): blocks of CMDSTR
			; one after another, the list ends with a zero word
CMDFRM =: 3		; Draw the frame: PPUDAT = CPU address of a block (even):
	;   .WORD screen address of the top left tile, width (tiles), height (tile rows), ink color, paper color index

;------------------------------------------------------------------------------

	.=001000
START::
	CLR	@#177560
	MTPS	#000340			; Disable interrupts
	MOV	SP, OSTACK		; Save initial SP address
	MOV	#STACK+<20*2>, SP	; Own stack, keep clear of the mailbox words
;
	CALL	STPAL			; Set up the game palette
	MOV	#GAMESC, R1		; String for game screen preparing
	CALL	PRINT
	CALL	PAUSE			; wait while screen updates
;
	JMP	GAME			; => game (NECORE.MAC)
;
OSTACK:	.WORD	01000			; Saved initial SP

FNCORE:	CALL	STPALD			; Select default palette
	MOV	OSTACK, SP
	MOV	#EXITSC, R1		; String for screen cleanup before the exit
	CALL	PRINT
	EMT	350			; .EXIT

;------------------------------------------------------------------------------

; Procedure: Print string: R1 = string address, string ends with zero; utilizes R0
PRINT:
10$:	MOVB	(R1)+, R0		; End of line?
	BEQ	RETN			; yes => exit
20$:	TSTB	@#177564		; Channel 0 source ready?
	BPL	20$			; no => wait
	MOV	R0, @#177566		; send symbol into Channel 0
	BR	10$

; Procedure: Pause after screen cleanup, so PPU will finish the work
PAUSE:
	MOV	#177777, R5
1$:	NOP
	SOB	R5, 1$
RETN:	RETURN

; Procedure: Print unsigned decimal number: R0 = value; utilizes R0-R3
PRDEC:	MOV	#DECTBL, R2
10$:	MOV	#'0-1, R3
20$:	INC	R3
	SUB	(R2), R0
	BHIS	20$
	ADD	(R2)+, R0
	MOV	R0, -(SP)
	MOV	R3, R0
30$:	TSTB	@#177564
	BPL	30$
	MOV	R0, @#177566
	MOV	(SP)+, R0
	TST	(R2)
	BNE	10$
	RETURN
DECTBL:	.WORD	10000., 1000., 100., 10., 1., 0

GAMESC:	; String for game screen preparing
	.BYTE	33,246,62		; Screen format 40x24
	.BYTE	33,240,63		; Ink color
	.BYTE	33,241,60		; Place color
	.BYTE	33,242,60		; Back color
	.BYTE	14			; Clear screen
	.BYTE	33,247,60		; Cursor color
	.BYTE	033,131,61,40		; Cursor position
	.BYTE	0
EXITSC:	; String for screen cleanup before the exit
	.BYTE	33,246,061		; Screen format 80x24
	.BYTE	33,240,67		; Ink color
	.BYTE	33,241,61		; Place color 1
	.BYTE	33,242,61		; Back color 1
	.BYTE	33,247,67		; Cursor color
	.BYTE	14			; Clear screen
	.BYTE	0

	.EVEN

;------------------------------------------------------------------------------

; Channel 2 data
PPMSG:	.WORD	PPARR
	.WORD	177777
PPARR:	.BYTE	0			; return value (0 - OK)
PPCMD:	.BYTE	1			; command (1 - allocate)
	.WORD	32			; device type (32 = PPU mem)
PPAPP:	.WORD	0			; argument(s) (PPU addr for mem operations)
PPACP:	.WORD	<PPEND-PPSTA>/2		; CPU addr (length in words for mem allocate)
PPLEN:	.WORD	<PPEND-PPSTA>/2		; length in words

; Send to PPU by Channel 2
PPSEN:	MOV	#PPMSG, R2
	MOV	#5, R3
	BR	20$
10$:	MOVB	(R2)+, @#176676
20$:	TSTB	@#176674
	BPL	20$
	SOB	R3, 10$
	RETURN

; Prepare and run PPU code block
RUNPPU:
	MOV	#177777, PPUCOM
	CLR	PPUDAT
	CLR	PPUKEY
	CLR	PPUPAS
	CLR	PPUTCK
	CLR	PPURAD
;
	CALL	PPSEN			; allocate (!) no testing for success
	MOV	PPAPP, PPUADR		; copy allocated PPU addr for later use
	MOVB	#20, PPCMD		; set command to copy memory CPU -> PPU
	MOV	#PPSTA, PPACP		; adjust start addr (there was mem size for allocate)
	CALL	PPSEN
	MOVB	#30, PPCMD		; set command to run the PPU code
	CALL	PPSEN
;
	TST	PPUCOM
	BNE	.-4
	CLR	R0
	SOB	R0, .			; wait a bit
	RETURN

; Stop PPU procedure and remove the code
STOPPU:	PPUCMW	#177777			; command PPU to exit
; free PPU memory
	MOVB	#2, PPCMD		; set command to free PP memory
	MOV	PPUADR, PPAPP
	CALL	PPSEN
;
	CLR	PPUKEY
	RETURN

;==============================================================================
; PPU code block
; Code is relocated by the system: no absolute addresses of PPU labels,
; use relative addressing or the MOV PC,R0 / ADD #label-.,R0 trick.

PPSTA:
	MTPS	#200
; stop FDD (do we need that?)
	CLR	R0
	CALL	@7132(R0)
; backup and clean low addrs except 272
	MOV	PC, R0
	ADD	#BKP-., R0
	CLR	R1
	MOV	#400, R3
10$:	MOV	(R1), (R0)+
	CMP	R1, #272
	BNE	20$
	TST	(R1)+
	BR	30$
20$:	CLR	(R1)+
30$:	SOB	R3, 10$
	MOV	#2, (R3)		; set RTI at @#0

; setup other
	MOV	@#177054, BKP054
; timers
	BIC	#^B0000001000000000, @#177054 ; enable vsync in CPU
	BIC	#^B0000000100000000, @#177054 ; enable vsync in PPU
	BIC	#^B0001111110000000, @#177716 ; sound init (mixer off)
	MOV	#200, @#306		; PSW for PPU timer interrupt
; keyboard
	MOV	PC, R0
	ADD	#KEYINT-., R0
	MOV	R0, @#300
	BIS	#100, @#177700		; allow keyboard interrupts
; vsync
	MOV	PC, R0
	ADD	#VSYINT-., R0
	MOV	R0, @#100
	MOV	#200, @#102
;
	CLR	VPASS			; PPU variables are not initialized by the loader
	CLR	VTICK
	CLR	VROW
	CLR	VCPUA
	MOV	#VIEW_SCR, VSCRA
	CALL	PCLSCR			; Clear screen
PDONE:
	MTPS	#0
	MOV	#<PPUCOM/2>, @#177010	; ackn of command execution
	CLR	@#177014
; Main loop of the PPU procedure
; Order: game area -> radar -> command from CPU -> sound tick
PMAIN:	CALL	DRVIEW			; game area (stage 1: continuous copy from CPU buffer)
	CALL	DRRADR			; radar
	MOV	#<PPUCOM/2>, @#177010	; get command from CPU
	MOV	@#177014, R0
	BMI	PEXIT			; exit PPU command
	ASL	R0
	ASL	R0
	ADD	R0, PC
	JMP	PMAIN			; 0 - no command
	JMP	PSOUND			; 1 - play sound 1
	JMP	PPRINT			; 2 - print string
	JMP	PFRAME			; 3 - draw the frame
	JMP	PPRSTS			; 4 - print a list of strings
	;TODO commands: fill attributes, blit, nuke effect, clear screen, music
; Exit command
PEXIT:	MTPS	#200
; report measurements to CPU
	MOV	#<PPUPAS/2>, @#177010
	MOV	VPASS, @#177014
	MOV	#<PPUTCK/2>, @#177010
	MOV	VTICK, @#177014
; restore block 0..1000
	MOV	PC, R0
	ADD	#BKP-., R0
	CLR	R1
	MOV	#400, R3
	MOV	(R0)+, (R1)+
	SOB	R3, .-2
	MOV	BKP054, @#177054
;
	CALL	PCLSCR			; Clear screen
;
	CALL	@#104054		; Clear keyboard buffer
; signal to CPU: we're finished
	MOV	#PPUCOM/2, @#177010
	CLR	@#177014
	MTPS	#0
	RETURN

; Keyboard interrupt handler
KEYINT:	MOV	@#177010, -(SP)
	MOV	R0, -(SP)
	MOV	#<PPUKEY/2>, @#177010	; prepare addr of keys in CPU
	MOVB	@#177702, R0		; scancode (read it just once)
	BMI	50$
; key pressed
	CMP	R0, #116		; C_KEY_LEFT
	BNE	11$
	BIS	#PKEYLT, @#177014
	BR	90$
11$:	CMP	R0, #133		; C_KEY_RIGHT
	BNE	12$
	BIS	#PKEYRT, @#177014
	BR	90$
12$:	CMP	R0, #154		; C_KEY_UP
	BNE	13$
	BIS	#PKEYUP, @#177014
	BR	90$
13$:	CMP	R0, #134		; C_KEY_DOWN
	BNE	14$
	BIS	#PKEYDN, @#177014
	BR	90$
14$:	CMP	R0, #105		; C_KEY_SHIFT
	BNE	15$
	BIS	#PKEYFR, @#177014
	BR	90$
15$:	CMP	R0, #4			; C_KEY_STOP
	BNE	90$
	BIS	#PKEYST, @#177014
	BR	90$
; key released
50$:	BIC	#^B1111111111110000, R0
	CMP	R0, #^B1110		; left
	BNE	51$
	BIC	#PKEYLT, @#177014
	BR	90$
51$:	CMP	R0, #^B1011		; right
	BNE	52$
	BIC	#PKEYRT, @#177014
	BR	90$
52$:	CMP	R0, #^B1100		; up down
	BNE	53$
	BIC	#<PKEYUP+PKEYDN>, @#177014
	BR	90$
53$:	CMP	R0, #^B0101		; shift
	BNE	90$
	BIC	#PKEYFR, @#177014
; exit interrupt
90$:	MOV	(SP)+, R0
	MOV	(SP)+, @#177010
	RTI

; Draw (a slice of) the game area: copy frame buffer from CPU memory to screen.
; Stage 1: no frame comparison, no dirty flags; every pass redraws VSLICE cell rows,
; continuing from where the previous pass stopped.
; Cell = 16x8 pixels: one CPU word per buffer line, low byte = left tile, high byte = right tile.
DRVIEW:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
; set colors once per pass
	MOV	#VINK, @#177016		; INK color
	MOV	PC, R0
	ADD	#COLTBL-., R0
	ADD	#VPAPER*4, R0		; COLTBL entry = 2 words = 4 bytes
	MOV	(R0)+, @#177020		; set PAPER color
	MOV	(R0)+, @#177022
	MOV	#VSLICE, -(SP)		; cell rows left in this pass
10$:
; row start: CPU address (words) and screen address
	MOV	#<PPUFRB/2>, (R4)
	MOV	(R5), R0
	ADD	VCPUA, R0
	MOV	VSCRA, -(SP)		; 2(SP) = running screen address
	MOV	R0, -(SP)		; 0(SP) = running CPU word address
	MOV	#VCELLS, R1
20$:
; read 8 lines of the cell into the temp buffer
	MOV	(SP), (R4)
	MOV	PC, R2
	ADD	#TMPBUF-., R2
	.REPT	TILEH
	MOV	(R5), (R2)+
	ADD	#VIEW_W/2, (R4)
	.ENDR
; write the cell: left tile at A, right tile at A+1
	MOV	2(SP), (R4)
	MOV	PC, R2
	ADD	#TMPBUF-., R2
	.REPT	TILEH
	MOV	(R2)+, R0
	MOV	R0, (R3)		; left tile
	INC	(R4)
	SWAB	R0
	MOV	R0, (R3)		; right tile
	ADD	#LINEW-1, (R4)		; next line, same column
	.ENDR
	INC	(SP)			; next cell: +1 word in the buffer
	ADD	#2, 2(SP)		; +2 tiles on screen
	DEC	R1			; (SOB range is too short here)
	BNE	20$
	CMP	(SP)+, (SP)+		; drop running addresses
; next row
	ADD	#<TILEH*VIEW_W/2>, VCPUA
	ADD	#<TILEH*LINEW>, VSCRA
	INC	VROW
	CMP	VROW, #VROWS
	BLO	30$
; wrapped: whole area done
	CLR	VROW
	CLR	VCPUA
	MOV	#VIEW_SCR, VSCRA
	INC	VPASS
30$:	DEC	(SP)
	BEQ	40$
	JMP	10$			; (BNE range is too short here)
40$:	TST	(SP)+
	RETURN

; Command: print string with the font, 8x8 characters, no clipping.
; Parameter block in CPU memory, address in PPUDAT: screen address, ink, paper index, string, 0.
; Control code 4 in the string, followed by '1'..'9', sets the height scale of the following characters
; (the character is 8 lines tall times the scale; the next string line is the caller's concern).
PPRINT:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; block address in CPU memory
	ASR	R0			; word address
	CALL	PSTRB
	JMP	PDONE

; Command: print a list of strings. PPUDAT = address of the list in CPU memory: blocks as above,
; one after another (each block is word aligned), the list ends with a zero word.
PPRSTS:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; list address in CPU memory
	ASR	R0			; word address
10$:	MOV	R0, (R4)
	TST	(R5)			; screen address = 0: the end
	BEQ	90$
	CALL	PSTRB
	BR	10$
90$:	JMP	PDONE

; Print one string block: R0 = block word address in CPU memory. Returns R0 = word address of
; the next block. R3 = 177024, R4 = 177010, R5 = 177014.
PSTRB:
	MOV	R0, (R4)
	MOV	(R5), R1		; R1 = screen address
	INC	(R4)
	MOV	(R5), @#177016		; set INK color
	INC	(R4)
	MOV	(R5), R2		; paper color index
	ADD	#3, R0			; string start, word address
	MOV	R0, PSTRA
	ASL	R2
	ASL	R2
	ADD	PC, R2
	ADD	#COLTBL-., R2
	MOV	(R2)+, @#177020		; set PAPER color
	MOV	(R2), @#177022
	CLR	PHALF
	MOV	#1, PSCALE
10$:	CALL	PGETC
	BEQ	90$
	CMP	R2, #4
	BEQ	20$
	CALL	DRCHAR
	BR	10$
20$:	CALL	PGETC			; control code 4 + '1'..'9': the height scale of the characters
	BEQ	90$
	SUB	#'0, R2
	MOV	R2, PSCALE
	BR	10$
90$:	MOV	PSTRA, R0		; the next block follows the word with the terminator
	RETURN

; Next character of the string to R2 (Z flag set = the end of the string). R4 = 177010, R5 = 177014.
PGETC:	TST	PHALF
	BNE	20$
	MOV	PSTRA, (R4)		; next two characters
	INC	PSTRA
	MOV	(R5), PWORD
	INC	PHALF
	CLR	R2
	BISB	PWORD, R2
	RETURN
20$:	CLR	PHALF
	CLR	R2
	BISB	PWORD+1, R2
	RETURN

; Draw a character: R2 = character code, R1 = screen address (advanced by 1 column)
; R3 = 177024, R4 = 177010
DRCHAR:	SUB	#FONTFC, R2
	BLT	10$
	CMP	R2, #FONTCN
	BLO	20$
10$:	CLR	R2			; out of range => space
20$:	ASL	R2
	ASL	R2
	ASL	R2			; * 8.
	ADD	PC, R2
	ADD	#FONT-., R2
	MOV	R1, (R4)
	MOV	#TILEH, PLINES
30$:	CLR	R0
	BISB	(R2)+, R0
	MOV	PSCALE, PCNT		; every line of the character is repeated PSCALE times
40$:	MOV	R0, (R3)
	ADD	#LINEW, (R4)
	DEC	PCNT
	BNE	40$
	DEC	PLINES
	BNE	30$
	INC	R1
	RETURN

; Command: draw the frame around the game area: 1 pixel black line, 6 pixels of paper, 1 pixel black
; line (as the white frame of the original). Parameter block in CPU memory, address in PPUDAT:
; screen address of the top left tile, width (tiles), height (tile rows), ink, paper index.
; The interior of the frame is not drawn.
PFRAME:
	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPUDAT/2>, (R4)
	MOV	(R5), R0		; block address in CPU memory
	ASR	R0			; word address
	MOV	R0, (R4)
	MOV	(R5), R1		; R1 = screen address
	INC	(R4)
	MOV	(R5), FRW
	INC	(R4)
	MOV	(R5), FRH
	INC	(R4)
	MOV	(R5), @#177016		; set INK color
	INC	(R4)
	MOV	(R5), R2		; paper color index
	ASL	R2
	ASL	R2
	ADD	PC, R2
	ADD	#COLTBL-., R2
	MOV	(R2)+, @#177020		; set PAPER color
	MOV	(R2), @#177022
	CLR	FRROW
10$:	MOV	#-1, FRFULL		; the top and bottom rows are drawn completely
	MOV	PC, R0
	ADD	#FRTOP-., R0
	TST	FRROW
	BEQ	40$
	MOV	PC, R0
	ADD	#FRBOT-., R0
	MOV	FRROW, R2
	INC	R2
	CMP	R2, FRH
	BEQ	40$
	CLR	FRFULL			; the rows between: only the left and right tiles
	MOV	PC, R0
	ADD	#FRMID-., R0
40$:	CALL	PFROW
	INC	FRROW
	CMP	FRROW, FRH
	BLO	10$
	JMP	PDONE

; Draw one tile row of the frame: R0 = table of 8 lines (left tile, middle tile, right tile),
; R1 = screen address of the row (advanced to the next tile row). FRFULL = 0: no middle tiles.
PFROW:	MOV	#8., -(SP)		; lines left
10$:	MOV	R1, (R4)
	CLR	R2
	BISB	(R0)+, R2
	MOV	R2, (R3)		; left tile
	TST	FRFULL
	BEQ	30$
	CLR	R2
	BISB	(R0), R2		; middle tile
	MOV	FRW, FRCNT
	SUB	#2, FRCNT
20$:	INC	(R4)
	MOV	R2, (R3)
	DEC	FRCNT
	BNE	20$
	INC	(R4)
	BR	40$
30$:	MOV	R1, (R4)
	ADD	FRW, (R4)
	DEC	(R4)
40$:	CLR	R2
	BISB	1(R0), R2		; right tile
	MOV	R2, (R3)
	ADD	#2, R0			; next line of the table
	ADD	#LINEW, R1
	DEC	(SP)
	BNE	10$
	TST	(SP)+
	RETURN

; Frame tiles, 8 lines each: left, middle, right (bit 0 = leftmost pixel). The side bars are 5 pixels of paper:
; black at bits 0,1 (the outer line and 1 pixel of padding, invisible on the black background) and the inner line
FRTOP:	.BYTE	377,377,377
	.REPT	6
	.BYTE	003,000,300
	.ENDR
	.BYTE	203,377,301
FRMID:	.REPT	8.
	.BYTE	203,000,301
	.ENDR
FRBOT:	.BYTE	203,377,301
	.REPT	6
	.BYTE	003,000,300
	.ENDR
	.BYTE	377,377,377
	.EVEN

; Draw radar (TODO: read Ld800_radar_view1 / Ld900_radar_view2 from CPU memory)
; Draws the radar: 128x16 pixels from the two radar buffers in CPU memory (NERADR.MAC; address in
; PPURAD, view 2 follows view 1, 16 bytes per row, bit 0 = the leftmost cell). Colors of a pixel
; (view 1, view 2): (0,0) blue, (1,0) cyan (the robots of the player), (0,1) yellow (the enemy
; robots), (1,1) white (the buildings). The ink is white, so the pixels of both views are drawn by
; the ink and the paper is calculated for each pixel (4 bits of the color per pixel).
DRRADR:	MOV	#177010, R4		; mem index
	MOV	#177014, R5		; mem data
	MOV	#177024, R3		; pix data
	MOV	#<PPURAD/2>, (R4)
	MOV	(R5), RDBUF
	BEQ	90$			; no radar buffers
	MOV	#7, @#177016		; white ink
	MOV	PC, R0
	ADD	#RDE4-., R0
	MOV	R0, RDE4P
	MOV	#RADAR_SCR, RDSCR
	CLR	RDY
10$:	MOV	RDY, R0			; the row: 8 words of the view 1
	ASL	R0
	ASL	R0
	ASL	R0
	ADD	RDBUF, R0
	MOV	R0, RDA1
	MOV	RDSCR, RDTS		; the screen address of the first tile of the line
	MOV	#8., RDW
20$:	MOV	RDA1, (R4)
	MOV	(R5), RDV1W		; two bytes of the view 1
	MOV	RDA1, (R4)
	ADD	#128., (R4)
	MOV	(R5), RDV2W		; two bytes of the view 2
	INC	RDA1
	CLR	RDV1
	BISB	RDV1W, RDV1
	CLR	RDV2
	BISB	RDV2W, RDV2
	CALL	RDTILE
	CLR	RDV1
	BISB	RDV1W+1, RDV1
	CLR	RDV2
	BISB	RDV2W+1, RDV2
	CALL	RDTILE
	DEC	RDW
	BNE	20$
	ADD	#LINEW, RDSCR		; the next line
	INC	RDY
	CMP	RDY, #16.
	BLO	10$
90$:	RETURN

; Draws one tile of the radar at the screen address RDTS (advanced): RDV1, RDV2 = the bytes of the views.
RDTILE:	MOV	RDV1, R0		; the paper of the pixels 0..3
	BIC	#177760, R0
	MOV	RDV2, R1
	BIC	#177760, R1
	CALL	RDWORD
	MOV	R0, @#177020
	MOV	RDV1, R0		; the paper of the pixels 4..7
	ASR	R0
	ASR	R0
	ASR	R0
	ASR	R0
	BIC	#177760, R0
	MOV	RDV2, R1
	ASR	R1
	ASR	R1
	ASR	R1
	ASR	R1
	BIC	#177760, R1
	CALL	RDWORD
	MOV	R0, @#177022
	MOV	RDV2, R1		; the ink mask: pixels of both views
	COM	R1
	MOV	RDV1, R0
	BIC	R1, R0
	MOV	RDTS, (R4)
	MOV	R0, (R3)
	INC	RDTS
	RETURN

; Paper of 4 pixels (16 bits, 4 bits per pixel): R0 = pixels of the view 1, R1 = pixels of the view 2
; (4 bits each) => R0. Color bits: B = not view 2 or view 1; R = view 2; G = view 1 or view 2.
; Clobbers R1, R2.
RDWORD:	ASL	R0
	ADD	RDE4P, R0
	MOV	(R0), R0		; a: bit 0 of the nibble of each pixel of the view 1
	ASL	R1
	ADD	RDE4P, R1
	MOV	(R1), R1		; b: the same for the view 2
	MOV	R0, R2
	BIS	R1, R2
	ASL	R2
	ASL	R2			; (a | b) << 2: the green bit
	MOV	R1, -(SP)
	ASL	(SP)
	BIS	(SP)+, R2		; | b << 1: the red bit
	COM	R1
	BIS	R1, R0
	BIC	#^C10421, R0		; (~b | a) & 1111h: the blue bit
	BIS	R2, R0
	RETURN

; 4 bits of a pixel mask => bit 0 of the nibble of each pixel
RDE4:	.WORD	^B0000000000000000, ^B0000000000000001, ^B0000000000010000, ^B0000000000010001
	.WORD	^B0000000100000000, ^B0000000100000001, ^B0000000100010000, ^B0000000100010001
	.WORD	^B0001000000000000, ^B0001000000000001, ^B0001000000010000, ^B0001000000010001
	.WORD	^B0001000100000000, ^B0001000100000001, ^B0001000100010000, ^B0001000100010001

; Clear screen in PPU
PCLSCR:
	MOV	#177010, R4
	MOV	#177012, R3
	MOV	#177014, R5
	MOV	#100000, (R4)
	MOV	#100000, R0
10$:	CLR	(R5)
	CLR	(R3)
	INC	(R4)
	SOB	R0, 10$
	RETURN

; 50Hz tick
VSYINT:	INC	VTICK
	RTI

; Start to play sound; R0 = sound number multiplied by 4. TODO: sound design undecided
PSOUND:	JMP	PDONE			; return to PPU main loop

; Color conversion table, 2 words per color (see Saboteur)
COLTBL:	.WORD	^B0000000000000000, ^B0000000000000000
	.WORD	^B0001000100010001, ^B0001000100010001
	.WORD	^B0010001000100010, ^B0010001000100010
	.WORD	^B0011001100110011, ^B0011001100110011
	.WORD	^B0100010001000100, ^B0100010001000100
	.WORD	^B0101010101010101, ^B0101010101010101
	.WORD	^B0110011001100110, ^B0110011001100110
	.WORD	^B0111011101110111, ^B0111011101110111

.INCLUDE /NEFONT.MAC/			; The font lives in the PPU block (PPU RAM)

RDBUF:	.WORD	0			; DRRADR: radar buffers, CPU word address
RDE4P:	.WORD	0			; DRRADR: address of RDE4
RDSCR:	.WORD	0			; DRRADR: screen address of the current line
RDTS:	.WORD	0			; DRRADR: screen address of the current tile
RDY:	.WORD	0			; DRRADR: current row
RDW:	.WORD	0			; DRRADR: words left in the row
RDA1:	.WORD	0			; DRRADR: CPU word address in the view 1
RDV1W:	.WORD	0			; DRRADR: two bytes of the view 1
RDV2W:	.WORD	0			; DRRADR: two bytes of the view 2
RDV1:	.WORD	0			; DRRADR: the byte of the view 1
RDV2:	.WORD	0			; DRRADR: the byte of the view 2
FRW:	.WORD	0			; PFRAME: width, tiles
FRH:	.WORD	0			; PFRAME: height, tile rows
FRROW:	.WORD	0			; PFRAME: current tile row
FRFULL:	.WORD	0			; PFRAME: the row is drawn completely
FRCNT:	.WORD	0			; PFRAME: middle tiles counter
VPASS:	.WORD	0			; Count of full game area passes
VTICK:	.WORD	0			; Count of 50Hz ticks
VROW:	.WORD	0			; Current cell row of the game area
VCPUA:	.WORD	0			; Frame buffer offset of the current row, words
VSCRA:	.WORD	VIEW_SCR		; Screen address of the current row
PSTRA:	.WORD	0			; PPRINT: current string word address in CPU memory
PWORD:	.WORD	0			; PPRINT: current string word
PHALF:	.WORD	0			; PPRINT: the second character of PWORD is next
PSCALE:	.WORD	1			; PPRINT: height scale of the characters
PCNT:	.WORD	0			; DRCHAR: repetition counter
PLINES:	.WORD	0			; DRCHAR: lines of the character left
TMPBUF:	.BLKW	TILEH			; Temp buffer for one cell
BKP054:	.WORD	0			; Saved 177054
BKP:	.BLKW	400			; 0-1000 addrs backup

PPEND:
; End of PPU code block
;==============================================================================

PALNO:	.WORD	0		; Current palette number
; Palette to set up in the PPU memory
;		 |____....____....|
PALETD:	.WORD	^B1011101010011000	; Default UKNC palette
	.WORD	^B1111111011011100	;
PALETT:	.WORD	^B1011101010011000	; Game palette 0 - for GRB
	.WORD	^B1111111011011100	;   black / blue / red / green
	.WORD	^B1010100111010000	; Game palette 1 - for RGB
	.WORD	^B1010101011011100	;   black / blue / green / red
	.WORD	^B1011111110011001	; Game palette 2
	.WORD	^B1111111111011100	;   black on blue
	.WORD	^B0100000001101111	; Game palette 3
	.WORD	^B0000001100100001	;   black on white

; Parameters block used to exchange with PPU using Channel 2
PPBLCK:	.BYTE	0		; This byte will have error code or zero
PPBCMD:	.BYTE	20		; Command (01-get memory, 02-free memory 10-read, 20-write, 30-start)
	.WORD	32		; Device - PPU
PPBAPP:	.WORD	002470		; Address in PPU RAM - two words for the new palette
PPBACP:	.WORD	PALETT		; Address in PPU RAM - address for the palette
	.WORD	2		; Block length in bytes
PPBADR:	.WORD	PPBLCK		; Start address of the parameters block
	.WORD	401		; Stop element (used in the exchange)

; Restore the default palette
STPALD:
	MOV	#PALETD, R0
	BR	STPAL1
; Set up the palette
STPAL:	MOV	@#PALNO, R0
	BIC	#177774, R0		; 0..3
	ASL	R0
	ASL	R0			; x4
	ADD	#PALETT, R0
STPAL1:	MOV	R0, @#PPBACP
; Procedure used to send parameters block for PPU using Channel 2
PPSEND:	MOV	#PPBADR, R0
	MOV	#5, R1
	MTPS	#200
	BR	1$
2$:	MOVB	(R0)+, @#176676
1$:	TSTB	@#176674
	BPL	1$
	SOB	R1, 2$
	MTPS	#0
	RETURN

;------------------------------------------------------------------------------

STARTC::
.INCLUDE /NECORE.MAC/
.INCLUDE /NESPRT.MAC/
.INCLUDE /NERNDR.MAC/
.INCLUDE /NERADR.MAC/
.INCLUDE /NEHUD.MAC/
.IF DF TESTREF
.INCLUDE /NEREF.MAC/
.ENDC
.INCLUDE /NEGAME.MAC/

STACK::	.BLKW	20

;------------------------------------------------------------------------------
	.END	START
