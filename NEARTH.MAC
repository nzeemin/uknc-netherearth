	.TITLE	NEARTH
	.ASECT

.IF DF TESTFONT
LANGRU = 1				; the font test shows the Cyrillic font
.ENDC

; Nether Earth (ZX Spectrum, 1986) port for Elektronika MS-0511 UKNC.
; This file: CPU/PPU plumbing, PPU program, palette, console helpers.
; Game logic is in NECORE.MAC (included at the end).

;------------------------------------------------------------------------------

; Set PPU command
.MACRO	PPUCMD	X
	MOV	X, @#PPUCOM
.ENDM
; Set PPU command and wait for acknowledgement. First waits until the PPU has finished the previous command
; (DRTIME posts a command without waiting): otherwise the PPU would overwrite the new command with its
; acknowledgement of the old one.
.MACRO	PPUCMW	X
	TST	@#PPUCOM
	BNE	.-4
	MOV	X, @#PPUCOM
	TST	@#PPUCOM
	BNE	.-4
.ENDM
;  The PPU addresses the CPU memory by words. MOVHW puts the word address of a label of the CPU memory
; (the address / 2, a logical shift: MACRO11 divides signed, an address at 100000 and above would keep the
; sign) to the destination, so no shift is needed at run time, neither by the CPU nor by the PPU.
.MACRO	MOVHW	ADDR, DST
	MOV	#<<<ADDR&77777>/2>+<<<ADDR&100000>/100000>*40000>>, DST
.ENDM
; Print string by PPU and wait for completion: BLK = address of the string block (see CMDSTR)
.MACRO	PPUSTR	BLK
	TST	@#PPUCOM		; the PPU may still read PPUDAT of the previous command
	BNE	.-4
	MOVHW	BLK, @#PPUDAT
	PPUCMW	#CMDSTR
.ENDM
; Draw the frame by PPU and wait for completion: BLK = address of the frame block (see CMDFRM)
; Print a list of strings by PPU and wait for completion
.MACRO	PPUSTS	LST
	TST	@#PPUCOM		; the PPU may still read PPUDAT of the previous command
	BNE	.-4
	MOVHW	LST, @#PPUDAT
	PPUCMW	#CMDSTS
.ENDM
.MACRO	PPUFRM	BLK
	TST	@#PPUCOM		; the PPU may still read PPUDAT of the previous command
	BNE	.-4
	MOVHW	BLK, @#PPUDAT
	PPUCMW	#CMDFRM
.ENDM

;------------------------------------------------------------------------------

SCREEN = 100000			; Screen start, indirect address for UKNC
LINEW  = 120			; Screen line step (octal 120 = 80.)
TILEH  = 8.			; Tile height in screen lines (8x8 first, 8x10 maybe later)

; Game area geometry. All sizes derive from these constants, do not use 20/160 in code.
VIEW_W = 20.			; Game area width, bytes (8 pixels each)
VIEW_H = 160.			; Game area height, lines
VIEW_COL = 2			; Game area position on screen, tile column
VIEW_ROW = 1			; Game area position on screen, tile row
VIEW_BYTES = VIEW_W*VIEW_H	; Frame buffer size, bytes
RADAR_ROW = 23.			; Radar position on screen: tile row and column (128x16 pixels)
RADAR_COL = VIEW_COL+5
RADAR_SCR = SCREEN + <RADAR_ROW*TILEH*LINEW> + RADAR_COL
RADAR_EVERY = 4			; The PPU redraws the radar once in so many passes of its main loop (drawing it takes
				; as long as the whole game area, ~95 ms)
HUD_COL = VIEW_COL+VIEW_W+2	; Right panel (status), tile column; the frame ends at VIEW_COL+VIEW_W
VIEW_SCR = SCREEN + <VIEW_ROW*TILEH*LINEW> + VIEW_COL	; Screen address of the game area

; PPU drawing in cells of 16x8 pixels (one CPU word from every buffer line)
VCELLS = VIEW_W/2		; Cells per row
VROWS  = VIEW_H/TILEH		; Cell rows in the area
VSLICE = VROWS			; Cell rows drawn per PPU main loop pass (VROWS = whole area)

; Game area colors
VINK   = 0			; Game area ink: black (original: bright yellow paper, black ink). Colors are 3-bit GRB indices: 1 blue, 2 red, 3 magenta, 4 green, 5 cyan, 6 yellow, 7 white
VPAPER = 6			; Game area paper: yellow, index into COLTBL

; PPUKEY bits
PKEYRT =: 001	; RIGHT
PKEYLT =: 002	; LEFT
PKEYDN =: 004	; DOWN
PKEYUP =: 010	; UP
PKEYFR =: 020	; FIRE key
PKEYST =: 200	; STOP key

; CPU <-> PPU mailbox words, in the low CPU memory (vectors area)
PPUCOM = 1000 - 2	; PPU/CPU command and acknowledge
PPUADR = 1000 - 4	; allocated PPU address
PPUDAT = 1000 - 6
PPUKEY = 1000 - 10	; keyboard state
PPUFRB = 1000 - 12	; frame buffer address in CPU memory (CPU sets, PPU reads)
PPUPAS = 1000 - 14	; PPU: count of full game area passes (written on exit)
PPUTCK = 1000 - 16	; PPU: count of 50Hz ticks (written on exit)
PPUKEL = 1000 - 22	; keys pressed since the CPU cleared the bits: the latch of the presses of PPUKEY (the menus poll the keys
			; once per cycle and would miss a short tap)
PPURAD = 1000 - 20	; radar buffers address in CPU memory (CPU sets, PPU reads), 0 = no radar

; PPU commands (PPUCOM); PPU clears PPUCOM when the command is done
CMDSTR =: 2		; Print string: PPUDAT = CPU word address of a block (MOVHW):
	;   .WORD screen address, ink color, paper color index; then string bytes, zero terminated
CMDSTS =: 4		; Print a list of strings: PPUDAT = CPU word address of the list (MOVHW): blocks of CMDSTR
			; one after another, the list ends with a zero word
CMDGAME =: 5		; Switch the PPU to the game mode: the game area and the radar are drawn
CMDMENU =: 6		; Switch the PPU to the menu mode: the game area and the radar are not drawn
CMDCLS =: 7		; Clear the screen
CMDBOX =: 11		; Clear a rectangle: PPUDAT = CPU word address of a block (MOVHW):
	; .WORD screen address of the top left tile, width (tiles), height (tile rows), paper color index
CMDPAL =: 10		; Set the palette of the screen: PPUDAT = the palette number (0, 1; the PPU keeps both palettes)
CMDFRM =: 3		; Draw the frame: PPUDAT = CPU word address of a block (MOVHW):
	;   .WORD screen address of the top left tile, width (tiles), height (tile rows), ink color, paper color index

;------------------------------------------------------------------------------

	.=001000
START::
	CLR	@#177560
	MTPS	#000340			; Disable interrupts
	MOV	SP, OSTACK		; Save initial SP address
	MOV	#STACK+<20*2>, SP	; Own stack, keep clear of the mailbox words
;
	MOV	#GAMESC, R1		; String for game screen preparing
	CALL	PRINT
	CALL	PAUSE			; wait while screen updates
;
	JMP	GAME			; => game (NECORE.MAC)
;
OSTACK:	.WORD	01000			; Saved initial SP

FNCORE:	MOV	OSTACK, SP
	MOV	#EXITSC, R1		; String for screen cleanup before the exit
	CALL	PRINT
	EMT	350			; .EXIT

;------------------------------------------------------------------------------

; Procedure: Print string: R1 = string address, string ends with zero; utilizes R0
PRINT:
10$:	MOVB	(R1)+, R0		; End of line?
	BEQ	RETN			; yes => exit
20$:	TSTB	@#177564		; Channel 0 source ready?
	BPL	20$			; no => wait
	MOV	R0, @#177566		; send symbol into Channel 0
	BR	10$

; Procedure: Pause after screen cleanup, so PPU will finish the work
PAUSE:
	MOV	#177777, R5
1$:	NOP
	SOB	R5, 1$
RETN:	RETURN

; Procedure: Print unsigned decimal number: R0 = value; utilizes R0-R3
PRDEC:	MOV	#DECTBL, R2
10$:	MOV	#'0-1, R3
20$:	INC	R3
	SUB	(R2), R0
	BHIS	20$
	ADD	(R2)+, R0
	MOV	R0, -(SP)
	MOV	R3, R0
30$:	TSTB	@#177564
	BPL	30$
	MOV	R0, @#177566
	MOV	(SP)+, R0
	TST	(R2)
	BNE	10$
	RETURN
DECTBL:	.WORD	10000., 1000., 100., 10., 1., 0

GAMESC:	; String for game screen preparing
	.BYTE	33,246,62		; Screen format 40x24
	.BYTE	33,240,63		; Ink color
	.BYTE	33,241,60		; Place color
	.BYTE	33,242,60		; Back color
	.BYTE	14			; Clear screen
	.BYTE	33,247,60		; Cursor color
	.BYTE	033,131,66,40		; Cursor position
	.BYTE	0
EXITSC:	; String for screen cleanup before the exit
	.BYTE	33,246,061		; Screen format 80x24
	.BYTE	33,240,67		; Ink color
	.BYTE	33,241,61		; Place color 1
	.BYTE	33,242,61		; Back color 1
	.BYTE	33,247,67		; Cursor color
	.BYTE	14			; Clear screen
	.BYTE	0

	.EVEN

;------------------------------------------------------------------------------

; Channel 2 data
PPMSG:	.WORD	PPARR
	.WORD	177777
PPARR:	.BYTE	0			; return value (0 - OK)
PPCMD:	.BYTE	1			; command (1 - allocate)
	.WORD	32			; device type (32 = PPU mem)
PPAPP:	.WORD	0			; argument(s) (PPU addr for mem operations)
PPACP:	.WORD	<PPEND-PPSTA>/2		; CPU addr (length in words for mem allocate)
PPLEN:	.WORD	<BKP-PPSTA>/2		; length in words to copy: without the backup buffer BKP (it is not initialized)

; Send to PPU by Channel 2
PPSEN:	MOV	#PPMSG, R2
	MOV	#5, R3
	BR	20$
10$:	MOVB	(R2)+, @#176676
20$:	TSTB	@#176674
	BPL	20$
	SOB	R3, 10$
	RETURN

; Prepare and run PPU code block
RUNPPU:
	MOV	#177777, PPUCOM
	CLR	PPUDAT
	CLR	PPUKEY
	CLR	PPUKEL
	CLR	PPUPAS
	CLR	PPUTCK
	CLR	PPURAD
;
	CALL	PPSEN			; allocate (!) no testing for success
	MOV	PPAPP, PPUADR		; copy allocated PPU addr for later use
	MOVB	#20, PPCMD		; set command to copy memory CPU -> PPU
	MOV	#PPSTA, PPACP		; adjust start addr (there was mem size for allocate)
	CALL	PPSEN
	MOVB	#30, PPCMD		; set command to run the PPU code
	CALL	PPSEN
;
	TST	PPUCOM
	BNE	.-4
	CLR	R0
	SOB	R0, .			; wait a bit
	RETURN

; Stop PPU procedure and remove the code
STOPPU:	PPUCMW	#177777			; command PPU to exit
; free PPU memory
	MOVB	#2, PPCMD		; set command to free PP memory
	MOV	PPUADR, PPAPP
	CALL	PPSEN
;
	CLR	PPUKEY
	RETURN

.INCLUDE /NEPPU.MAC/			; The PPU program (PPSTA..PPEND)
; The frame buffer is in the memory of the PPU block: the CPU copy of the block is not needed after RUNPPU
; copied it to the PPU memory (once). It follows the labels PPSTA and BKP (the backup buffer BKP..PPEND is only in the PPU memory): the size of the padding must be
; the same in both passes of the assembler.
FRBUF = PPSTA
.IF GT <FRBUF+VIEW_BYTES>-BKP
	.BLKB	<FRBUF+VIEW_BYTES>-BKP	; the rest of the frame buffer, if it is longer than the block (the image ends at BKP)
.ENDC

PALNO:	.WORD	0		; Current palette number (CMDPAL); the palettes are in the PPU code (PALTAB)
;------------------------------------------------------------------------------

STARTC::
.INCLUDE /NECORE.MAC/
.INCLUDE /NESPRT.MAC/
.INCLUDE /NEMAP.MAC/
.INCLUDE /NERNDR.MAC/
.INCLUDE /NERADR.MAC/
.INCLUDE /NEHUD.MAC/
.IF DF TESTREF
.INCLUDE /NEREF.MAC/
.ENDC
.INCLUDE /NEGAME.MAC/

STACK::	.BLKW	20

;------------------------------------------------------------------------------
	.END	START
